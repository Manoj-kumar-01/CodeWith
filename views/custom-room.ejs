<%- include('partials/head') %>

    <style>
        .slot-card {
            background: rgba(255, 255, 255, 0.03);
            border: 1px solid rgba(255, 255, 255, 0.08);
            transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
            position: relative;
            overflow: hidden;
            height: 76px;
            display: flex;
            align-items: center;
            backdrop-filter: blur(8px);
        }

        .slot-card.occupied {
            background: rgba(255, 255, 255, 0.07);
            border-color: rgba(255, 255, 255, 0.2);
            box-shadow: 0 8px 32px 0 rgba(0, 0, 0, 0.37);
            border: 1px solid rgba(255, 255, 255, 0.18);
        }

        .slot-card.occupied::before {
            content: '';
            position: absolute;
            inset: 0;
            background: linear-gradient(135deg, rgba(255, 255, 255, 0.1), transparent);
        }

        .slot-card:not(.occupied):hover {
            border-color: rgba(255, 255, 255, 0.4);
            background: rgba(255, 255, 255, 0.12);
            transform: translateY(-4px) scale(1.02);
        }

        /* Glass Effects for containers */
        .glass-panel {
            background: rgba(15, 23, 42, 0.6);
            backdrop-filter: blur(12px);
            border: 1px solid rgba(255, 255, 255, 0.1);
            box-shadow: 0 8px 32px 0 rgba(0, 0, 0, 0.82);
        }

        /* FS Overlay */
        #fs-overlay {
            position: fixed;
            inset: 0;
            z-index: 9999;
            background: #020617;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            transition: opacity 0.5s ease;
        }

        #fs-overlay.fade-out {
            opacity: 0;
            pointer-events: none;
        }

        .team-badge {
            background: linear-gradient(90deg, #3b82f6, #1d4ed8);
            clip-path: polygon(10% 0, 100% 0, 90% 100%, 0 100%);
        }

        .team-badge-red {
            background: linear-gradient(90deg, #ef4444, #b91c1c);
            clip-path: polygon(10% 0, 100% 0, 90% 100%, 0 100%);
        }

        .start-btn-glow {
            box-shadow: 0 0 20px rgba(59, 130, 246, 0.4);
            animation: pulse-glow 2s infinite;
        }

        @keyframes pulse-glow {

            0%,
            100% {
                box-shadow: 0 0 20px rgba(59, 130, 246, 0.4);
            }

            50% {
                box-shadow: 0 0 40px rgba(59, 130, 246, 0.6);
            }
        }

        /* Chat Styling */
        .chat-container {
            position: absolute;
            bottom: 100px;
            left: 24px;
            width: 320px;
            max-height: 240px;
            background: linear-gradient(to top, rgba(0, 0, 0, 0.6), transparent);
            border-radius: 12px;
            display: flex;
            flex-direction: column;
            z-index: 45;
            pointer-events: none;
        }

        .chat-messages {
            flex: 1;
            overflow-y: auto;
            padding: 12px;
            display: flex;
            flex-direction: column;
            gap: 6px;
            pointer-events: auto;
        }

        /* Minimalist Colored Scrollbar */
        .chat-messages::-webkit-scrollbar {
            width: 4px;
        }

        .chat-messages::-webkit-scrollbar-track {
            background: rgba(255, 255, 255, 0.02);
        }

        .chat-messages::-webkit-scrollbar-thumb {
            background: rgba(59, 130, 246, 0.3);
            border-radius: 20px;
        }

        .chat-messages::-webkit-scrollbar-thumb:hover {
            background: rgba(59, 130, 246, 0.5);
        }

        .chat-msg {
            font-size: 11px;
            line-height: 1.4;
            animation: slide-up 0.3s ease-out;
        }

        .chat-msg .name {
            font-weight: 800;
            color: #60a5fa;
            text-transform: uppercase;
            margin-right: 4px;
        }

        .chat-msg.system .content {
            color: #facc15;
            font-style: italic;
        }

        .chat-msg .content {
            color: #e2e8f0;
            text-shadow: 0 1px 2px rgba(0, 0, 0, 0.5);
        }

        .chat-input-wrapper {
            padding: 8px 12px;
            background: rgba(0, 0, 0, 0.4);
            border-radius: 0 0 12px 12px;
            display: flex;
            align-items: center;
            gap: 8px;
            pointer-events: auto;
            border-top: 1px solid rgba(255, 255, 255, 0.05);
        }

        .chat-input {
            background: transparent;
            border: none;
            color: white;
            font-size: 11px;
            flex: 1;
            outline: none;
        }

        @keyframes slide-up {
            from {
                opacity: 0;
                transform: translateY(10px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        /* User Context Menu */
        #user-context-menu {
            position: fixed;
            z-index: 1000;
            min-width: 160px;
            background: #0f172a;
            border: 1px solid rgba(255, 255, 255, 0.1);
            border-radius: 12px;
            box-shadow: 0 10px 25px rgba(0, 0, 0, 0.5);
            overflow: hidden;
            animation: menu-pop 0.2s cubic-bezier(0.175, 0.885, 0.32, 1.275);
        }

        .menu-item {
            padding: 10px 16px;
            display: flex;
            align-items: center;
            gap: 12px;
            font-size: 13px;
            font-weight: 600;
            color: #94a3b8;
            cursor: pointer;
            transition: all 0.2s;
        }

        .menu-item:hover {
            background: rgba(255, 255, 255, 0.05);
            color: white;
        }

        .menu-item.danger {
            color: #ef4444;
        }

        .menu-item.danger:hover {
            background: #ef444415;
        }

        @keyframes menu-pop {
            from {
                opacity: 0;
                transform: scale(0.95) translateY(5px);
            }

            to {
                opacity: 1;
                transform: scale(1) translateY(0);
            }
        }

        /* Confirmation Modal */
        #confirm-modal {
            position: fixed;
            inset: 0;
            z-index: 10000;
            background: rgba(2, 6, 23, 0.8);
            backdrop-filter: blur(8px);
            display: none;
            align-items: center;
            justify-content: center;
        }

        .confirm-card {
            background: rgba(15, 23, 42, 0.9);
            border: 1px solid rgba(255, 255, 255, 0.1);
            padding: 32px;
            border-radius: 24px;
            width: 100%;
            max-width: 400px;
            box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5);
            animation: modal-in 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
        }

        @keyframes modal-in {
            from {
                transform: scale(0.9) translateY(20px);
                opacity: 0;
            }

            to {
                transform: scale(1) translateY(0);
                opacity: 1;
            }
        }

        /* Sidebar hiding in full-screen */
        #lobby-container.full-screen-mode aside {
            display: none !important;
        }

        .exit-btn-header {
            background: rgba(239, 68, 68, 0.1);
            border: 1px solid rgba(239, 68, 68, 0.2);
            color: #ef4444;
        }

        .exit-btn-header:hover {
            background: #ef4444;
            color: white;
            border-color: #ef4444;
        }
    </style>

    <body class="bg-[#020617]">
        <div id="fs-overlay" onclick="enterLobby()">
            <div class="text-center">
                <div class="relative w-24 h-24 mb-6 mx-auto">
                    <div class="absolute inset-0 bg-blue-500/20 blur-xl animate-pulse rounded-full"></div>
                    <div
                        class="relative w-full h-full border-2 border-blue-500/30 rounded-full flex items-center justify-center">
                        <i data-lucide="shield-check" class="w-10 h-10 text-blue-400 animate-bounce"></i>
                    </div>
                </div>
                <h1 class="text-2xl font-black text-white italic tracking-widest uppercase mb-2">Syncing Lobby...</h1>
                <p class="text-[10px] font-bold text-slate-500 uppercase tracking-[0.3em]">Click to engage battle unit
                </p>
            </div>
        </div>

        <div class="fixed inset-0 w-screen h-screen overflow-hidden">
            <div class="absolute inset-0 z-0 bg-[#020617]">
                <div class="absolute inset-0 opacity-20"
                    style="background-image: radial-gradient(#3b82f6 1px, transparent 1px); background-size: 40px 40px;">
                </div>
            </div>

            <div class="relative z-10 w-screen h-screen">
                <div class="monitor-frame">
                    <div class="monitor-bezel">
                        <div class="monitor-screen">
