<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>CodeWith? - Verify Your Account</title>
  <link rel="stylesheet" href="/css/styles.css" />
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            background: 'hsl(var(--background))',
            foreground: 'hsl(var(--foreground))',
            card: { DEFAULT: 'hsl(var(--card))', foreground: 'hsl(var(--card-foreground))' },
            primary: { DEFAULT: 'hsl(var(--primary))', foreground: 'hsl(var(--primary-foreground))' },
            border: 'hsl(var(--border))',
          },
          fontFamily: { sans: ['Inter', 'sans-serif'], mono: ['JetBrains Mono', 'monospace'] },
        },
      },
    };
  </script>
  <script src="https://unpkg.com/lucide@latest/dist/umd/lucide.js"></script>
  <style>
    @keyframes slow-drift-1 {
      0% { transform: translate(0px, 0px) scale(1); }
      100% { transform: translate(40px, -30px) scale(1.1); }
    }
    .animate-drift-1 {
      animation: slow-drift-1 15s infinite alternate ease-in-out;
    }
  </style>
</head>
<body class="bg-minimal-clean min-h-screen flex items-center justify-center antialiased select-none overflow-x-hidden text-slate-700 relative p-6">

  <!-- Ambient Blurred blobs -->
  <div class="absolute top-[10%] left-[10%] w-[320px] h-[320px] bg-slate-200/30 rounded-full blur-[80px] pointer-events-none animate-drift-1"></div>

  <!-- Main Glass Card Wrapper -->
  <div class="relative z-10 w-full max-w-md bg-white/85 backdrop-blur-xl rounded-3xl border border-slate-200/80 p-8 md:p-10 shadow-2xl shadow-slate-200/60 space-y-8 text-center">
    
    <!-- Branding Header -->
    <div class="flex flex-col items-center space-y-4">
      <a href="/" class="hover:opacity-90 transition-opacity">
        <%- include('partials/logo') %>
      </a>
      <div class="w-16 h-16 bg-indigo-50 text-indigo-600 rounded-2xl flex items-center justify-center shadow-lg shadow-indigo-100/50 mt-4">
        <i data-lucide="mail" class="w-8 h-8"></i>
      </div>
      <div class="space-y-2">
        <h1 class="text-xl font-black text-slate-800 uppercase tracking-tight">Verify Your Account</h1>
        <p class="text-xs text-slate-400 font-semibold leading-relaxed">Let's verify your identity before stepping into the multiplayer sandboxes.</p>
      </div>
    </div>

    <!-- Info Box -->
    <div class="bg-slate-50/80 border border-slate-100 rounded-2xl p-5 space-y-3">
      <div class="text-xs text-slate-500 font-medium">We sent a secure activation link to:</div>
      <div class="text-sm font-black text-slate-800 font-mono tracking-tight break-all bg-white py-2 px-3 border border-slate-100 rounded-xl"><%= user.email %></div>
      <div class="text-[11px] text-slate-400 font-semibold leading-relaxed">Click the link in the welcome email to verify and activate your profile automatically. Check spam if you don't receive it in 2 minutes.</div>
    </div>

    <!-- Notifications -->
    <% if (typeof error !== 'undefined' && error) { %>
      <div class="bg-rose-50 border border-rose-200 text-rose-700 px-4 py-3 rounded-xl text-xs font-semibold flex items-center gap-2.5">
        <span class="text-rose-500"><i data-lucide="alert-circle" class="w-4 h-4"></i></span>
        <span><%= error %></span>
      </div>
    <% } %>

    <% if (typeof success !== 'undefined' && success) { %>
      <div class="bg-emerald-50 border border-emerald-200 text-emerald-700 px-4 py-3 rounded-xl text-xs font-semibold flex items-center gap-2.5">
        <span class="text-emerald-500"><i data-lucide="check-circle" class="w-4 h-4"></i></span>
        <span><%= success %></span>
      </div>
    <% } %>

    <!-- Actions Form -->
    <div class="space-y-3">
      <form action="/resend-verification" method="POST">
        <button type="submit" class="w-full py-3.5 rounded-xl text-xs font-black tracking-wide uppercase text-white bg-slate-800 hover:bg-slate-700 transition-all border border-slate-800 shadow-lg shadow-slate-800/10 flex items-center justify-center gap-2">
          <span>Resend Email</span>
          <i data-lucide="send" class="w-4 h-4"></i>
        </button>
      </form>
    </div>

    <!-- Navigation footer -->
    <div class="pt-6 border-t border-slate-100 flex flex-col items-center gap-3 text-xs font-semibold text-slate-400">
      <a href="/logout" class="inline-flex items-center gap-1 text-[11px] font-black uppercase tracking-wider text-rose-500 hover:text-rose-600 transition-colors">
        <i data-lucide="log-out" class="w-3.5 h-3.5"></i> Log Out
      </a>
    </div>

  </div>

  <script>
    document.addEventListener('DOMContentLoaded', () => {
      if(typeof lucide !== 'undefined') lucide.createIcons();
    });
  </script>
</body>
</html>
