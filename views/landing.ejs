        <div class="w-16 h-16 rounded-full bg-white border border-slate-200/80 shadow-md shadow-slate-100 flex items-center justify-center text-slate-800 font-black text-lg mx-auto relative hover:scale-105 transition-transform duration-300">
          02
        </div>
        <h4 class="text-base font-black text-slate-800 uppercase">Invite Companions</h4>
        <p class="text-xs text-slate-500 leading-relaxed max-w-xs mx-auto">
          Send click-invitations directly to online friends. They accept over persistent socket triggers and join your console immediately.
        </p>
      </div>

      <!-- Step 3 -->
      <div class="text-center space-y-4">
        <div class="w-16 h-16 rounded-full bg-white border border-slate-200/80 shadow-md shadow-slate-100 flex items-center justify-center text-slate-800 font-black text-lg mx-auto relative hover:scale-105 transition-transform duration-300">
          03
        </div>
        <h4 class="text-base font-black text-slate-800 uppercase">Code &amp; Compile</h4>
        <p class="text-xs text-slate-500 leading-relaxed max-w-xs mx-auto">
          Share coordinates, edit lines collaboratively, and run unit tests. In case Docker clusters are busy, native system fallbacks process scripts.
        </p>
      </div>
    </div>
  </section>

  <!-- PREMIUM BENTO FEATURE SHOWCASE -->
  <section id="features-grid" class="max-w-7xl mx-auto w-full px-6 md:px-12 py-20 border-t border-slate-200/30">
