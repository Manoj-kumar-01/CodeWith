  <script>
    // Toggle Accordions (FAQ section)
    function toggleAccordion(id) {
      const items = ['accordion-1', 'accordion-2', 'accordion-3'];
      items.forEach(itemId => {
        const elem = document.getElementById(itemId);
        const arrow = document.getElementById('arrow-' + itemId);
        if(itemId === id) {
          elem.classList.toggle('accordion-active');
          arrow.classList.toggle('rotate-180');
        } else {
          elem.classList.remove('accordion-active');
          arrow.classList.remove('rotate-180');
        }
      });
    }

    // Toggle Workspace Demo modes (Sandbox vs Live Multiplayer)
    let currentDemoMode = 'sandbox';
    let collabSimulationActive = false;
    let collabIntervalId = null;

    function changeDemoMode(mode) {
      if(currentDemoMode === mode) return;
      currentDemoMode = mode;
      
      const btnSandbox = document.getElementById('demo-btn-sandbox');
      const btnCollab = document.getElementById('demo-btn-collab');
      
      const sandboxWork = document.getElementById('sandbox-workspace');
      const collabWork = document.getElementById('collab-workspace');
      
      const filenameLabel = document.getElementById('editor-filename');
      const actionTriggerBtn = document.getElementById('action-trigger-btn');
      const consoleLog = document.getElementById('demo-console-log');
      
      // Stop running collaboration simulator if active
      if(collabIntervalId) {
        clearInterval(collabIntervalId);
        collabIntervalId = null;
      }
      collabSimulationActive = false;
      
      if(mode === 'sandbox') {
        btnSandbox.classList.add('bg-white', 'text-slate-800', 'shadow-sm');
        btnSandbox.classList.remove('text-slate-500');
        btnCollab.classList.remove('bg-white', 'text-slate-800', 'shadow-sm');
        btnCollab.classList.add('text-slate-500');
        
        sandboxWork.classList.remove('hidden');
        sandboxWork.classList.add('block');
        collabWork.classList.add('hidden');
        collabWork.classList.remove('block');
        
        filenameLabel.textContent = 'sandbox_compiler.js';
        actionTriggerBtn.innerHTML = `<i data-lucide="play" class="w-3.5 h-3.5"></i> Compile Program`;
        consoleLog.innerHTML = `<span class="text-slate-500 italic">Click compile to run code...</span>`;
      } else {
        btnCollab.classList.add('bg-white', 'text-slate-800', 'shadow-sm');
        btnCollab.classList.remove('text-slate-500');
        btnSandbox.classList.remove('bg-white', 'text-slate-800', 'shadow-sm');
        btnSandbox.classList.add('text-slate-500');
        
        collabWork.classList.remove('hidden');
        collabWork.classList.add('block');
        sandboxWork.classList.add('hidden');
        sandboxWork.classList.remove('block');
        
        filenameLabel.textContent = 'multiplayer_session.py';
        actionTriggerBtn.innerHTML = `<i data-lucide="play-circle" class="w-3.5 h-3.5"></i> Start Multiplayer Replay`;
        collabWork.innerHTML = `<span class="text-slate-400">// Click 'Start Multiplayer Replay' to simulate live pair-programming...</span>`;
        consoleLog.innerHTML = `<span class="text-slate-500 italic">Simulate co-coding replay session...</span>`;
      }
      
      if(typeof lucide !== 'undefined') lucide.createIcons();
    }

    // Trigger action based on Mode
    function triggerWorkspaceExecution() {
      if(currentDemoMode === 'sandbox') {
        runSandboxCompile();
      } else {
        runCollaborationSimulation();
      }
    }

    // Standard Sandbox compiler simulator
    function runSandboxCompile() {
      const loader = document.getElementById('demo-loader');
      const consoleLog = document.getElementById('demo-console-log');
      const triggerBtn = document.getElementById('action-trigger-btn');
      
      loader.classList.remove('hidden');
      triggerBtn.disabled = true;
      triggerBtn.classList.add('opacity-55', 'cursor-not-allowed');

      setTimeout(() => {
        loader.classList.add('hidden');
        triggerBtn.disabled = false;
        triggerBtn.classList.remove('opacity-55', 'cursor-not-allowed');
        
        consoleLog.innerHTML = `
          <div class="text-emerald-400">⏳ Connecting to Database fallbacks...</div>
          <div class="text-slate-300">Initializing dynamic sandbox on CodeWith?...</div>
          <div class="text-slate-400">[Sandbox] Executing node layer 1...</div>
          <div class="text-slate-400">[Sandbox] Executing node layer 2...</div>
          <div class="text-slate-400">[Sandbox] Executing node layer 3...</div>
          <div class="text-slate-500 text-[10px] mt-1 pt-1 border-t border-white/5">Process exited successfully in 12ms</div>
        `;
      }, 900);
    }

    // Advanced Co-coding replay simulator
    function runCollaborationSimulation() {
      if(collabSimulationActive) return;
      collabSimulationActive = true;
      
      const collabWork = document.getElementById('demo-workspace');
      const consoleLog = document.getElementById('demo-console-log');
      const triggerBtn = document.getElementById('action-trigger-btn');
      
      triggerBtn.disabled = true;
      triggerBtn.classList.add('opacity-55', 'cursor-not-allowed');
      
      consoleLog.innerHTML = `<div class="text-indigo-400">[System] Opening WebSocket session 'multiplayer_session'...</div>`;
      
      const steps = [
        {
          code: `<span class="text-indigo-500 font-bold">def</span> <span class="text-violet-600 font-semibold">calculateSum</span>(a, b):`,
          log: `<div class="text-slate-400">[Room] User 'Manoj' connected. Mode: Read/Write</div>`
        },
        {
          code: `<span class="text-indigo-500 font-bold">def</span> <span class="text-violet-600 font-semibold">calculateSum</span>(a, b):\n    <span class="text-slate-400"># Typing binary sum calculation...</span>`,
          log: `<div class="text-slate-300">[Manoj] Typing helper functions...</div>`
        },
        {
          code: `<span class="text-indigo-500 font-bold">def</span> <span class="text-violet-600 font-semibold">calculateSum</span>(a, b):\n    <span class="text-slate-400"># Typing binary sum calculation...</span>\n    <span class="text-indigo-500 font-bold">return</span> a + b`,
          log: `<div class="text-indigo-400">[Room] User 'AI-Companion' connected. Mode: Suggest</div>`
        },
        {
          code: `<span class="text-indigo-500 font-bold">def</span> <span class="text-violet-600 font-semibold">calculateSum</span>(a, b):\n    <span class="text-slate-400"># Typing binary sum calculation...</span>\n    <span class="text-indigo-500 font-bold">return</span> a + b\n\n<span class="text-indigo-500 font-bold">def</span> <span class="text-violet-600 font-semibold">binaryAdd</span>(x, y):\n    <span class="text-slate-400"># AI-Companion optimized suggestion:</span>\n    <span class="text-indigo-500 font-bold">return</span> bin(x + y)`,
          log: `<div class="text-emerald-400">[AI-Companion] Injected Sieve calculation helper!</div>`
        },
        {
          code: `<span class="text-indigo-500 font-bold">def</span> <span class="text-violet-600 font-semibold">calculateSum</span>(a, b):\n    <span class="text-slate-400"># Typing binary sum calculation...</span>\n    <span class="text-indigo-500 font-bold">return</span> a + b\n\n<span class="text-indigo-500 font-bold">def</span> <span class="text-violet-600 font-semibold">binaryAdd</span>(x, y):\n    <span class="text-slate-400"># AI-Companion optimized suggestion:</span>\n    <span class="text-indigo-500 font-bold">return</span> bin(x + y)\n\n<span class="text-blue-500 font-bold">print</span>(binaryAdd(10, 5))`,
          log: `<div class="text-slate-300">[Manoj] Running remote compile request...</div>`
        },
        {
          code: `<span class="text-indigo-500 font-bold">def</span> <span class="text-violet-600 font-semibold">calculateSum</span>(a, b):\n    <span class="text-slate-400"># Typing binary sum calculation...</span>\n    <span class="text-indigo-500 font-bold">return</span> a + b\n\n<span class="text-indigo-500 font-bold">def</span> <span class="text-violet-600 font-semibold">binaryAdd</span>(x, y):\n    <span class="text-slate-400"># AI-Companion optimized suggestion:</span>\n    <span class="text-indigo-500 font-bold">return</span> bin(x + y)\n\n<span class="text-blue-500 font-bold">print</span>(binaryAdd(10, 5))`,
          log: `
            <div class="text-emerald-400">🐍 Starting sandboxed Python engine fallback...</div>
            <div class="text-slate-100 font-bold">0b1111</div>
            <div class="text-slate-500 text-[10px] mt-1 pt-1 border-t border-white/5">Session synchronized successfully (Test passed: 10/10)</div>
          `
        }
      ];
      
      let stepIndex = 0;
      
      collabIntervalId = setInterval(() => {
        if(stepIndex < steps.length) {
          const step = steps[stepIndex];
          collabWork.innerHTML = `<pre class="whitespace-pre text-slate-700">${step.code}</pre>`;
          consoleLog.innerHTML += step.log;
          consoleLog.scrollTop = consoleLog.scrollHeight;
          stepIndex++;
        } else {
          clearInterval(collabIntervalId);
          collabIntervalId = null;
          triggerBtn.disabled = false;
          triggerBtn.classList.remove('opacity-55', 'cursor-not-allowed');
          collabSimulationActive = false;
        }
      }, 1000);
    }

    // Initialize Lucide icons on load
    document.addEventListener('DOMContentLoaded', () => {
      if(typeof lucide !== 'undefined') {
        lucide.createIcons();
      }
    });
  </script>
</body>
</html>
