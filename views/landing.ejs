    <div class="flex flex-col sm:flex-row items-center gap-4 md:gap-12">
      <a href="/" class="hover:opacity-95 transition-opacity">
        <%- include('partials/logo') %>
      </a>
      
      <!-- Central Nav Links (Always Visible & Self-Wrapping) -->
      <div class="flex items-center flex-wrap justify-center gap-x-6 gap-y-2 text-xs md:text-sm font-bold text-slate-500">
        <a href="#mission-sec" class="hover:text-slate-900 transition-colors">Our Mission</a>
        <a href="/about" class="hover:text-slate-900 transition-colors">About Us</a>
        <a href="/features" class="hover:text-slate-900 transition-colors">Platform Specs</a>
        <a href="/contact" class="hover:text-slate-900 transition-colors">Contact Support</a>
        <a href="#faq" class="hover:text-slate-900 transition-colors">FAQ</a>
      </div>
    </div>

    <!-- Auth Buttons -->
    <div class="flex items-center gap-4">
      <a href="/login" class="px-4 py-2 text-sm font-bold text-slate-600 hover:text-slate-900 transition-colors">
        Log In
      </a>
      <a href="/register" class="px-5 py-2.5 rounded-xl text-sm font-black text-white bg-slate-800 hover:bg-slate-700 transition-colors border border-slate-800 shadow-md shadow-slate-800/10">
        Sign Up
      </a>
    </div>
  </nav>

  <!-- HERO HEADER SECTION -->
  <header class="max-w-7xl mx-auto w-full px-6 md:px-12 pt-16 pb-16 grid grid-cols-1 lg:grid-cols-12 gap-16 items-center">
    
    <!-- Hero Text (6 Cols) -->
    <div class="lg:col-span-6 space-y-8 flex flex-col justify-center">

      <h1 class="text-4xl md:text-5xl lg:text-6xl font-black tracking-tight text-slate-800 uppercase leading-none">
        The Collaborative <br>
        <span class="gradient-text">
          Programming Playground
        </span>
      </h1>

      <p class="text-base md:text-lg text-slate-500 font-medium leading-relaxed">
        CodeWith? is the premier platform built exclusively to showcase collaborative programming. Participate in weekly tournaments, spin up real-time custom rooms with companions, and run complex algorithms instantly in a high-fidelity environment.
      </p>

      <!-- CTA Buttons and Real-Time Counters -->
      <div class="space-y-4">
        <div class="flex flex-col sm:flex-row gap-4 pt-2">
          <a href="/register" class="px-8 py-4 rounded-xl text-center text-sm font-black tracking-wide uppercase text-white bg-slate-800 hover:bg-slate-700 hover:translate-y-[-1px] active:translate-y-[1px] transition-all shadow-lg shadow-slate-800/10">
            Get Started For Free
          </a>
          <a href="#playground-demo" class="px-8 py-4 rounded-xl text-center text-sm font-semibold text-slate-600 bg-white border border-slate-200 hover:bg-slate-50 hover:translate-y-[-1px] transition-all">
            Explore Editor
          </a>
        </div>
        <p class="text-[11px] font-semibold text-slate-400 flex items-center gap-2">
          <i data-lucide="sparkles" class="w-3.5 h-3.5 text-yellow-500 animate-pulse"></i>
          <span>Join over 24,000+ developers competing in tournaments today.</span>
        </p>
      </div>
    </div>

    <!-- Hero Stunning Collaborative Multiplayer Image (6 Cols) -->
    <div class="lg:col-span-6 relative w-full flex items-center justify-center">
      <div class="absolute -inset-4 rounded-3xl bg-gradient-to-br from-indigo-100/40 via-purple-100/30 to-sky-100/40 blur-2xl opacity-60"></div>
      
      <div class="relative w-full rounded-2xl p-2 hover:scale-[1.01] transition-all duration-300">
        <img src="/images/multiplayer_coding_hero.png" alt="Multiplayer Co-Coding in Action" class="w-full h-auto rounded-xl object-cover mix-blend-multiply opacity-95" />
      </div>
    </div>
  </header>

  <!-- VALUE PROPOSITION STRIP -->
  <section class="max-w-5xl mx-auto w-full px-6 md:px-12 py-10">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 md:gap-12">

      <div class="flex items-start gap-4">
        <div class="w-10 h-10 rounded-xl bg-indigo-50 border border-indigo-100 flex items-center justify-center text-indigo-600 shrink-0">
          <i data-lucide="code-2" class="w-5 h-5"></i>
        </div>
        <div>
          <h4 class="text-sm font-black text-slate-800">Code Together, Live</h4>
          <p class="text-xs text-slate-400 mt-1 leading-relaxed">Invite friends into real-time coding rooms. Every keystroke syncs instantly.</p>
        </div>
      </div>

      <div class="flex items-start gap-4">
        <div class="w-10 h-10 rounded-xl bg-emerald-50 border border-emerald-100 flex items-center justify-center text-emerald-600 shrink-0">
