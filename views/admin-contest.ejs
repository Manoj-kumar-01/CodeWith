<%- include('partials/head') %>

    <body class="min-h-screen bg-background text-foreground font-sans antialiased">
        <div class="fixed inset-0 pointer-events-none z-0">
            <div class="absolute inset-0 bg-gradient-to-br from-background via-background to-primary/5"></div>
        </div>

        <div class="relative z-10 container mx-auto px-6 py-8 max-w-5xl">
            <div class="flex items-center gap-4 mb-8">
                <a href="/admin" class="p-2 rounded-lg hover:bg-secondary/50 transition-colors group">
                    <i data-lucide="arrow-left" class="w-5 h-5 text-muted-foreground group-hover:text-foreground"></i>
                </a>
                <div>
                    <h1 class="text-2xl font-bold">
                        <%= contest.title %>
                    </h1>
                    <p class="text-muted-foreground text-sm">Manage Contest Problems</p>
                </div>
                <div class="ml-auto flex items-center gap-2">
                    <span
                        class="px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-secondary/50 text-muted-foreground border border-border/50">
                        <i data-lucide="users" class="w-3 h-3 inline mr-1"></i>
                        <%= contest.participants ? contest.participants.length : 0 %> Contestants
                    </span>
                    <span class="px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider
                    <%= contest.status === 'active' ? 'bg-emerald-500/20 text-emerald-400 border border-emerald-500/30' :
                        contest.status === 'upcoming' ? 'bg-amber-500/20 text-amber-400 border border-amber-500/30' :
                        'bg-rose-500/10 text-rose-500 border border-rose-500/20' %>">
                        <%= contest.status ? contest.status.toUpperCase() : 'UNKNOWN' %>
                    </span>
                </div>
            </div>

            <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
                <!-- Problem List -->
                <div class="lg:col-span-2 space-y-6">
                    <div class="glass-card overflow-hidden">
                        <div class="p-6 border-b border-border/30 flex items-center justify-between">
                            <h2 class="text-lg font-bold flex items-center gap-2">
                                <i data-lucide="list" class="w-5 h-5 text-primary"></i>
                                Included Problems (<%= contest.problemsList ? contest.problemsList.length : 0 %>)
                            </h2>
                        </div>
                        <% if (contest.problemsList && contest.problemsList.length> 0) { %>
                            <div class="overflow-x-auto">
                                <table class="w-full">
                                    <thead class="bg-secondary/30">
                                        <tr>
                                            <th
                                                class="px-6 py-3 text-left text-xs font-medium text-muted-foreground uppercase">
                                                Title</th>
                                            <th
                                                class="px-6 py-3 text-left text-xs font-medium text-muted-foreground uppercase">
                                                Diff</th>
                                            <th
                                                class="px-6 py-3 text-right text-xs font-medium text-muted-foreground uppercase">
                                                Pts</th>
                                            <th
                                                class="px-6 py-3 text-right text-xs font-medium text-muted-foreground uppercase">
                                                Action</th>
                                        </tr>
                                    </thead>
                                    <tbody class="divide-y divide-border/10">
                                        <% contest.problemsList.forEach(function(p) { %>
                                            <tr>
                                                <td class="px-6 py-3 text-sm font-medium">
                                                    <%= p.title %>
                                                </td>
                                                <td class="px-6 py-3">
                                                    <span class="text-[10px] uppercase font-bold px-2 py-0.5 rounded
                                        <%= p.difficulty === 'easy' ? 'bg-emerald-500/10 text-emerald-500' : 
                                            p.difficulty === 'medium' ? 'bg-amber-500/10 text-amber-500' : 
                                            'bg-rose-500/10 text-rose-500' %>">
                                                        <%= p.difficulty %>
                                                    </span>
                                                </td>
                                                <td class="px-6 py-3 text-right text-sm font-mono">
                                                    <%= p.points %>
                                                </td>
                                                <td class="px-6 py-3 text-right">
                                                    <form action="/admin/contest/<%= contest._id %>/remove-problem"
                                                        method="POST" class="inline">
                                                        <input type="hidden" name="problemId" value="<%= p.id %>">
                                                        <button type="submit"
                                                            class="text-muted-foreground hover:text-destructive transition-colors">
                                                            <i data-lucide="x" class="w-4 h-4"></i>
                                                        </button>
                                                    </form>
                                                </td>
                                            </tr>
                                            <% }); %>
                                    </tbody>
                                </table>
                            </div>
                            <% } else { %>
                                <div class="p-8 text-center text-muted-foreground">
                                    No problems added yet.
                                </div>
                                <% } %>
                    </div>
                </div>

                <!-- Add Problem Form -->
                <div class="space-y-6">
                    <div class="glass-card p-6">
                        <h2 class="text-lg font-bold mb-4 flex items-center gap-2">
                            <i data-lucide="plus-circle" class="w-5 h-5 text-accent"></i>
                            Add Problem
                        </h2>
                        <form action="/admin/contest/<%= contest._id %>/problem" method="POST" class="space-y-4">
                            <div class="space-y-2">
                                <label class="text-sm font-medium">Select Problem</label>
                                <select name="problemId" required
                                    class="w-full px-4 py-2 rounded-lg bg-secondary/30 border border-border/50 focus:border-primary/50 outline-none">
                                    <% if (availableProblems && availableProblems.length> 0) { %>
                                        <% availableProblems.forEach(function(p) { %>
                                            <option value="<%= p._id %>">
                                                <%= p.title %> (<%= p.difficulty %>)
                                            </option>
                                            <% }); %>
                                                <% } else { %>
                                                    <option disabled>No problems available in DB</option>
                                                    <% } %>
                                </select>
                            </div>
                            <div class="space-y-2">
                                <label class="text-sm font-medium">Points</label>
                                <input type="number" name="points" value="100" required
                                    class="w-full px-4 py-2 rounded-lg bg-secondary/30 border border-border/50 focus:border-primary/50 outline-none">
                            </div>
                            <button type="submit"
                                class="w-full py-2 rounded-lg bg-primary text-primary-foreground font-semibold hover:opacity-90 transition-opacity">
                                Add to Contest
                            </button>
                        </form>
                    </div>

                    <!-- Note -->
                    <div class="p-4 rounded-lg bg-blue-500/10 border border-blue-500/20 text-sm text-blue-400">
                        <i data-lucide="info" class="w-4 h-4 inline mr-1 text-blue-400"></i>
                        Problems added here will be hidden from participants until the contest starts.
                    </div>
                </div>
            </div>
        </div>
        <script src="https://unpkg.com/lucide@latest"></script>
        <script>
            if (typeof lucide !== 'undefined') {
                lucide.createIcons();
            }
        </script>
    </body>

    </html>