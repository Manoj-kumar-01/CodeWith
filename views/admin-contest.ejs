<%- include('partials/head') %>

    <body class="min-h-screen bg-slate-50 text-slate-900 font-sans antialiased selection:bg-indigo-100 selection:text-indigo-900">
        <!-- Professional Light Background -->
        <div class="fixed inset-0 pointer-events-none z-0 overflow-hidden">
            <div class="absolute inset-0 bg-[radial-gradient(#e2e8f0_1px,transparent_1px)] [background-size:24px_24px] opacity-40"></div>
            <div class="absolute inset-0 bg-gradient-to-br from-indigo-50/50 via-white to-slate-50/80"></div>
        </div>

        <div class="relative z-10 container mx-auto px-6 py-8 max-w-6xl">
            <!-- Header Section -->
            <div class="flex flex-col md:flex-row md:items-center gap-6 mb-10 pb-8 border-b border-slate-200/60">
                <a href="/admin" class="w-10 h-10 rounded-xl bg-white border border-slate-200 flex items-center justify-center text-slate-400 hover:text-indigo-600 hover:border-indigo-200 hover:shadow-sm transition-all group">
                    <i data-lucide="chevron-left" class="w-5 h-5 group-hover:-translate-x-0.5 transition-transform"></i>
                </a>
                <div>
                    <h1 class="text-3xl font-extrabold text-slate-900 tracking-tight">
                        <%= contest.title %>
                    </h1>
                    <div class="flex items-center gap-4 mt-1">
                        <!-- Description removed as requested -->
                    </div>
                </div>
                <div class="md:ml-auto flex items-center gap-3">
                    <div class="px-4 py-2 rounded-xl bg-white border border-slate-200 shadow-sm flex items-center gap-2">
                        <i data-lucide="users" class="w-4 h-4 text-slate-400"></i>
                        <span class="text-sm font-bold text-slate-700"><%= contest.participants ? contest.participants.length : 0 %></span>
                    </div>
                    <div class="px-4 py-2 rounded-xl border font-bold text-xs uppercase tracking-widest
                    <%= contest.status === 'active' ? 'bg-emerald-50 border-emerald-200 text-emerald-600' :
                        contest.status === 'upcoming' ? 'bg-amber-50 border-amber-200 text-amber-600' :
                        'bg-slate-100 border-slate-200 text-slate-500' %>">
                        <%= contest.status %>
                    </div>
                </div>
            </div>

            <div class="grid grid-cols-1 lg:grid-cols-12 gap-10">
                <!-- Included Problems (Col 8) -->
                <div class="lg:col-span-8 space-y-6">
                    <div class="bg-white rounded-3xl border border-slate-200 shadow-sm overflow-hidden ring-1 ring-slate-200/50">
                        <div class="p-6 border-b border-slate-200 flex items-center justify-between bg-slate-50/30">
                            <h2 class="text-lg font-bold text-slate-800 flex items-center gap-2">
                                <i data-lucide="layers" class="w-5 h-5 text-indigo-600"></i>
                                Problem Stack
                            </h2>
                            <span class="text-[10px] font-bold text-slate-400 uppercase tracking-widest">
                                <%= contest.problemsList ? contest.problemsList.length : 0 %> Included
                            </span>
                        </div>
                        
                        <% if (contest.problemsList && contest.problemsList.length > 0) { %>
                            <div class="overflow-x-auto">
                                <table class="w-full text-left">
                                    <thead>
                                        <tr class="text-[10px] font-bold text-slate-400 uppercase tracking-widest bg-slate-50/30">
                                            <th class="px-6 py-4">Challenge</th>
                                            <th class="px-6 py-4 text-right">Value</th>
                                            <th class="px-6 py-4 text-right">Operation</th>
                                        </tr>
                                    </thead>
                                    <tbody class="divide-y divide-slate-100">
                                        <% contest.problemsList.forEach(function(p) { %>
                                            <tr class="group hover:bg-slate-50/50 transition-all">
                                                <td class="px-6 py-4">
                                                    <p class="font-bold text-slate-800 text-sm"><%= p.title %></p>
                                                    <p class="text-[10px] text-slate-400 font-medium tracking-tight">ID: #<%= p.id.toString().slice(-6) %></p>
                                                </td>
                                                <td class="px-6 py-4 text-right font-bold text-slate-600">
                                                    <%= p.points %><span class="text-[10px] ml-0.5 text-slate-400 uppercase">pts</span>
                                                </td>
                                                <td class="px-6 py-4 text-right">
                                                    <form action="/admin/contest/<%= contest._id %>/remove-problem" method="POST" class="inline">
                                                        <input type="hidden" name="problemId" value="<%= p.id %>">
                                                        <button type="submit" class="w-8 h-8 flex items-center justify-center rounded-lg text-slate-300 hover:bg-rose-50 hover:text-rose-600 hover:border-rose-100 border border-transparent transition-all">
                                                            <i data-lucide="trash-2" class="w-4 h-4"></i>
                                                        </button>
                                                    </form>
                                                </td>
                                            </tr>
                                        <% }); %>
                                    </tbody>
                                </table>
                            </div>
                        <% } else { %>
                            <div class="px-6 py-20 text-center">
                                <div class="w-16 h-16 rounded-3xl bg-slate-100 flex items-center justify-center mx-auto mb-4 text-slate-400 border border-slate-200/50">
                                    <i data-lucide="clipboard-list" class="w-8 h-8"></i>
                                </div>
                                <h3 class="font-bold text-slate-900">Stack is Empty</h3>
                                <p class="text-sm text-slate-500 max-w-xs mx-auto mt-2">No problems have been added to this contest yet. Use the repository on the right.</p>
                            </div>
                        <% } %>
                    </div>
                </div>

                <!-- Add Problem Form (Col 4) -->
                <div class="lg:col-span-4 space-y-8">
                    <div class="bg-white rounded-3xl border border-slate-200 shadow-sm p-8 ring-1 ring-slate-200/50 sticky top-8">
                        <div class="flex items-center gap-3 mb-8">
                            <div class="p-2.5 rounded-xl bg-indigo-600 shadow-lg shadow-indigo-100">
                                <i data-lucide="plus-square" class="w-6 h-6 text-white"></i>
                            </div>
                            <h2 class="text-xl font-extrabold text-slate-900 tracking-tight">Add Resource</h2>
                        </div>
                        
                        <form action="/admin/contest/<%= contest._id %>/problem" method="POST" class="space-y-6">
                            <div class="space-y-2">
                                <label class="text-xs font-bold text-slate-500 uppercase tracking-widest ml-1">Library Problem</label>
                                <div class="relative group">
                                    <select name="problemId" required class="w-full px-4 py-3.5 rounded-2xl bg-slate-50 border border-slate-200 focus:bg-white focus:border-indigo-500 focus:ring-4 focus:ring-indigo-500/10 outline-none transition-all appearance-none cursor-pointer text-sm font-medium">
                                        <% if (availableProblems && availableProblems.length > 0) { %>
                                            <% availableProblems.forEach(function(p) { %>
                                                <option value="<%= p._id %>">
                                                    <%= p.title %> (<%= p.difficulty %>)
                                                </option>
                                            <% }); %>
                                        <% } else { %>
                                            <option disabled>Repository empty</option>
                                        <% } %>
                                    </select>
                                    <div class="absolute right-4 top-1/2 -translate-y-1/2 pointer-events-none text-slate-400">
                                        <i data-lucide="chevron-down" class="w-4 h-4"></i>
                                    </div>
                                </div>
                            </div>
                            
                            <div class="space-y-2">
                                <label class="text-xs font-bold text-slate-500 uppercase tracking-widest ml-1">Score Allocation</label>
                                <input type="number" name="points" value="100" required
                                    class="w-full px-4 py-3.5 rounded-2xl bg-slate-50 border border-slate-200 focus:bg-white focus:border-indigo-500 focus:ring-4 focus:ring-indigo-500/10 outline-none transition-all text-sm font-bold">
                            </div>

                            <button type="submit" class="w-full py-4 rounded-2xl bg-slate-900 text-white font-bold hover:bg-indigo-600 transition-all shadow-xl shadow-slate-200 active:scale-[0.98] flex items-center justify-center gap-2">
                                <i data-lucide="plus" class="w-4 h-4"></i>
                                Inject into Contest
                            </button>
                        </form>

                        <div class="mt-8 p-4 rounded-2xl bg-indigo-50 border border-indigo-100 text-xs text-indigo-700 leading-relaxed font-medium">
                            <div class="flex gap-3">
                                <i data-lucide="info" class="w-4 h-4 text-indigo-400 shrink-0"></i>
                                <span>Problems injected here are immediately live if the contest is currently active.</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <script src="https://unpkg.com/lucide@latest"></script>
        <script>lucide.createIcons();</script>
    </body>
</html>