<%- include('partials/head') %>

    <body class="min-h-screen bg-background text-foreground selection:bg-primary/30 selection:text-primary-foreground overflow-hidden">
        <div class="fixed inset-0 w-screen h-screen overflow-hidden">
            <!-- Thin Neon / Edge Flow overlays -->
            <div class="vintage-overlay"></div>
            <div class="scanlines"></div>
            <div class="flicker-effect"></div>

            <!-- Ultra-Elegant Minimalist Background -->
            <div class="absolute inset-0 z-0 bg-[#050907]" id="bg-container">
                <!-- Vast, extremely subtle ambient glow for depth -->
                <div class="absolute top-[-20%] left-[10%] w-[80vw] h-[80vw] bg-[radial-gradient(circle,_hsl(152_58%_52%_/_0.06)_0%,_transparent_70%)] pointer-events-none"></div>
                <!-- Faint secondary glow to balance the scene -->
                <div class="absolute bottom-[-10%] right-[-10%] w-[60vw] h-[60vw] bg-[radial-gradient(circle,_hsl(38_92%_55%_/_0.03)_0%,_transparent_60%)] pointer-events-none"></div>
                
                <!-- Premium matte glass noise (prevents banding, adds a luxurious physical texture) -->
                <div class="absolute inset-0 opacity-[0.02] pointer-events-none" style="background-image: url('data:image/svg+xml,%3Csvg viewBox=%220 0 200 200%22 xmlns=%22http://www.w3.org/2000/svg%22%3E%3Cfilter id=%22noiseFilter%22%3E%3CfeTurbulence type=%22fractalNoise%22 baseFrequency=%220.85%22 numOctaves=%223%22 stitchTiles=%22stitch%22/%3E%3C/filter%3E%3Crect width=%22100%25%22 height=%22100%25%22 filter=%22url(%23noiseFilter)%22/%3E%3C/svg%3E');"></div>
            </div>

            <!-- Monitor Container -->
            <div class="relative z-10 w-screen h-screen">
                <div class="monitor-frame">
                    <div class="monitor-bezel">
                        <div class="monitor-screen">
                            <div class="flex h-full relative">
                                <!-- Sidebar -->
                                <%- include('partials/sidebar') %>

                                <!-- Main Content (Entire Page Scroll) -->
                                <main class="flex-1 flex flex-col min-w-0 overflow-y-auto scrollbar-thin relative pointer-events-auto" style="scroll-behavior: smooth; overscroll-behavior-y: contain;">
                                    <div class="relative z-10 flex flex-col min-h-full transition-all duration-300">
                                        <!-- Header (Static) -->
                                        <header class="border-b border-border/30 backdrop-blur-xl bg-background/50 z-20">
                                        <% 
                                           const leftActions = `
                                                <a href="/contest/${contest.id}" class="p-2 rounded-lg hover:bg-secondary/50 transition-colors group">
                                                    <i data-lucide="chevron-left" class="w-5 h-5 text-muted-foreground group-hover:text-foreground transition-colors"></i>
                                                </a>
                                           `;
                                           const statusHtml = `
                                                <div class="flex items-center gap-2 px-4 py-2 rounded-full bg-emerald-500/10 border border-emerald-500/30">
                                                    <div class="relative">
                                                        <div class="w-2.5 h-2.5 rounded-full bg-emerald-500"></div>
                                                        <div class="absolute inset-0 w-2.5 h-2.5 rounded-full bg-emerald-500 animate-ping"></div>
                                                    </div>
                                                    <span class="text-sm font-semibold text-emerald-400">LIVE · ${contest.title}</span>
                                                </div>
                                           `;
                                        %>
                                        <%- include('partials/top-bar', { 
                                            showShinyLine: false, 
                                            showAddFriend: false,
                                            leftActions: leftActions,
                                            extraActions: statusHtml
                                        }) %>
                                    </header>

                                    <!-- Content Area -->
                                    <div class="px-4 md:px-6 pb-6 mt-6">
                <!-- Bento Hero Dashboard -->
                <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 mb-8">
                    <!-- Box 1: Performance/Progress -->
                    <div class="glass-card p-6 bg-gradient-to-br from-emerald-500/10 to-transparent border-emerald-500/20 relative overflow-hidden group">
                        <div class="absolute top-0 right-0 w-24 h-24 bg-emerald-500/10 rounded-full blur-2xl -translate-y-1/2 translate-x-1/2 group-hover:bg-emerald-500/20 transition-colors"></div>
                        <div class="relative z-10">
                            <div class="flex items-center justify-between mb-4">
                                <span class="text-[10px] font-bold text-emerald-400 uppercase tracking-widest">Contest Progress</span>
                                <i data-lucide="target" class="w-4 h-4 text-emerald-400"></i>
                            </div>
                            <div class="flex items-end gap-3 mb-2">
                                <span class="text-4xl font-bold text-foreground tabular-nums">0</span>
                                <span class="text-lg text-muted-foreground pb-1">/ <%= problems.length %></span>
                            </div>
                            <div class="w-full h-1.5 bg-white/5 rounded-full overflow-hidden">
                                <div class="h-full bg-emerald-500 transition-all duration-1000 shadow-[0_0_10px_rgba(16,185,129,0.5)]" style="width: 0%"></div>
                            </div>
                            <p class="text-[10px] text-muted-foreground mt-3 uppercase tracking-tighter">Solved 0 problems so far</p>
                        </div>
                    </div>

                    <!-- Box 2: Time Remaining (Precision Aligned) -->
                    <div class="glass-card p-6 bg-gradient-to-br from-primary/10 to-transparent border-primary/20 relative overflow-hidden group">
                        <div class="absolute top-0 right-0 w-24 h-24 bg-primary/10 rounded-full blur-2xl -translate-y-1/2 translate-x-1/2 group-hover:bg-primary/20 transition-colors"></div>
                        <div class="relative z-10 flex flex-col items-center justify-center h-full">
                            <span class="text-[10px] font-bold text-primary uppercase tracking-widest mb-3">Time Remaining</span>
                            <div class="flex items-center gap-4">
                                <div class="text-4xl font-mono font-bold text-foreground tabular-nums tracking-tight leading-none" id="contestTimer">
                                    <%= contest.timeLeft %>
                                </div>
                                <div class="p-2.5 rounded-xl bg-primary/10 border border-primary/30 text-primary group-hover:scale-110 transition-transform">
                                    <i data-lucide="timer" class="w-6 h-6"></i>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Box 3: Points/Rank Info -->
                    <div class="glass-card p-6 bg-gradient-to-br from-amber-500/10 to-transparent border-amber-500/20 relative overflow-hidden group">
                        <div class="absolute top-0 right-0 w-24 h-24 bg-amber-500/10 rounded-full blur-2xl -translate-y-1/2 translate-x-1/2 group-hover:bg-amber-500/20 transition-colors"></div>
                        <div class="relative z-10">
                            <div class="flex items-center justify-between mb-4">
                                <span class="text-[10px] font-bold text-amber-400 uppercase tracking-widest">Points Secured</span>
                                <i data-lucide="award" class="w-4 h-4 text-amber-400"></i>
                            </div>
                            <div class="flex items-baseline gap-2 mb-4">
                                <span class="text-4xl font-bold text-foreground tabular-nums">0</span>
                                <span class="text-sm font-bold text-amber-400/70 uppercase">PTS</span>
                            </div>
                            <div class="flex items-center gap-2 px-3 py-1.5 rounded-lg bg-amber-500/5 border border-amber-500/20 w-fit">
                                <i data-lucide="trophy" class="w-3.5 h-3.5 text-amber-400"></i>
                                <span class="text-[10px] text-amber-200 font-bold uppercase tracking-wider">Rank #--</span>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Dashboard Content Area: 8-col Main, 4-col Sidebar -->
                <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
                    <!-- Main List: Problems (Column Span 8) -->
                    <div class="lg:col-span-8 space-y-6">
                        <div class="flex items-center justify-between mb-2 px-2">
                            <h3 class="text-xl font-bold text-foreground">Contest Problems</h3>
                            <div class="flex items-center gap-4 text-[10px] font-bold text-muted-foreground uppercase tracking-widest">
                                <span>Total Pts: <%= problems.reduce((acc, p) => acc + (p.points || 100), 0) %></span>
                                <span>•</span>
                                <span>Problems: <%= problems.length %></span>
                            </div>
                        </div>

                        <div class="grid grid-cols-1 gap-4">
                            <% if (problems && problems.length> 0) { %>
                                <% problems.forEach(function(problem, index) { %>
                                    <a href="/contest/<%= contest.id %>/problem/<%= problem._id || problem.id %>"
                                        class="group relative overflow-hidden rounded-2xl bg-white/5 border border-white/10 hover:border-primary/40 transition-all duration-300 shadow-xl hover:shadow-primary/5 hover:scale-[1.01]">


                                        <div class="relative p-6 flex items-center justify-between gap-6">
                                            <div class="flex items-center gap-6">
                                                <!-- Problem Badge -->
                                                <div class="w-12 h-12 rounded-xl bg-white/5 border border-white/10 flex items-center justify-center text-xl font-mono font-bold text-muted-foreground group-hover:text-primary group-hover:border-primary/30 transition-all shadow-inner">
                                                    <%= String.fromCharCode(65 + index) %>
                                                </div>

                                                <div class="space-y-1.5">
                                                    <div class="flex items-center gap-3">
                                                        <h4 class="text-lg font-bold text-foreground group-hover:text-primary transition-colors">
                                                            <%= problem.title %>
                                                        </h4>
                                                        <span class="text-[10px] font-black uppercase tracking-widest px-2 py-0.5 rounded-full border 
                                                            <%= problem.difficulty === 'easy' ? 'text-emerald-400 border-emerald-500/30 bg-emerald-500/5' : 
                                                                problem.difficulty === 'medium' ? 'text-amber-400 border-amber-500/30 bg-amber-500/5' : 
                                                                'text-rose-400 border-rose-500/30 bg-rose-500/5' %>">
                                                            <%= problem.difficulty %>
                                                        </span>
                                                    </div>
                                                    <div class="flex items-center gap-4 text-xs text-muted-foreground font-medium">
                                                        <span class="flex items-center gap-1.5">
                                                            <i data-lucide="zap" class="w-3.5 h-3.5 text-amber-400"></i>
                                                            <%= problem.points || 100 %> Pts
                                                        </span>
                                                        <span class="flex items-center gap-1.5">
                                                            <i data-lucide="check-circle-2" class="w-3.5 h-3.5 text-emerald-400"></i>
                                                            <%= problem.solved || 0 %> Solved
                                                        </span>
                                                        <span class="flex items-center gap-1.5">
                                                            <i data-lucide="activity" class="w-3.5 h-3.5 text-primary"></i>
                                                            <%= problem.acceptance || '0%' %> Accepted
                                                        </span>
                                                    </div>
                                                </div>
                                            </div>

                                            <div class="flex items-center gap-4">
                                                <div class="w-10 h-10 rounded-full bg-white/5 border border-white/10 flex items-center justify-center text-muted-foreground group-hover:bg-primary group-hover:border-primary group-hover:text-primary-foreground group-hover:rotate-[360deg] transition-all duration-500">
                                                    <i data-lucide="chevron-right" class="w-5 h-5"></i>
                                                </div>
                                            </div>
                                        </div>
                                    </a>
                                <% }); %>
                            <% } else { %>
                                <div class="glass-card p-16 text-center border-dashed border-white/10 bg-transparent">
                                    <i data-lucide="frown" class="w-12 h-12 text-muted-foreground/30 mx-auto mb-4"></i>
                                    <p class="text-sm text-muted-foreground">No problems found for this contest.</p>
                                </div>
                            <% } %>
                        </div>
                    </div>

                    <!-- Sidebar: Dashboard Info (Column Span 4) -->
                    <div class="lg:col-span-4 space-y-6">
                        <!-- Contest Overview Card -->
                        <div class="glass-card p-6 border-white/5 bg-gradient-to-br from-white/5 to-transparent relative overflow-hidden">
                            <div class="absolute top-0 right-0 p-4 opacity-10">
                                <i data-lucide="info" class="w-16 h-16"></i>
                            </div>
                            <h3 class="text-sm font-bold text-foreground mb-4 flex items-center gap-2">
                                <i data-lucide="info" class="w-4 h-4 text-primary"></i>
                                Contest Info
                            </h3>
                            <div class="space-y-4">
                                <div class="flex items-center justify-between text-xs py-2 border-b border-white/5">
                                    <span class="text-muted-foreground">Status</span>
                                    <span class="text-emerald-400 font-bold uppercase">Active</span>
                                </div>
                                <div class="flex items-center justify-between text-xs py-2 border-b border-white/5">
                                    <span class="text-muted-foreground">Total Problems</span>
                                    <span class="text-foreground font-bold tabular-nums"><%= problems.length %></span>
                                </div>
                                <div class="flex items-center justify-between text-xs py-2 border-b border-white/5">
                                    <span class="text-muted-foreground">Max Score</span>
                                    <span class="text-primary font-bold tabular-nums"><%= problems.reduce((acc, p) => acc + (p.points || 100), 0) %></span>
                                </div>
                            </div>
                        </div>

                        <!-- Quick Tips / Motivation -->
                        <div class="glass-card p-6 border-primary/20 bg-primary/5">
                            <div class="flex items-center gap-3 mb-3">
                                <div class="p-2 rounded-lg bg-primary/20 text-primary">
                                    <i data-lucide="lightbulb" class="w-4 h-4"></i>
                                </div>
                                <h3 class="text-sm font-bold text-foreground">Pro Tip</h3>
                            </div>
                            <p class="text-xs text-muted-foreground leading-relaxed">
                                Focus on problems with high acceptance rates first to build momentum and psychological safety.
                            </p>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <script>
            // Initialize Lucide Icons
            lucide.createIcons();

            // Real-time Countdown Timer
            const rawTime = "<%= contest.endTime || contest.endDate %>";
            const endTime = new Date(rawTime).getTime();
            const timerElement = document.getElementById('contestTimer');

            function updateTimer() {
                const now = Date.now();
                const diff = endTime - now;

                if (diff <= 0) {
                    if (timerElement) timerElement.textContent = "00:00:00";
                    return;
                }

                const h = Math.floor(diff / (1000 * 60 * 60));
                const m = Math.floor((diff % (1000 * 60 * 60)) / (1000 * 60));
                const s = Math.floor((diff % (1000 * 60)) / 1000);

                const display = [
                    h.toString().padStart(2, '0'),
                    m.toString().padStart(2, '0'),
                    s.toString().padStart(2, '0')
                ].join(':');

                if (timerElement) {
                    timerElement.textContent = display;
                    if (diff < 300000) { // 5 minutes
                        timerElement.classList.add('animate-pulse', 'text-rose-400');
                    }
                }
            }

            if (timerElement) {
                updateTimer();
                setInterval(updateTimer, 1000);
            }
        </script>
    </body>

    </html>