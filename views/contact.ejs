<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>CodeWith? - Support Contact</title>
  <link rel="stylesheet" href="/css/styles.css" />
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            background: 'hsl(var(--background))',
            foreground: 'hsl(var(--foreground))',
            card: { DEFAULT: 'hsl(var(--card))', foreground: 'hsl(var(--card-foreground))' },
            primary: { DEFAULT: 'hsl(var(--primary))', foreground: 'hsl(var(--primary-foreground))' },
            border: 'hsl(var(--border))',
          },
          fontFamily: { sans: ['Inter', 'sans-serif'], mono: ['JetBrains Mono', 'monospace'] },
        },
      },
    };
  </script>
  <script src="https://unpkg.com/lucide@latest/dist/umd/lucide.js"></script>
</head>
<body class="bg-minimal-clean min-h-screen flex flex-col antialiased select-none overflow-x-hidden text-slate-700">

  <!-- Ambient Blurred blobs -->
  <div class="absolute top-[10%] left-[-10%] w-[350px] h-[350px] bg-slate-200/20 rounded-full blur-[80px] pointer-events-none"></div>
  <div class="absolute bottom-[20%] right-[-10%] w-[400px] h-[400px] bg-indigo-100/20 rounded-full blur-[100px] pointer-events-none"></div>

  <!-- Navbar -->
  <nav class="sticky top-0 z-50 backdrop-blur-md bg-white/70 border-b border-slate-200/50 px-6 md:px-12 py-4 flex items-center justify-between">
    <div class="flex items-center gap-12">
      <a href="/" class="hover:opacity-95 transition-opacity">
        <%- include('partials/logo') %>
      </a>
      <div class="hidden lg:flex items-center gap-8 text-sm font-semibold text-slate-500">
        <a href="/" class="hover:text-slate-900 transition-colors">Home</a>
        <a href="/about" class="hover:text-slate-900 transition-colors">About</a>
        <a href="/features" class="hover:text-slate-900 transition-colors">Features</a>
        <a href="/contact" class="text-slate-950 font-bold">Contact</a>
      </div>
    </div>
    <div class="flex items-center gap-4">
      <a href="/login" class="px-4 py-2 text-sm font-bold text-slate-600 hover:text-slate-900 transition-colors">Log In</a>
      <a href="/register" class="px-5 py-2.5 rounded-xl text-sm font-black text-white bg-slate-800 hover:bg-slate-700 transition-colors border border-slate-800 shadow-md">Sign Up</a>
    </div>
  </nav>

  <!-- Main Hero Context -->
  <main class="max-w-xl mx-auto w-full px-6 py-20 flex-1 space-y-10 z-10">
    <div class="space-y-4 text-center">
      <div class="inline-flex items-center gap-2.5 px-3 py-1.5 rounded-full bg-slate-100 border border-slate-200 text-xs font-black tracking-widest text-slate-500 uppercase mx-auto">
        <span>Get in Touch</span>
      </div>
      <h1 class="text-4xl font-black tracking-tight text-slate-800 uppercase leading-none">
        Contact <span class="bg-gradient-to-r from-slate-800 to-indigo-900 bg-clip-text text-transparent">Support</span>
      </h1>
      <p class="text-xs text-slate-400 font-semibold leading-relaxed max-w-sm mx-auto">
        Have questions regarding container isolation or companion requests? Send us a message and we'll check back in hours.
      </p>
    </div>

    <!-- Contact Form Card -->
    <div class="bg-white/85 backdrop-blur-xl rounded-3xl border border-slate-200/80 p-8 shadow-2xl shadow-slate-200/50 space-y-6">
      <form onsubmit="event.preventDefault(); alert('Message sent successfully! We will get back to you shortly.'); this.reset();" class="space-y-4">
        
        <!-- Full Name Field -->
        <div class="space-y-1.5">
          <label class="block text-[10px] font-black text-slate-400 uppercase tracking-wider">Your Name</label>
          <div class="relative flex items-center">
            <span class="absolute left-4 text-slate-400"><i data-lucide="user" class="w-4 h-4"></i></span>
            <input type="text" required placeholder="John Doe"
              class="w-full bg-white/60 border border-slate-200 rounded-xl py-2.5 pl-11 pr-4 text-xs font-semibold text-slate-800 outline-none focus:border-slate-400 transition-colors placeholder:text-slate-300" />
          </div>
        </div>

        <!-- Email Field -->
        <div class="space-y-1.5">
          <label class="block text-[10px] font-black text-slate-400 uppercase tracking-wider">Email Address</label>
          <div class="relative flex items-center">
            <span class="absolute left-4 text-slate-400"><i data-lucide="mail" class="w-4 h-4"></i></span>
            <input type="email" required placeholder="you@domain.com"
              class="w-full bg-white/60 border border-slate-200 rounded-xl py-2.5 pl-11 pr-4 text-xs font-semibold text-slate-800 outline-none focus:border-slate-400 transition-colors placeholder:text-slate-300" />
          </div>
        </div>

        <!-- Message Field -->
        <div class="space-y-1.5">
          <label class="block text-[10px] font-black text-slate-400 uppercase tracking-wider">Message</label>
          <textarea required rows="4" placeholder="How can we help you solve your algorithmic doubts today?"
            class="w-full bg-white/60 border border-slate-200 rounded-xl py-2.5 px-4 text-xs font-semibold text-slate-800 outline-none focus:border-slate-400 transition-colors placeholder:text-slate-300 resize-none"></textarea>
        </div>

        <!-- Submit Trigger -->
        <button type="submit" class="w-full py-3 rounded-xl text-xs font-black tracking-wide uppercase text-white bg-slate-800 hover:bg-slate-700 transition-all border border-slate-800 shadow-lg shadow-slate-800/10 mt-2 flex items-center justify-center gap-2">
          <span>Send Message</span>
          <i data-lucide="send" class="w-4 h-4"></i>
        </button>
      </form>
    </div>
  </main>

  <!-- Footer -->
  <footer class="w-full bg-[#f8fafc] border-t border-slate-200/50 py-10 px-6 select-none mt-auto">
    <div class="max-w-4xl mx-auto flex flex-col sm:flex-row items-center justify-between gap-4 text-xs font-semibold text-slate-400">
      <span>&copy; 2026 CodeWith? Hub. All rights reserved.</span>
      <div class="flex gap-4">
        <a href="/" class="hover:text-slate-700 transition-colors">Home</a>
        <a href="/terms" class="hover:text-slate-700 transition-colors">Terms</a>
        <a href="/privacy" class="hover:text-slate-700 transition-colors">Privacy</a>
      </div>
    </div>
  </footer>

  <script>
    document.addEventListener('DOMContentLoaded', () => {
      if(typeof lucide !== 'undefined') lucide.createIcons();
    });
  </script>
</body>
</html>
