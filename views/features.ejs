<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>CodeWith? - Platform Specifications</title>
  <link rel="stylesheet" href="/css/styles.css" />
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            background: 'hsl(var(--background))',
            foreground: 'hsl(var(--foreground))',
            card: { DEFAULT: 'hsl(var(--card))', foreground: 'hsl(var(--card-foreground))' },
            primary: { DEFAULT: 'hsl(var(--primary))', foreground: 'hsl(var(--primary-foreground))' },
            border: 'hsl(var(--border))',
          },
          fontFamily: { sans: ['Inter', 'sans-serif'], mono: ['JetBrains Mono', 'monospace'] },
        },
      },
    };
  </script>
  <script src="https://unpkg.com/lucide@latest/dist/umd/lucide.js"></script>
</head>
<body class="bg-minimal-clean min-h-screen flex flex-col antialiased select-none overflow-x-hidden text-slate-700">

  <!-- Ambient Blurred blobs -->
  <div class="absolute top-[10%] right-[-10%] w-[350px] h-[350px] bg-slate-200/20 rounded-full blur-[80px] pointer-events-none"></div>
  <div class="absolute bottom-[20%] left-[-10%] w-[400px] h-[400px] bg-indigo-100/20 rounded-full blur-[100px] pointer-events-none"></div>

  <!-- Navbar -->
  <nav class="sticky top-0 z-50 backdrop-blur-md bg-white/70 border-b border-slate-200/50 px-6 md:px-12 py-4 flex items-center justify-between">
    <div class="flex items-center gap-12">
      <a href="/" class="hover:opacity-95 transition-opacity">
        <%- include('partials/logo') %>
      </a>
      <div class="hidden lg:flex items-center gap-8 text-sm font-semibold text-slate-500">
        <a href="/" class="hover:text-slate-900 transition-colors">Home</a>
        <a href="/about" class="hover:text-slate-900 transition-colors">About</a>
        <a href="/features" class="text-slate-950 font-bold">Features</a>
        <a href="/contact" class="hover:text-slate-900 transition-colors">Contact</a>
      </div>
    </div>
    <div class="flex items-center gap-4">
      <a href="/login" class="px-4 py-2 text-sm font-bold text-slate-600 hover:text-slate-900 transition-colors">Log In</a>
      <a href="/register" class="px-5 py-2.5 rounded-xl text-sm font-black text-white bg-slate-800 hover:bg-slate-700 transition-colors border border-slate-800 shadow-md">Sign Up</a>
    </div>
  </nav>

  <!-- Main Hero Context -->
  <main class="max-w-4xl mx-auto w-full px-6 py-20 flex-1 space-y-16">
    <div class="space-y-6 text-center">
      <div class="inline-flex items-center gap-2.5 px-3 py-1.5 rounded-full bg-slate-100 border border-slate-200 text-xs font-black tracking-widest text-slate-500 uppercase mx-auto">
        <span>Architectural Specs</span>
      </div>
      <h1 class="text-4xl md:text-5xl font-black tracking-tight text-slate-800 uppercase leading-none">
        Collaborative <br />
        <span class="bg-gradient-to-r from-slate-800 to-indigo-900 bg-clip-text text-transparent">Powerhouse</span>
      </h1>
      <p class="text-base md:text-lg text-slate-500 leading-relaxed max-w-2xl mx-auto font-medium">
        CodeWith? is engineered to provide an isolated sandbox environment with high compiler velocity and real-time multiplayer cursor highlights.
      </p>
    </div>

    <!-- Core Grid Specs -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      
      <!-- Feature 1 -->
      <div class="bg-white/70 border border-slate-200/80 rounded-2xl p-6 space-y-4 shadow-sm shadow-slate-100">
        <div class="w-10 h-10 rounded-xl bg-indigo-50 border border-indigo-100 flex items-center justify-center text-indigo-600">
          <i data-lucide="zap" class="w-5 h-5"></i>
        </div>
        <h3 class="text-base font-black text-slate-800 uppercase">WebSocket Layer</h3>
        <p class="text-xs text-slate-500 leading-relaxed">
          Powered by custom Socket.io rooms, supporting seamless co-coding streams, cursor locations, and dynamic room templates with zero setup lag.
        </p>
      </div>

      <!-- Feature 2 -->
      <div class="bg-white/70 border border-slate-200/80 rounded-2xl p-6 space-y-4 shadow-sm shadow-slate-100">
        <div class="w-10 h-10 rounded-xl bg-rose-50 border border-rose-100 flex items-center justify-center text-rose-500">
          <i data-lucide="box" class="w-5 h-5"></i>
        </div>
        <h3 class="text-base font-black text-slate-800 uppercase">Isolated Compiler</h3>
        <p class="text-xs text-slate-500 leading-relaxed">
          Dedicated microservices executing code in secure containers for JavaScript, Python, C++, Go, Rust, and 9 other active runtime setups.
        </p>
      </div>

      <!-- Feature 3 -->
      <div class="bg-white/70 border border-slate-200/80 rounded-2xl p-6 space-y-4 shadow-sm shadow-slate-100">
        <div class="w-10 h-10 rounded-xl bg-emerald-50 border border-emerald-100 flex items-center justify-center text-emerald-600">
          <i data-lucide="shield-alert" class="w-5 h-5"></i>
        </div>
        <h3 class="text-base font-black text-slate-800 uppercase">Native Fallback</h3>
        <p class="text-xs text-slate-500 leading-relaxed">
          Maintains execution security and performance via optimized bare-metal fallback when host Docker clusters are busy or unreachable.
        </p>
      </div>

    </div>

    <!-- Technical metrics -->
    <div class="bg-white/60 border border-slate-200/80 rounded-2xl p-8 space-y-6 shadow-sm">
      <h3 class="text-lg font-black text-slate-800 uppercase">Platform Limits & Safety</h3>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-8 text-xs font-semibold">
        <div class="space-y-2">
          <p class="text-slate-400">Memory Cap</p>
          <p class="text-slate-800 font-mono">128MB per runtime sandbox</p>
        </div>
        <div class="space-y-2">
          <p class="text-slate-400">WebSocket Timeout</p>
          <p class="text-slate-800 font-mono">30 minutes idle lifetime auto-recycle</p>
        </div>
        <div class="space-y-2">
          <p class="text-slate-400">Max Test Cases</p>
          <p class="text-slate-800 font-mono">50 unit test cases per execution query</p>
        </div>
        <div class="space-y-2">
          <p class="text-slate-400">Execution Timeout</p>
          <p class="text-slate-800 font-mono">5.0 seconds maximum execution cutoff</p>
        </div>
      </div>
    </div>
  </main>

  <!-- Footer -->
  <footer class="w-full bg-[#f8fafc] border-t border-slate-200/50 py-10 px-6 select-none mt-auto">
    <div class="max-w-4xl mx-auto flex flex-col sm:flex-row items-center justify-between gap-4 text-xs font-semibold text-slate-400">
      <span>&copy; 2026 CodeWith? Hub. All rights reserved.</span>
      <div class="flex gap-4">
        <a href="/" class="hover:text-slate-700 transition-colors">Home</a>
        <a href="/terms" class="hover:text-slate-700 transition-colors">Terms</a>
        <a href="/privacy" class="hover:text-slate-700 transition-colors">Privacy</a>
      </div>
    </div>
  </footer>

  <script>
    document.addEventListener('DOMContentLoaded', () => {
      if(typeof lucide !== 'undefined') lucide.createIcons();
    });
  </script>
</body>
</html>
