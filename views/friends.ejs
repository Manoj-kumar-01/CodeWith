<%- include('partials/head') %>

    <body class="min-h-screen bg-background text-foreground selection:bg-primary/30 selection:text-primary-foreground overflow-hidden">
        <div class="fixed inset-0 w-screen h-screen overflow-hidden">


            <!-- Clean Background -->
            <div class="absolute inset-0 z-0 bg-background" id="bg-container"></div>

            <!-- Monitor Container -->
            <div class="relative z-10 w-screen h-screen">
                <div class="flex h-full relative">
                                <!-- Main App Sidebar -->
                                <%- include('partials/sidebar') %>

                                <!-- Main Content -->
                                <main class="flex-1 flex flex-col min-w-0 overflow-hidden relative">
                                    <div class="relative z-10 flex flex-col h-full overflow-hidden">
                                        <!-- Header -->
                                        <header class="border-b border-white/10 backdrop-blur-2xl bg-secondary/80 z-50 sticky top-0 transition-all duration-300">
                                            <%- include('partials/top-bar', { showShinyLine: false, title: 'Friends Hub' }) %>
                                        </header>

                                        <!-- Friends Hub Main Container -->
                                        <div class="flex-1 flex overflow-hidden">
                                            <!-- Internal Vertical Sidebar -->
                                            <aside class="w-64 border-r border-white/5 flex flex-col bg-secondary/5 overflow-y-auto flex-shrink-0">
                                                <div class="p-4 space-y-1">
                                                    <div class="px-3 mb-4">
                                                        <h2 class="text-[10px] font-black uppercase tracking-[0.2em] text-muted-foreground opacity-50">Friends Hub</h2>
                                                    </div>
                                                    
                                                    <button onclick="switchTab('online')" data-tab="online"
                                                        class="friends-tab w-full flex items-center gap-3 px-4 py-3 rounded-xl bg-primary/10 text-primary font-bold border border-primary/20 transition-all text-xs">
                                                        <i data-lucide="wifi" class="w-4 h-4"></i>
                                                        <span class="flex-1 text-left uppercase tracking-wider">Online</span>
                                                        <span class="text-[10px] bg-primary/20 px-1.5 py-0.5 rounded-full" id="count-online">0</span>
                                                    </button>
                                                    <button onclick="switchTab('all')" data-tab="all"
                                                        class="friends-tab w-full flex items-center gap-3 px-4 py-3 rounded-xl text-muted-foreground hover:bg-white/5 hover:text-foreground transition-all text-xs font-bold">
                                                        <i data-lucide="users" class="w-4 h-4"></i>
                                                        <span class="flex-1 text-left uppercase tracking-wider">All Friends</span>
                                                        <span class="text-[10px] bg-white/5 px-1.5 py-0.5 rounded-full border border-white/10" id="count-all">0</span>
                                                    </button>
                                                    <button onclick="switchTab('pending')" data-tab="pending"
                                                        class="friends-tab w-full flex items-center gap-3 px-4 py-3 rounded-xl text-muted-foreground hover:bg-white/5 hover:text-foreground transition-all text-xs font-bold">
                                                        <i data-lucide="clock" class="w-4 h-4"></i>
                                                        <span class="flex-1 text-left uppercase tracking-wider">Requests</span>
                                                        <span class="text-[10px] bg-white/5 px-1.5 py-0.5 rounded-full border border-white/10" id="count-pending">0</span>
                                                    </button>
                                                    <button onclick="switchTab('suggestions')" data-tab="suggestions"
                                                        class="friends-tab w-full flex items-center gap-3 px-4 py-3 rounded-xl text-muted-foreground hover:bg-white/5 hover:text-foreground transition-all text-xs font-bold">
                                                        <i data-lucide="user-plus" class="w-4 h-4"></i>
                                                        <span class="flex-1 text-left uppercase tracking-wider">Discover</span>
                                                        <span class="text-[10px] bg-white/5 px-1.5 py-0.5 rounded-full border border-white/10" id="count-suggestions">0</span>
                                                    </button>
                                                </div>

                                                <!-- Footer Stats in Sidebar -->
                                                <div class="mt-auto p-4 border-t border-white/5">
                                                    <div class="flex flex-col gap-2 px-3">
                                                        <div class="flex items-center justify-between text-[10px] font-bold uppercase tracking-widest text-muted-foreground">
                                                            <span>Total Network</span>
                                                            <span class="text-foreground" id="stat-total">0</span>
                                                        </div>
                                                        <div class="flex items-center justify-between text-[10px] font-bold uppercase tracking-widest text-muted-foreground">
                                                            <span>Online Now</span>
                                                            <span class="text-emerald-400" id="stat-online">0</span>
                                                        </div>
                                                    </div>
                                                </div>
                                            </aside>

                                            <!-- Friends Content Area -->
                                            <div class="flex-1 overflow-y-auto scrollbar-thin flex flex-col">
                                                <!-- Search Bar (Pinned Top) -->
                                                <div class="px-6 py-5 border-b border-white/5 sticky top-0 bg-background/40 backdrop-blur-md z-20">
                                                    <div class="max-w-3xl relative group">
                                                        <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none">
                                                            <i data-lucide="search" class="w-4 h-4 text-muted-foreground group-focus-within:text-primary transition-colors"></i>
                                                        </div>
                                                        <input type="text" id="friends-search" placeholder="Search friends list..." oninput="handleSearch(this.value)"
                                                            class="w-full bg-white/5 border border-white/10 rounded-xl py-2.5 pl-11 pr-4 text-sm text-foreground placeholder:text-muted-foreground focus:outline-none focus:ring-1 focus:ring-primary/40 transition-all">
                                                    </div>
                                                </div>

                                                <!-- Transparent List Area -->
                                                <div class="p-6">
                                                    <div class="max-w-3xl" id="friends-content">
                                                        <div class="flex items-center justify-center py-20">
                                                            <div class="flex flex-col items-center gap-4">
                                                                <div class="w-8 h-8 border-2 border-primary/20 border-t-primary rounded-full animate-spin"></div>
                                                                <span class="text-[10px] font-black uppercase tracking-widest text-muted-foreground">Synchronizing...</span>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </main>
                </div>
            </div>
        </div>

        <!-- Toast Container -->
        <div id="toast-container" class="fixed bottom-6 right-6 z-[100] flex flex-col gap-2"></div>

        <style>
            .friend-card { transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1); }
            .friend-card:hover { transform: translateY(-2px); }

            .status-online { background: #10b981; box-shadow: 0 0 8px #10b981aa; }
            .status-offline { background: #6b7280; }
            .status-busy { background: #f59e0b; box-shadow: 0 0 8px #f59e0baa; }

            .pulse-online { animation: pulse-status 2s infinite; }
            @keyframes pulse-status { 0%, 100% { box-shadow: 0 0 0 0 rgba(16,185,129,0.4); } 50% { box-shadow: 0 0 0 4px rgba(16,185,129,0); } }

            .toast { animation: toastIn 0.4s ease-out, toastOut 0.4s ease-in 3.6s forwards; }
            @keyframes toastIn { from { transform: translateX(100%); opacity:0; } to { transform: translateX(0); opacity:1; } }
            @keyframes toastOut { from { opacity:1; } to { opacity:0; transform: translateY(8px); } }

            @keyframes fadeCard { from { opacity: 0; transform: translateY(12px); } to { opacity: 1; transform: translateY(0); } }
            .card-animate { animation: fadeCard 0.4s ease-out forwards; opacity: 0; }

            .action-btn { transition: all 0.2s; }
            .action-btn:active { transform: scale(0.92); }
        </style>

        <script>
            let currentTab = 'online';
            let friendsData = null;
            let searchTimeout = null;

            // ── Initial Load ──
            fetchFriends();
            setInterval(() => {
                const searchInput = document.getElementById('friends-search');
                const searchVal = searchInput ? searchInput.value : '';
                fetchFriends(searchVal || undefined, true);
            }, 4000);

            function fetchFriends(search, isPolling = false) {
                const params = new URLSearchParams();
                if (search) params.set('search', search);
                fetch('/api/friends?' + params.toString())
                    .then(r => r.json())
                    .then(data => {
                        // Deep comparison to skip re-rendering if data is structurally identical
                        if (isPolling && friendsData && JSON.stringify(data) === JSON.stringify(friendsData)) {
                            return;
                        }
                        friendsData = data;
                        updateCounts(data.counts);
                        renderTab(isPolling);
                    });
            }

            function updateCounts(counts) {
                document.getElementById('count-online').textContent = counts.online;
                document.getElementById('count-all').textContent = counts.all;
                document.getElementById('count-pending').textContent = counts.pending;
                document.getElementById('count-suggestions').textContent = counts.suggestions;
                document.getElementById('stat-total').textContent = counts.all;
                document.getElementById('stat-online').textContent = counts.online;
            }

            function switchTab(tab) {
                currentTab = tab;
                // Update button styles
                document.querySelectorAll('.friends-tab').forEach(btn => {
                    btn.classList.remove('bg-primary/10', 'text-primary', 'border-primary/20');
                    btn.classList.add('text-muted-foreground', 'hover:bg-white/5', 'hover:text-foreground');
                    const badge = btn.querySelector('span:last-child');
                    if (badge) {
                        badge.classList.remove('bg-primary/20');
                        badge.classList.add('bg-white/5', 'border-white/10');
                    }
                });
                const active = document.querySelector('.friends-tab[data-tab="' + tab + '"]');
                if (active) {
                    active.classList.add('bg-primary/10', 'text-primary', 'border-primary/20');
                    active.classList.remove('text-muted-foreground', 'hover:bg-white/5', 'hover:text-foreground');
                    const badge = active.querySelector('span:last-child');
                    if (badge) {
                        badge.classList.remove('bg-white/5', 'border-white/10');
                        badge.classList.add('bg-primary/20');
                    }
                }
                renderTab(false);
            }

            function handleSearch(val) {
                clearTimeout(searchTimeout);
                searchTimeout = setTimeout(() => fetchFriends(val), 250);
            }

            function renderTab(isPolling = false) {
                if (!friendsData) return;
                const content = document.getElementById('friends-content');

                switch (currentTab) {
                    case 'online':
                        renderFriendCards(friendsData.onlineFriends, 'Online', 'online', isPolling);
                        break;
                    case 'all':
                        renderFriendCards(friendsData.friends, 'All Friends', 'all', isPolling);
                        break;
                    case 'pending':
                        renderPending(isPolling);
                        break;
                    case 'suggestions':
                        renderSuggestions(isPolling);
                        break;
                }
                lucide.createIcons();
            }

            function getInitials(name) {
                return name.split(' ').map(w => w[0]).join('').toUpperCase().slice(0, 2);
            }

            function getStatusDot(status) {
                const cls = status === 'online' ? 'status-online pulse-online' : status === 'busy' ? 'status-busy' : 'status-offline';
                return '<div class="absolute -bottom-0.5 -right-0.5 w-3.5 h-3.5 rounded-full ' + cls + ' ring-2 ring-[hsl(var(--card))]"></div>';
            }

            function renderFriendCards(friends, label, type, isPolling = false) {
                const content = document.getElementById('friends-content');
                if (!friends || friends.length === 0) {
                    content.innerHTML =
                        '<div class="flex flex-col items-center justify-center py-20 text-center">' +
                        '<div class="w-16 h-16 rounded-2xl bg-secondary/40 flex items-center justify-center mb-4"><i data-lucide="users" class="w-7 h-7 text-muted-foreground"></i></div>' +
                        '<h3 class="text-xs font-bold text-foreground uppercase tracking-widest mb-1">No friends found</h3>' +
                        '<p class="text-[11px] text-muted-foreground max-w-sm">Check the Discover tab to find people to connect with!</p>' +
                        '</div>';
                    return;
                }

                let html = '<div class="space-y-4">';
                html += '<h2 class="text-[10px] font-black text-muted-foreground uppercase tracking-[0.2em] px-1 border-b border-primary/10 pb-2">' + label + ' • ' + friends.length + '</h2>';
                
                // Transparent Container for rows
                html += '<div class="bg-white/[0.03] border border-white/10 rounded-2xl overflow-hidden backdrop-blur-sm divide-y divide-white/5">';

                friends.forEach((f, i) => {
                    const isOnline = f.status === 'online';
                    const statusColor = isOnline ? 'text-emerald-400' : 'text-muted-foreground/50';
                    const statusDot = isOnline ? '<div class="w-1.5 h-1.5 rounded-full bg-emerald-400 shadow-[0_0_8px_rgba(52,211,153,0.5)]"></div>' : '<div class="w-1.5 h-1.5 rounded-full bg-white/10"></div>';
                    
                    const animClass = isPolling ? '' : 'card-animate';
                    const animDelay = isPolling ? '' : 'style="animation-delay:' + (i * 0.04) + 's"';
                    
                    html +=
                        '<div class="friend-row group ' + animClass + ' bg-transparent hover:bg-white/[0.02] transition-all overflow-hidden" ' + animDelay + '>' +
                            '<div class="flex items-center justify-between p-3.5 cursor-pointer select-none" onclick="toggleFriendActions(\'' + f.id + '\')">' +
                                '<div class="flex items-center gap-3">' +
                                    statusDot +
                                    '<div class="flex items-baseline gap-2">' +
                                        '<span class="font-bold text-sm text-foreground/90 tracking-tight">' + f.name + '</span>' +
                                        '<span class="text-[10px] text-muted-foreground/30 font-medium lowercase">@' + f.username + '</span>' +
                                    '</div>' +
                                '</div>' +
                                '<div class="flex items-center gap-4">' +
                                    '<span class="text-[9px] font-black uppercase tracking-[0.15em] ' + statusColor + '">' + (isOnline ? 'Online' : 'Offline') + '</span>' +
                                    '<i data-lucide="chevron-down" class="w-3.5 h-3.5 text-muted-foreground/20 transition-transform duration-300" id="chevron-' + f.id + '"></i>' +
                                '</div>' +
                            '</div>' +
                            '<div id="actions-' + f.id + '" class="hidden border-t border-white/5 bg-black/10 p-2 flex items-center justify-end gap-2">' +
                                '<a href="/profile?username=' + f.username + '" class="px-4 py-1.5 rounded-lg bg-white/5 hover:bg-primary text-muted-foreground hover:text-primary-foreground transition-all text-[10px] font-bold uppercase tracking-wider">' +
                                    'View Profile' +
                                '</a>' +
                                '<button onclick="removeFriend(\'' + f.id + '\')" class="px-4 py-1.5 rounded-lg bg-white/5 hover:bg-rose-500/20 text-muted-foreground/60 hover:text-rose-400 transition-all text-[10px] font-bold uppercase tracking-wider">' +
                                    'Remove' +
                                '</button>' +
                            '</div>' +
                        '</div>';
                });

                html += '</div>'; // End container
                html += '</div>'; // End space-y
                content.innerHTML = html;
            }

            function toggleFriendActions(id) {
                const actions = document.getElementById('actions-' + id);
                const chevron = document.getElementById('chevron-' + id);
                if (actions.classList.contains('hidden')) {
                    // Close others first
                    document.querySelectorAll('[id^="actions-"]').forEach(el => el.classList.add('hidden'));
                    document.querySelectorAll('[id^="chevron-"]').forEach(el => el.classList.remove('rotate-180'));
                    
                    actions.classList.remove('hidden');
                    chevron.classList.add('rotate-180');
                    lucide.createIcons();
                } else {
                    actions.classList.add('hidden');
                    chevron.classList.remove('rotate-180');
                }
            }

            function renderPending(isPolling = false) {
                const content = document.getElementById('friends-content');
                const received = friendsData.pendingReceived || [];
                const sent = friendsData.pendingSent || [];

                if (received.length === 0 && sent.length === 0) {
                    content.innerHTML =
                        '<div class="flex flex-col items-center justify-center py-20 text-center">' +
                        '<div class="w-16 h-16 rounded-2xl bg-secondary/40 flex items-center justify-center mb-4"><i data-lucide="inbox" class="w-7 h-7 text-muted-foreground"></i></div>' +
                        '<h3 class="text-xs font-bold text-foreground uppercase tracking-widest mb-1">No pending requests</h3>' +
                        '<p class="text-[11px] text-muted-foreground">You\'re all caught up!</p>' +
                        '</div>';
                    return;
                }

                let html = '';

                if (received.length > 0) {
                    html += '<h2 class="text-[10px] font-black text-muted-foreground uppercase tracking-[0.2em] mb-4 border-b border-white/5 pb-2">Incoming Requests • ' + received.length + '</h2>';
                    html += '<div class="space-y-1.5 mb-10">';
                    received.forEach((f, i) => {
                        const animClass = isPolling ? '' : 'card-animate';
                        const animDelay = isPolling ? '' : 'style="animation-delay:' + (i * 0.04) + 's"';
                        html +=
                            '<div class="friend-row group ' + animClass + ' bg-white/[0.02] border border-white/5 rounded-xl transition-all" ' + animDelay + '>' +
                                '<div class="flex items-center justify-between p-3.5">' +
                                    '<div class="flex items-center gap-3">' +
                                        '<div class="w-2 h-2 rounded-full bg-amber-400"></div>' +
                                        '<span class="font-bold text-sm text-foreground tracking-tight">' + f.name + '</span>' +
                                        '<span class="text-[10px] text-muted-foreground font-medium opacity-50">@' + f.username + '</span>' +
                                    '</div>' +
                                    '<div class="flex items-center gap-2">' +
                                        '<button onclick="acceptFriend(\'' + f.id + '\')" class="px-3 py-1 rounded-full bg-primary/10 hover:bg-primary text-primary hover:text-primary-foreground text-[10px] font-bold uppercase tracking-wider transition-all border border-primary/20">Accept</button>' +
                                        '<button onclick="rejectFriend(\'' + f.id + '\')" class="px-3 py-1 rounded-full bg-white/5 hover:bg-destructive/10 text-muted-foreground/60 hover:text-destructive text-[10px] font-bold uppercase tracking-wider transition-all">Decline</button>' +
                                    '</div>' +
                                '</div>' +
                            '</div>';
                    });
                    html += '</div>';
                }

                if (sent.length > 0) {
                    html += '<h2 class="text-[10px] font-black text-muted-foreground uppercase tracking-[0.2em] mb-4 border-b border-white/5 pb-2">Sent Requests • ' + sent.length + '</h2>';
                    html += '<div class="space-y-1.5">';
                    sent.forEach((f, i) => {
                        const animClass = isPolling ? '' : 'card-animate';
                        const animDelay = isPolling ? '' : 'style="animation-delay:' + (i * 0.04) + 's"';
                        html +=
                            '<div class="friend-row group ' + animClass + ' bg-white/[0.02] border border-white/5 rounded-xl transition-all" ' + animDelay + '>' +
                                '<div class="flex items-center justify-between p-3.5">' +
                                    '<div class="flex items-center gap-3">' +
                                        '<div class="w-2 h-2 rounded-full bg-white/10"></div>' +
                                        '<span class="font-bold text-sm text-foreground tracking-tight text-muted-foreground">' + f.name + '</span>' +
                                        '<span class="text-[10px] text-muted-foreground font-medium opacity-30">@' + f.username + '</span>' +
                                    '</div>' +
                                    '<button onclick="rejectFriend(\'' + f.id + '\')" class="px-3 py-1 rounded-full bg-white/5 hover:bg-destructive/10 text-muted-foreground/60 hover:text-destructive text-[10px] font-bold uppercase tracking-wider transition-all">Cancel</button>' +
                                '</div>' +
                            '</div>';
                    });
                    html += '</div>';
                }

                content.innerHTML = html;
                lucide.createIcons();
            }

            function renderSuggestions(isPolling = false) {
                const content = document.getElementById('friends-content');
                const suggestions = friendsData.suggestions || [];

                const animClass = isPolling ? '' : 'card-animate';
                const animDelay = isPolling ? '' : 'style="animation-delay:0s"';

                let html = `
                    <div class="glass-card p-5 mb-6 border border-primary/20 bg-primary/5 hover:border-primary/30 transition-all ${animClass}" ${animDelay}>
                        <h3 class="text-xs font-bold text-foreground uppercase tracking-wider mb-2 flex items-center gap-2">
                            <i data-lucide="user-plus" class="w-4 h-4 text-primary animate-pulse"></i> Add Friend by 10-Digit ID
                        </h3>
                        <p class="text-[11px] text-muted-foreground mb-4">Connect instantly with other coders by entering their unique 10-digit profile ID.</p>
                        <div class="flex gap-2">
                            <input type="text" id="add-friend-uid" placeholder="e.g. 1234567890" maxlength="10" 
                                class="flex-1 bg-white/5 border border-white/10 rounded-xl px-4 py-2.5 text-sm text-foreground focus:outline-none focus:ring-1 focus:ring-primary/40 transition-all placeholder:text-muted-foreground/40 font-mono"
                                onkeypress="if(event.key === 'Enter') sendFriendRequestByUID()">
                            <button id="send-uid-btn" onclick="sendFriendRequestByUID()" 
                                class="px-5 py-2.5 rounded-xl bg-primary text-primary-foreground font-bold text-xs uppercase tracking-wider hover:bg-primary/90 transition-all flex items-center gap-2 shrink-0">
                                Send Request
                            </button>
                        </div>
                    </div>
                `;

                if (suggestions.length === 0) {
                    html +=
                        '<div class="flex flex-col items-center justify-center py-12 text-center">' +
                        '<div class="w-16 h-16 rounded-2xl bg-secondary/40 flex items-center justify-center mb-4"><i data-lucide="compass" class="w-7 h-7 text-muted-foreground"></i></div>' +
                        '<h3 class="text-xs font-bold text-foreground uppercase tracking-widest mb-1">No suggestions</h3>' +
                        '<p class="text-[11px] text-muted-foreground">Check back later for new connections!</p>' +
                        '</div>';
                } else {
                    html += '<h2 class="text-[10px] font-black text-muted-foreground uppercase tracking-[0.2em] mb-5 border-b border-white/5 pb-2">Discover New Friends • ' + suggestions.length + '</h2>';
                    html += '<div class="space-y-1.5">';

                    suggestions.forEach((f, i) => {
                        const itemAnimClass = isPolling ? '' : 'card-animate';
                        const itemAnimDelay = isPolling ? '' : 'style="animation-delay:' + ((i + 1) * 0.04) + 's"';
                        html +=
                            '<div class="friend-row group ' + itemAnimClass + ' bg-white/[0.02] hover:bg-white/[0.05] border border-white/5 rounded-xl transition-all" ' + itemAnimDelay + '>' +
                                '<div class="flex items-center justify-between p-3.5">' +
                                    '<div class="flex items-center gap-3">' +
                                        '<div class="w-2 h-2 rounded-full bg-primary/40"></div>' +
                                        '<span class="font-bold text-sm text-foreground tracking-tight">' + f.name + '</span>' +
                                        '<span class="text-[10px] text-muted-foreground font-medium opacity-50">@' + f.username + '</span>' +
                                    '</div>' +
                                    '<button onclick="sendRequest(\'' + f.id + '\')" class="px-3 py-1 rounded-full bg-primary text-primary-foreground hover:bg-primary/90 text-[10px] font-bold uppercase tracking-wider transition-all flex items-center justify-center gap-1.5"><i data-lucide="user-plus" class="w-3 h-3"></i> Add</button>' +
                                '</div>' +
                            '</div>';
                    });

                    html += '</div>';
                }

                content.innerHTML = html;
                lucide.createIcons();
            }

            // ── Friend Actions ──
            function sendFriendRequestByUID() {
                const input = document.getElementById('add-friend-uid');
                const btn = document.getElementById('send-uid-btn');
                const uid = input.value.trim();

                if (!uid || !/^\d{10}$/.test(uid)) {
                    showToast('Please enter a valid 10-digit ID', 'error');
                    return;
                }

                const originalHTML = btn.innerHTML;
                btn.disabled = true;
                btn.innerHTML = 'Sending...';

                fetch('/api/friends/request', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ uid })
                })
                .then(r => r.json())
                .then(data => {
                    btn.disabled = false;
                    btn.innerHTML = originalHTML;
                    if (data.success) {
                        showToast(data.message, 'success');
                        input.value = '';
                        fetchFriends();
                    } else {
                        showToast(data.error || 'Action failed', 'error');
                    }
                })
                .catch(() => {
                    btn.disabled = false;
                    btn.innerHTML = originalHTML;
                    showToast('Network error', 'error');
                });
            }

            function sendRequest(userId) {
                friendAction('/api/friends/request', { userId });
            }
            function acceptFriend(userId) {
                friendAction('/api/friends/accept', { userId });
            }
            function rejectFriend(userId) {
                friendAction('/api/friends/reject', { userId });
            }
            function removeFriend(userId) {
                friendAction('/api/friends/remove', { userId });
            }

            function friendAction(url, body) {
                fetch(url, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(body)
                })
                .then(r => r.json())
                .then(data => {
                    if (data.success) {
                        showToast(data.message, 'success');
                    } else {
                        showToast(data.error || 'Action failed', 'error');
                    }
                    // Refresh data
                    const searchVal = document.getElementById('friends-search').value;
                    fetchFriends(searchVal || undefined);
                })
                .catch(() => showToast('Network error', 'error'));
            }

            // ── Toast System ──
            function showToast(message, type) {
                const container = document.getElementById('toast-container');
                if (!container) return;

                // Prevent identical concurrent toasts
                const existingSpans = container.querySelectorAll('.toast span');
                for (let span of existingSpans) {
                    if (span.textContent === message) {
                        return;
                    }
                }

                const colors = {
                    success: 'border-emerald-500/40 bg-emerald-500/10 text-emerald-400',
                    error: 'border-rose-500/40 bg-rose-500/10 text-rose-400',
                    info: 'border-primary/40 bg-primary/10 text-primary'
                };
                const icons = {
                    success: '<i data-lucide="check-circle" class="w-4 h-4 flex-shrink-0"></i>',
                    error: '<i data-lucide="alert-circle" class="w-4 h-4 flex-shrink-0"></i>',
                    info: '<i data-lucide="info" class="w-4 h-4 flex-shrink-0"></i>'
                };
                const toast = document.createElement('div');
                toast.className = 'toast flex items-center gap-2 px-4 py-3 rounded-xl border backdrop-blur-xl shadow-2xl text-sm ' + (colors[type] || colors.info);
                toast.innerHTML = (icons[type] || icons.info) + '<span>' + message + '</span>';
                container.appendChild(toast);
                lucide.createIcons();
                setTimeout(() => toast.remove(), 4000);
            }

            document.addEventListener('turbo:load', () => {
                if (typeof lucide !== 'undefined') {
                    lucide.createIcons();
                }
            });
        </script>
    </body>

    </html>
