<%- include('partials/head') %>

    <style>
        /* ── Join Button (contests only) ── */
        .join-btn {
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
            position: relative;
            overflow: hidden;
        }

        .join-btn::before {
            content: '';
            position: absolute;
            inset: 0;
            background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.1), transparent);
            transform: translateX(-100%);
            transition: transform 0.5s ease;
        }

        .join-btn:hover:not(:disabled) {
            background-color: hsl(var(--primary));
            color: hsl(var(--primary-foreground));
            transform: translateY(-2px);
            box-shadow: 0 4px 12px hsl(var(--primary) / 0.3);
        }

        .join-btn:hover:not(:disabled)::before {
            transform: translateX(100%);
        }

        .join-btn:disabled {
            opacity: 0.5;
            cursor: not-allowed;
            background-color: hsl(var(--secondary));
            color: hsl(var(--muted-foreground));
        }

        .contest-card:hover .join-btn:not(:disabled) {
            background-color: hsl(var(--primary));
            color: hsl(var(--primary-foreground));
            box-shadow: 0 4px 12px hsl(var(--primary) / 0.2);
        }
    </style>

    <body>
        <div class="min-h-screen bg-background">
            <div class="fixed inset-0 bg-gradient-to-br from-primary/5 via-background to-accent/5"></div>
            <div class="fixed inset-0 opacity-30">
                <div
                    class="absolute inset-0 bg-[radial-gradient(ellipse_at_top,_var(--tw-gradient-stops))] from-primary/20 via-transparent to-transparent">
                </div>
            </div>

            <div class="relative z-10 min-h-screen">
                <!-- Header -->
                <header class="border-b border-border/30 backdrop-blur-sm bg-background/50 sticky top-0 z-20">
                    <div class="container mx-auto px-4 py-4 flex items-center gap-4">
                        <a href="/" class="p-2 rounded-lg hover:bg-secondary/50 transition-colors">
                            <i data-lucide="chevron-left" class="w-5 h-5 text-muted-foreground"></i>
                        </a>
                        <%- include('partials/logo') %>
                    </div>
                </header>

                <div class="container mx-auto px-4 py-8">
                    <!-- Page Header -->
                    <div class="mb-8">
                        <h1 class="text-2xl md:text-3xl font-bold text-foreground mb-2 flex items-center gap-3">
                            <i data-lucide="trophy" class="w-7 h-7 md:w-8 md:h-8 text-primary"></i>
                            Active Contests
                        </h1>
                        <p class="text-muted-foreground">Compete with coders worldwide and win exciting prizes</p>
                    </div>

                    <!-- Filters -->
                    <div
                        class="glass-card p-3 md:p-4 mb-6 flex flex-col sm:flex-row items-stretch sm:items-center gap-3 md:gap-4">
                        <div class="flex items-center gap-2 flex-1 min-w-0">
                            <i data-lucide="search" class="w-5 h-5 text-muted-foreground flex-shrink-0"></i>
                            <input type="text" id="contest-search" placeholder="Search contests..."
                                class="bg-transparent border-none outline-none text-foreground placeholder:text-muted-foreground flex-1 min-w-0"
                                oninput="filterContests()" />
                        </div>
                        <div class="flex items-center gap-2">
                            <i data-lucide="filter" class="w-4 h-4 text-muted-foreground"></i>
                            <select id="contest-filter"
                                class="bg-secondary text-foreground px-3 py-2 rounded-lg border border-border/30 outline-none flex-1 sm:flex-initial"
                                onchange="filterContests()">
                                <option value="all">All Contests</option>
                                <option value="active" selected>Active</option>
                                <option value="upcoming">Upcoming</option>
                                <option value="participated">Participated</option>
                                <option value="past">Past Contests</option>
                            </select>
                        </div>
                    </div>

                    <!-- Stats Bar -->
                    <div class="grid grid-cols-2 gap-4 mb-8">
                        <div class="glass-card p-4 text-center">
                            <div class="text-3xl font-bold text-primary">
                                <%= activeContestsCount %>
                            </div>
                            <div class="text-sm text-muted-foreground">Live Contests</div>
                        </div>
                        <div class="glass-card p-4 text-center">
                            <div class="text-3xl font-bold text-success">
                                <%= totalParticipants.toLocaleString() %>
                            </div>
                            <div class="text-sm text-muted-foreground">Total Participants</div>
                        </div>
                    </div>

                    <!-- Contests Grid -->
                    <div class="grid grid-cols-1 lg:grid-cols-2 gap-4 md:gap-6" id="contests-grid">
                        <% contests.forEach(function(c) { %>
                            <div class="contest-card group relative" data-status="<%= c.status %>"
                                data-title="<%= c.title.toLowerCase() %>"
                                data-participants='<%= JSON.stringify(c.participants) %>'>
                                <div
                                    class="relative z-10 flex flex-col sm:flex-row sm:items-start justify-between gap-2 mb-4">
                                    <div class="flex-1 min-w-0">
                                        <div class="flex flex-wrap items-center gap-2 mb-2">
                                            <h3
                                                class="text-base md:text-lg font-bold text-foreground group-hover:text-primary transition-colors truncate">
                                                <%= c.title %>
                                            </h3>
                                            <% if (c.status==='active' ) { %>
                                                <span
                                                    class="flex items-center gap-1 text-[10px] md:text-xs bg-success/20 text-success px-2 py-0.5 rounded-full">
                                                    <i data-lucide="flame" class="w-3 h-3"></i> LIVE
                                                </span>
                                                <% } else if (c.status==='past' ) { %>
                                                    <span
                                                        class="flex items-center gap-1 text-[10px] md:text-xs bg-rose-500/20 text-rose-500 px-2 py-0.5 rounded-full">
                                                        <i data-lucide="lock" class="w-3 h-3"></i> ENDED
                                                    </span>
                                                    <% } else { %>
                                                        <span
                                                            class="flex items-center gap-1 text-[10px] md:text-xs bg-amber-500/20 text-amber-500 px-2 py-0.5 rounded-full">
                                                            <i data-lucide="clock" class="w-3 h-3"></i> UPCOMING
                                                        </span>
                                                        <% } %>
                                        </div>
                                        <p class="text-xs md:text-sm text-muted-foreground truncate">
                                            <%= c.subtitle %>
                                        </p>
                                    </div>
                                </div>
                                <div class="relative z-10 flex flex-wrap gap-1.5 md:gap-2 mb-4">
                                    <% if (c.tags && c.tags.length> 0) { %>
                                        <% c.tags.forEach(function(tag) { %>
                                            <span
                                                class="text-[10px] md:text-xs bg-secondary/50 text-muted-foreground px-2 py-1 rounded">
                                                <%= tag %>
                                            </span>
                                            <% }); %>
                                                <% } %>
                                </div>
                                <div class="relative z-10 grid grid-cols-2 gap-3 md:gap-4 mb-4">
                                    <div class="flex items-center gap-2 text-xs md:text-sm text-muted-foreground">
                                        <i data-lucide="users" class="w-4 h-4 text-primary flex-shrink-0"></i>
                                        <span>
                                            <%= c.participants.length.toLocaleString() %>
                                        </span>
                                    </div>
                                    <div class="flex items-center gap-2 text-xs md:text-sm text-muted-foreground">
                                        <i data-lucide="zap" class="w-4 h-4 text-accent flex-shrink-0"></i>
                                        <span>
                                            <%= c.problems %> Problems
                                        </span>
                                    </div>
                                    <div class="flex items-center gap-2 text-xs md:text-sm text-muted-foreground">
                                        <i data-lucide="clock"
                                            class="w-4 h-4 <%= c.status === 'upcoming' ? 'text-amber-500' : 'text-destructive' %> flex-shrink-0"></i>
                                        <span
                                            class="<%= c.status === 'upcoming' ? 'text-amber-500 font-medium' : '' %>">
                                            <%= c.status==='past' ? 'Finished' : (c.status==='upcoming' ? 'Starts in ' +
                                                c.timeUntilStart : c.timeLeft) %>
                                        </span>
                                    </div>
                                </div>

                                <!-- Quick Rules Section (Only 2 rules) -->
                                <div class="relative z-10 mb-4 pt-3 border-t border-border/20">
                                    <div
                                        class="flex items-center gap-2 text-[10px] uppercase tracking-wider text-muted-foreground mb-2 font-bold">
                                        <i data-lucide="scroll-text" class="w-3 h-3"></i> Quick Rules
                                    </div>
                                    <div class="space-y-1.5">
                                        <% if (c.rules && c.rules.length> 0) { %>
                                            <% c.rules.slice(0, 2).forEach(function(rule, idx) { %>
                                                <div class="flex items-start gap-2">
                                                    <div class="w-1.5 h-1.5 rounded-full bg-primary/40 mt-1.5 shrink-0">
                                                    </div>
                                                    <p class="text-[11px] text-muted-foreground/80 leading-tight">
                                                        <%= rule %>
                                                    </p>
                                                </div>
                                                <% }); %>
                                                    <% } else { %>
                                                        <p class="text-[11px] text-muted-foreground/60 italic">Standard
                                                            contest rules apply.</p>
                                                        <% } %>
                                    </div>
                                </div>

                                <% if (c.status==='past' ) { %>
                                    <div
                                        class="relative z-10 w-full py-2.5 md:py-3 rounded-lg bg-rose-500/10 text-rose-500 border border-rose-500/30 text-sm md:text-base font-semibold flex items-center justify-center gap-2 cursor-not-allowed">
                                        Contest Ended
                                        <i data-lucide="lock" class="w-4 h-4"></i>
                                    </div>
                                    <% } else { %>
                                        <a href="/contest/<%= c.id %>"
                                            class="join-btn relative z-10 w-full py-2.5 md:py-3 rounded-lg <%= c.status === 'active' ? 'bg-primary/20 text-primary' : 'bg-amber-500/20 text-amber-500' %> text-sm md:text-base font-semibold transition-all duration-300 flex items-center justify-center gap-2"
                                            onclick="event.stopPropagation()">
                                            <%= c.status==='active' ? 'Join Contest' : 'Register Now' %>
                                                <i data-lucide="chevron-right"
                                                    class="w-4 h-4 group-hover:translate-x-1 transition-transform"></i>
                                        </a>
                                        <% } %>
                            </div>
                            <% }); %>
                    </div>
                </div>
            </div>
        </div>

        <script>
            function filterContests() {
                var search = document.getElementById('contest-search').value.toLowerCase();
                var filter = document.getElementById('contest-filter').value;
                var userId = localStorage.getItem('userId');

                document.querySelectorAll('#contests-grid .contest-card').forEach(function (card) {
                    var title = card.getAttribute('data-title');
                    var status = card.getAttribute('data-status');
                    var participantsStr = card.getAttribute('data-participants');
                    var participants = participantsStr ? JSON.parse(participantsStr) : [];

                    var matchSearch = !search || title.includes(search);

                    var matchFilter = true;
                    if (filter === 'participated') {
                        matchFilter = userId && participants.includes(userId);
                    } else if (filter !== 'all') {
                        matchFilter = status === filter;
                    }

                    card.style.display = matchSearch && matchFilter ? '' : 'none';
                });
            }

            // Run initial filter to hide non-active if 'active' is default selected
            document.addEventListener('DOMContentLoaded', filterContests);

            // Initialize Lucide icons
            if (typeof lucide !== 'undefined') {
                lucide.createIcons();
            }
        </script>
        <script src="/js/card-effects.js"></script>
    </body>

    </html>