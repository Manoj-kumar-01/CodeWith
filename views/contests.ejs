<%- include('partials/head') %>

    <style>
        /* ── Join Button (contests only) ── */
        .join-btn {
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
            position: relative;
            overflow: hidden;
        }

        .join-btn::before {
            content: '';
            position: absolute;
            inset: 0;
            background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.1), transparent);
            transform: translateX(-100%);
            transition: transform 0.5s ease;
        }

        .join-btn:hover:not(:disabled) {
            background-color: hsl(var(--primary));
            color: hsl(var(--primary-foreground));
            transform: translateY(-2px);
            box-shadow: 0 4px 12px hsl(var(--primary) / 0.3);
        }

        .join-btn:hover:not(:disabled)::before {
            transform: translateX(100%);
        }

        .join-btn:disabled {
            opacity: 0.5;
            cursor: not-allowed;
            background-color: hsl(var(--secondary));
            color: hsl(var(--muted-foreground));
        }

        .contest-card:hover .join-btn:not(:disabled) {
            background-color: hsl(var(--primary));
            color: hsl(var(--primary-foreground));
            box-shadow: 0 4px 12px hsl(var(--primary) / 0.2);
        }
    </style>

    <body
        class="min-h-screen bg-background text-foreground selection:bg-primary/30 selection:text-primary-foreground overflow-hidden">
        <div class="fixed inset-0 w-screen h-screen overflow-hidden">


            <!-- Light Theme Background -->
            <div class="absolute inset-0 z-0 bg-background" id="bg-container">
                <!-- Subtle ambient depth -->
                <div class="absolute top-[-20%] left-[10%] w-[80vw] h-[80vw] bg-[radial-gradient(circle,_hsl(var(--primary)_/_0.03)_0%,_transparent_70%)] pointer-events-none"></div>
                <div class="absolute bottom-[-10%] right-[-10%] w-[60vw] h-[60vw] bg-[radial-gradient(circle,_hsl(var(--warning)_/_0.02)_0%,_transparent_60%)] pointer-events-none"></div>
            </div>

            <!-- Monitor Container -->
            <div class="relative z-10 w-screen h-screen">
                <div class="flex h-full relative">
                                <!-- Sticky Sidebar -->
                                <%- include('partials/sidebar') %>

                                    <!-- Main Content -->
                                    <main class="flex-1 flex flex-col min-w-0 overflow-hidden relative">
                                        <div class="relative z-10 flex flex-col h-full overflow-hidden">
                                            <!-- Header (Global Glassy) -->
                                            <header
                                                class="border-b border-border/30 backdrop-blur-xl bg-background/50 z-20">
                                                <%- include('partials/top-bar', { showShinyLine: false,
                                                    title: 'Contests' }) %>
                                            </header>

                                            <!-- Scrollable Content -->
                                            <div class="flex-1 overflow-y-auto scrollbar-thin px-4 md:px-6 pb-6"
                                                style="scroll-behavior: smooth;">

                                                <!-- Page Header + Inline Stats -->
                                                <div
                                                    class="flex flex-col sm:flex-row sm:items-end sm:justify-between gap-3 mb-5 mt-6">
                                                    <div>
                                                        <h1 class="text-2xl md:text-3xl font-bold text-foreground mb-1">
                                                            Active Contests
                                                        </h1>
                                                        <p class="text-sm text-muted-foreground">Compete with coders
                                                            worldwide and win exciting prizes</p>
                                                    </div>
                                                    <div class="flex items-center gap-3">
                                                        <div
                                                            class="flex items-center gap-2 px-3 py-1.5 rounded-lg bg-primary/10 border border-primary/20">
                                                            <div
                                                                class="w-1.5 h-1.5 rounded-full bg-primary animate-pulse">
                                                            </div>
                                                            <span class="text-xs font-bold text-primary tabular-nums">
                                                                <%= activeContestsCount %>
                                                            </span>
                                                            <span
                                                                class="text-[10px] text-primary/70 uppercase tracking-wider">Live</span>
                                                        </div>
                                                        <div
                                                            class="flex items-center gap-2 px-3 py-1.5 rounded-lg bg-secondary/50 border border-border/50">
                                                            <i data-lucide="users"
                                                                class="w-3.5 h-3.5 text-muted-foreground"></i>
                                                            <span
                                                                class="text-xs font-bold text-foreground tabular-nums">
                                                                <%= totalParticipants.toLocaleString() %>
                                                            </span>
                                                            <span
                                                                class="text-[10px] text-muted-foreground uppercase tracking-wider">Total</span>
                                                        </div>
                                                    </div>
                                                </div>

                                                <!-- Search & Filter (compact) -->
                                                <div class="glass-card p-2.5 mb-5 flex items-center gap-3">
                                                    <div class="flex items-center gap-2 flex-1 min-w-0 px-2">
                                                        <i data-lucide="search"
                                                            class="w-4 h-4 text-muted-foreground flex-shrink-0"></i>
                                                        <input type="text" id="contest-search"
                                                            placeholder="Search contests..."
                                                            class="bg-transparent border-none outline-none text-sm text-foreground placeholder:text-muted-foreground flex-1 min-w-0"
                                                            oninput="filterContests()" />
                                                    </div>
                                                    <div class="flex items-center gap-2">
                                                        <select id="contest-filter"
                                                            class="bg-secondary text-foreground text-xs px-3 py-1.5 rounded-lg border border-border/30 outline-none"
                                                            onchange="filterContests()">
                                                            <option value="all">All Contests</option>
                                                            <option value="active" selected>Active</option>
                                                            <option value="upcoming">Upcoming</option>
                                                            <option value="participated">Participated</option>
                                                            <option value="past">Past</option>
                                                        </select>
                                                    </div>
                                                </div>

                                                <!-- Contests Grid — compact cards -->
                                                <div class="grid grid-cols-1 lg:grid-cols-2 xl:grid-cols-3 gap-4"
                                                    id="contests-grid">
                                                    <% contests.forEach(function(c) { %>
                                                        <a href="/contest/<%= c.id %>"
                                                            class="contest-card group relative block flex flex-col"
                                                            data-status="<%= c.status %>"
                                                            data-title="<%= c.title.toLowerCase() %>"
                                                            data-participants='<%= JSON.stringify(c.participants) %>'>

                                                            <!-- Card Header — Title + Status -->
                                                            <div
                                                                class="relative z-10 flex items-start justify-between gap-3 mb-3">
                                                                <div class="flex-1 min-w-0">
                                                                    <h3
                                                                        class="text-sm font-bold text-foreground group-hover:text-primary transition-colors truncate mb-1">
                                                                        <%= c.title %>
                                                                    </h3>
                                                                    <p
                                                                        class="text-[11px] text-muted-foreground truncate">
                                                                        <%= c.subtitle %>
                                                                    </p>
                                                                </div>
                                                                <% if (c.status==='active' ) { %>
                                                                    <span
                                                                        class="flex items-center gap-1 text-[9px] font-bold bg-emerald-500/15 text-emerald-400 px-2 py-0.5 rounded-full border border-emerald-500/20 shrink-0 uppercase tracking-wider">
                                                                        <div
                                                                            class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse">
                                                                        </div>
                                                                        Live
                                                                    </span>
                                                                    <% } else if (c.status==='past' ) { %>
                                                                        <span
                                                                            class="flex items-center gap-1 text-[9px] font-bold bg-rose-500/15 text-rose-400 px-2 py-0.5 rounded-full border border-rose-500/20 shrink-0 uppercase tracking-wider">
                                                                            Ended
                                                                        </span>
                                                                        <% } else { %>
                                                                            <span
                                                                                class="flex items-center gap-1 text-[9px] font-bold bg-amber-500/15 text-amber-400 px-2 py-0.5 rounded-full border border-amber-500/20 shrink-0 uppercase tracking-wider">
                                                                                Upcoming
                                                                            </span>
                                                                            <% } %>
                                                            </div>

                                                            <!-- Tags -->
                                                            <% if (c.tags && c.tags.length> 0) { %>
                                                                <div class="relative z-10 flex flex-wrap gap-1 mb-3">
                                                                    <% c.tags.forEach(function(tag) { %>
                                                                        <span
                                                                            class="text-[9px] bg-white/5 text-muted-foreground px-1.5 py-0.5 rounded border border-white/5">
                                                                            <%= tag %>
                                                                        </span>
                                                                        <% }); %>
                                                                </div>
                                                                <% } %>

                                                                    <!-- Metadata Row -->
                                                                    <div
                                                                        class="relative z-10 flex items-center gap-4 text-[11px] text-muted-foreground mb-3 pt-2 border-t border-white/5">
                                                                        <span class="flex items-center gap-1.5">
                                                                            <i data-lucide="users"
                                                                                class="w-3 h-3 text-violet-400"></i>
                                                                            <%= c.participants.length %> joined
                                                                        </span>
                                                                        <span class="flex items-center gap-1.5">
                                                                            <i data-lucide="code-2"
                                                                                class="w-3 h-3 text-primary"></i>
                                                                            <%= c.problems %> problems
                                                                        </span>
                                                                        <span class="flex items-center gap-1.5 ml-auto">
                                                                            <i data-lucide="clock"
                                                                                class="w-3 h-3 <%= c.status === 'upcoming' ? 'text-amber-400' : (c.status === 'active' ? 'text-emerald-400' : 'text-rose-400') %>"></i>
                                                                            <span
                                                                                class="<%= c.status === 'upcoming' ? 'text-amber-400 font-medium' : (c.status === 'active' ? 'text-emerald-400 font-medium' : '') %>">
                                                                                <%= c.status==='past' ? 'Finished' :
                                                                                    (c.status==='upcoming' ? 'Starts ' +
                                                                                    c.timeUntilStart : c.timeLeft
                                                                                    + ' left' ) %>
                                                                            </span>
                                                                        </span>
                                                                    </div>

                                                                    <!-- Action -->
                                                                    <div class="relative z-10 mt-auto">
                                                                        <% if (c.status==='past' ) { %>
                                                                            <div
                                                                                class="w-full py-1.5 rounded-lg bg-rose-500/8 text-rose-400 border border-rose-500/15 text-[11px] font-semibold flex items-center justify-center gap-1.5">
                                                                                <i data-lucide="lock"
                                                                                    class="w-3 h-3"></i>
                                                                                Contest Ended
                                                                            </div>
                                                                            <% } else { %>
                                                                                <div
                                                                                    class="join-btn w-full py-1.5 rounded-lg <%= c.status === 'active' ? 'bg-primary/15 text-primary border border-primary/20' : 'bg-amber-500/15 text-amber-400 border border-amber-500/20' %> text-[11px] font-semibold flex items-center justify-center gap-1.5">
                                                                                    <%= c.status==='active'
                                                                                        ? 'Enter Contest' : 'Register'
                                                                                        %>
                                                                                        <i data-lucide="chevron-right"
                                                                                            class="w-3 h-3 group-hover:translate-x-1 transition-transform"></i>
                                                                                </div>
                                                                                <% } %>
                                                                    </div>
                                                        </a>
                                                        <% }); %>
                                                </div>
                                            </div>
                                    </main>
                            </div>

                            <script>
                                function filterContests() {
                                    var search = document.getElementById('contest-search').value.toLowerCase();
                                    var filter = document.getElementById('contest-filter').value;
                                    var userId = localStorage.getItem('userId');

                                    document.querySelectorAll('#contests-grid .contest-card').forEach(function (card) {
                                        var title = card.getAttribute('data-title');
                                        var status = card.getAttribute('data-status');
                                        var participantsStr = card.getAttribute('data-participants');
                                        var participants = participantsStr ? JSON.parse(participantsStr) : [];

                                        var matchSearch = !search || title.includes(search);

                                        var matchFilter = true;
                                        if (filter === 'participated') {
                                            matchFilter = userId && participants.includes(userId);
                                        } else if (filter !== 'all') {
                                            matchFilter = status === filter;
                                        }

                                        card.style.display = matchSearch && matchFilter ? '' : 'none';
                                    });
                                }

                                // Run initial filter to hide non-active if 'active' is default selected
                                document.addEventListener('DOMContentLoaded', filterContests);

                                // Initialize Lucide icons
                                if (typeof lucide !== 'undefined') {
                                    lucide.createIcons();
                                }
                            </script>
                            <script src="/js/card-effects.js"></script>
    </body>

    </html>