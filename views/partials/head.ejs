<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>CodeWith?</title>
  <meta name="description" content="CodeWith? - Your coding companion platform" />
  <% if (locals.user && locals.user.settings) { %>
  <style>
    :root {
      <% if (locals.user.settings.fontScale === 'small') { %>
        font-size: 14px !important;
      <% } else if (locals.user.settings.fontScale === 'large') { %>
        font-size: 18px !important;
      <% } else { %>
        font-size: 16px !important;
      <% } %>
    }
  </style>
  <% } %>
  <% if (locals.user) { %>
  <script>
    if ('<%= locals.user.username %>' === 'guest_user') {
      sessionStorage.setItem('active_session', 'true');
    }
    const isFreshLogin = document.cookie.split(';').some(item => item.trim().startsWith('fresh_login='));
    if (isFreshLogin) {
      sessionStorage.setItem('active_session', 'true');
      document.cookie = "fresh_login=; expires=Thu, 01 Jan 1970 00:00:00 UTC; path=/;";
    }
    if (!sessionStorage.getItem('active_session')) {
      window.location.replace('/logout');
    } else {
      sessionStorage.setItem('active_session', 'true');
    }
  </script>
  <% } %>
  <link rel="stylesheet" href="/css/styles.css" />
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            background: 'hsl(var(--background))',
            foreground: 'hsl(var(--foreground))',
            card: { DEFAULT: 'hsl(var(--card))', foreground: 'hsl(var(--card-foreground))' },
            popover: { DEFAULT: 'hsl(var(--popover))', foreground: 'hsl(var(--popover-foreground))' },
            primary: { DEFAULT: 'hsl(var(--primary))', foreground: 'hsl(var(--primary-foreground))' },
            secondary: { DEFAULT: 'hsl(var(--secondary))', foreground: 'hsl(var(--secondary-foreground))' },
            muted: { DEFAULT: 'hsl(var(--muted))', foreground: 'hsl(var(--muted-foreground))' },
            accent: { DEFAULT: 'hsl(var(--accent))', foreground: 'hsl(var(--accent-foreground))' },
            destructive: { DEFAULT: 'hsl(var(--destructive))', foreground: 'hsl(var(--destructive-foreground))' },
            success: { DEFAULT: 'hsl(var(--success))', foreground: 'hsl(var(--success-foreground))' },
            warning: { DEFAULT: 'hsl(var(--warning))', foreground: 'hsl(var(--warning-foreground))' },
            border: 'hsl(var(--border))',
            input: 'hsl(var(--input))',
            ring: 'hsl(var(--ring))',
          },
          borderRadius: { lg: 'var(--radius)', md: 'calc(var(--radius) - 2px)', sm: 'calc(var(--radius) - 4px)' },
          fontFamily: { sans: ['Inter', 'sans-serif'], mono: ['JetBrains Mono', 'monospace'] },
        },
      },
    };
  </script>
  <script src="https://unpkg.com/lucide@latest/dist/umd/lucide.js"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/monaco-editor/0.44.0/min/vs/loader.min.js"></script>
  <script type="module" src="https://cdn.jsdelivr.net/npm/@hotwired/turbo@8.0.4/dist/turbo.es2017-umd.js"></script>
  <script>
    function initIcons() {
      if (typeof lucide !== 'undefined') {
        lucide.createIcons();
      }
    }

    document.addEventListener('turbo:load', initIcons);
    document.addEventListener('turbo:render', initIcons);
    document.addEventListener('DOMContentLoaded', initIcons);
    
    // Fallback for initial load
    setTimeout(initIcons, 100);
    setTimeout(initIcons, 500); 
      
      // Active timer intervals map to prevent duplicates
      window.activeInviteTimers = window.activeInviteTimers || {};

      // Global Invite Polling
      if (!window.globalInvitePoller) {
        window.globalInvitePoller = setInterval(async () => {
          try {
            const isGuest = window.location.search.includes('guest') ? '?guest=true' : '';
            const res = await fetch('/api/invites' + isGuest);
            if (!res.ok) return;
            const invites = await res.json();
            
            invites.forEach(invite => {
              // Ensure we don't show the same invite twice
              if (document.getElementById(`invite-toast-${invite.id}`)) return;
              
              const toast = document.createElement('div');
              toast.id = `invite-toast-${invite.id}`;
              toast.className = 'fixed top-20 md:top-6 right-4 md:right-6 z-[10000] w-80 bg-[#0f172a]/95 backdrop-blur-xl border border-white/10 rounded-2xl p-4 shadow-2xl flex flex-col gap-3 transform translate-x-full transition-transform duration-500 ease-out';
              
              // Trigger entrance animation
              setTimeout(() => { toast.classList.remove('translate-x-full'); }, 50);
              
              toast.innerHTML = `
                <div class="flex items-center gap-4">
                  <div class="relative w-10 h-10 shrink-0 flex items-center justify-center">
                    <!-- Circular Countdown Ring -->
                    <svg class="absolute inset-0 w-full h-full transform -rotate-90">
                      <!-- Background Circle -->
                      <circle cx="20" cy="20" r="16" stroke="rgba(255, 255, 255, 0.1)" stroke-width="3" fill="transparent" />
                      <!-- Animated Foreground Progress Circle -->
                      <circle id="timer-ring-${invite.id}" cx="20" cy="20" r="16" stroke="#3b82f6" stroke-width="3" fill="transparent" 
                              stroke-dasharray="100.53" stroke-dashoffset="0" stroke-linecap="round" style="transition: stroke-dashoffset 1s linear;" />
                    </svg>
                    <!-- Numeric Time text in center -->
                    <span id="timer-text-${invite.id}" class="text-xs font-black text-white relative z-10">7</span>
                  </div>
                  <div class="flex-1">
                    <p class="text-sm font-bold text-white"><span class="text-blue-400 capitalize">${invite.from}</span> invited you!</p>
                    <p class="text-[10px] font-mono text-slate-400 tracking-wider uppercase">${invite.roomName}</p>
                  </div>
                </div>
                <div class="flex gap-2 mt-1">
                  <button onclick="respondToInvite('${invite.id}', 'decline', this)" class="flex-1 py-2 rounded-xl text-xs font-bold text-slate-400 bg-white/5 hover:bg-white/10 transition-colors">Decline</button>
                  <button onclick="respondToInvite('${invite.id}', 'accept', this, '${invite.roomId}')" class="flex-1 py-2 rounded-xl text-[11px] uppercase tracking-widest font-black text-white bg-blue-600 hover:bg-blue-500 transition-colors shadow-lg shadow-blue-500/20">Accept & Join</button>
                </div>
              `;
              document.body.appendChild(toast);
              if (typeof lucide !== 'undefined') lucide.createIcons();

              // Start a 7-second countdown
              let timeLeft = 7;
              const circumference = 100.53;
              
              const timerInterval = setInterval(() => {
                timeLeft--;
                
                const timerText = document.getElementById(`timer-text-${invite.id}`);
                const timerRing = document.getElementById(`timer-ring-${invite.id}`);
                
                if (timerText) {
                  timerText.textContent = timeLeft;
                }
                
                if (timerRing) {
                  const offset = circumference - (timeLeft / 7) * circumference;
                  timerRing.style.strokeDashoffset = offset;
                }
                
                if (timeLeft <= 0) {
                  clearInterval(timerInterval);
                  window.respondToInvite(invite.id, 'decline', null, invite.roomId);
                }
              }, 1000);

              window.activeInviteTimers[invite.id] = timerInterval;
            });
          } catch(err) {
            console.error('Invite polling error', err);
          }
        }, 3000);
      }
      
      window.respondToInvite = async (inviteId, action, btnElem, roomId) => {
        try {
          // Clear any active countdown timers to prevent double triggers
          if (window.activeInviteTimers && window.activeInviteTimers[inviteId]) {
            clearInterval(window.activeInviteTimers[inviteId]);
            delete window.activeInviteTimers[inviteId];
          }

          const toast = document.getElementById(`invite-toast-${inviteId}`);
          if (toast) {
            toast.classList.add('translate-x-[120%]', 'opacity-0');
            setTimeout(() => toast.remove(), 300);
          }
          
          await fetch('/api/invites/respond', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ inviteId, action })
          });
          if (action === 'accept') {
            const isGuest = window.location.search.includes('guest') ? '?guest=true' : '';
            window.location.href = '/custom/room/' + roomId + isGuest;
          }
        } catch(err) {
            console.error('Error responding to invite', err);
        }
      };
  </script>
</head>
