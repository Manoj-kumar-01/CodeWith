<div class="flex items-center justify-between py-4 px-4 md:px-6 relative">
    <% if (typeof showShinyLine !== 'undefined' && showShinyLine) { %>
        <div class="absolute bottom-0 left-6 w-24 h-0.5 bg-gradient-to-r from-white/20 via-white/40 to-transparent"></div>
    <% } %>
    
        <div class="flex items-center gap-4">
            <%- include('logo') %>
            <% if (typeof title !== 'undefined' && title) { %>
                <div class="h-6 w-px bg-border/20 mx-2 hidden sm:block"></div>
                <h2 class="text-sm font-medium text-muted-foreground hidden sm:block uppercase tracking-wider"><%= title %></h2>
            <% } %>
        </div>
    
    <!-- Top Right Actions -->
    <div class="flex items-center gap-4">
        <% if (typeof extraActions !== 'undefined') { %>
            <%- extraActions %>
        <% } %>
        <% if (typeof showAddFriend !== 'undefined' ? showAddFriend : true) { %>
            <button onclick="window.location.href='/friends'" class="flex items-center gap-2 px-3 py-1.5 rounded-lg bg-primary/10 hover:bg-primary/20 border border-primary/20 text-sm font-medium text-primary transition-all shadow-lg shadow-primary/5 hover:shadow-primary/10">
                <i data-lucide="user-plus" class="w-4 h-4"></i>
                <span class="hidden sm:inline">Add Friend</span>
            </button>
        <% } %>
    </div>
</div>
