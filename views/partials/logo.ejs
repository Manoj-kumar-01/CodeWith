<div class="flex items-center gap-2.5">
    <!-- Logo Mark -->
    <div class="relative">
        <svg width="40" height="40" viewBox="0 0 40 40" fill="none" xmlns="http://www.w3.org/2000/svg"
            class="relative z-10">
            <circle cx="20" cy="20" r="18" fill="url(#logoBg)" />
            <circle cx="20" cy="20" r="17.5" stroke="url(#logoStroke)" stroke-width="1" />
            <rect x="10" y="14" width="3" height="12" rx="1" fill="url(#cursorGrad)" opacity="0.9">
                <animate attributeName="opacity" values="0.9;0.3;0.9" dur="1.2s" repeatCount="indefinite" />
            </rect>
            <rect x="15" y="15" width="14" height="2" rx="1" fill="#515f74" opacity="0.8" />
            <rect x="15" y="19.5" width="10" height="2" rx="1" fill="#777777" opacity="0.7" />
            <rect x="15" y="24" width="12" height="2" rx="1" fill="#9cacc5" opacity="0.6" />
            <circle cx="31" cy="12" r="1.5" fill="#505f76" opacity="0.7" />
            <defs>
                <linearGradient id="logoBg" x1="2" y1="2" x2="38" y2="38">
                    <stop offset="0%" stop-color="#2e3c50" />
                    <stop offset="100%" stop-color="#191c1e" />
                </linearGradient>
                <linearGradient id="logoStroke" x1="2" y1="2" x2="38" y2="38">
                    <stop offset="0%" stop-color="#515f74" stop-opacity="0.5" />
                    <stop offset="100%" stop-color="#9cacc5" stop-opacity="0.3" />
                </linearGradient>
                <linearGradient id="cursorGrad" x1="10" y1="14" x2="13" y2="26">
                    <stop offset="0%" stop-color="#515f74" />
                    <stop offset="100%" stop-color="#9cacc5" />
                </linearGradient>
            </defs>
        </svg>
        <div
            class="absolute inset-0 blur-lg opacity-15 bg-gradient-to-br from-[#2e3c50] to-[#515f74] rounded-full scale-110">
        </div>
    </div>
    <!-- Typography -->
    <div class="flex items-center tracking-tight">
        <span
            class="text-[22px] md:text-2xl font-extrabold text-[#2e3c50]">Code</span>
        <span class="text-[22px] md:text-2xl font-bold text-foreground/90">With</span>
        <span class="text-[22px] md:text-2xl font-extrabold text-[#515f74] ml-0.5 animate-pulse">?</span>
    </div>
</div>