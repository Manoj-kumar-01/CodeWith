<%- include('partials/head') %>

<body>
    <div class="fixed inset-0 w-screen h-screen overflow-hidden">
        <div class="absolute inset-0 z-0 bg-productive-grid"></div>

        <div class="relative z-10 w-screen h-screen">
            <div class="monitor-frame">
                <div class="monitor-bezel">
                    <div class="monitor-screen">
                        <div class="flex h-full relative">
                            <%- include('partials/sidebar') %>

                            <main class="flex-1 flex flex-col min-w-0 overflow-hidden relative">
                                <header class="border-b border-white/10 backdrop-blur-2xl bg-secondary/80 z-50 sticky top-0">
                                    <%- include('partials/top-bar', { title: 'CUSTOM ROOMS' }) %>
                                </header>

                                <div class="flex-1 overflow-y-auto scrollbar-thin p-4 md:p-8 space-y-6">
                                    <!-- Header Section -->
                                    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
                                        <div>
                                            <h1 class="text-3xl font-bold tracking-tight text-foreground">Custom Rooms</h1>
                                            <p class="text-muted-foreground mt-1 text-sm">Create or join private matches for competitive practice.</p>
                                        </div>
                                        <button onclick="openCreateModal()" 
                                            class="bg-primary text-primary-foreground px-6 py-3 rounded-xl font-semibold shadow-lg shadow-primary/20 hover:scale-[1.02] active:scale-[0.98] transition-all flex items-center gap-2">
                                            <i data-lucide="plus-circle" class="w-5 h-5"></i>
                                            Create Room
                                        </button>
                                    </div>

                                    <!-- Stats Grid -->
                                    <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                                        <div class="glass-card p-4 flex items-center gap-4 border-primary/20 bg-primary/5">
                                            <div class="w-10 h-10 rounded-lg bg-primary/10 flex items-center justify-center text-primary">
                                                <i data-lucide="users" class="w-5 h-5"></i>
                                            </div>
                                            <div>
                                                <p class="text-[10px] font-bold text-muted-foreground uppercase tracking-widest leading-none mb-1">Online</p>
                                                <p class="text-lg font-black leading-none">1,248</p>
                                            </div>
                                        </div>
                                        <div class="glass-card p-4 flex items-center gap-4 border-success/20 bg-success/5">
                                            <div class="w-10 h-10 rounded-lg bg-success/10 flex items-center justify-center text-success">
                                                <i data-lucide="swords" class="w-5 h-5"></i>
                                            </div>
                                            <div>
                                                <p class="text-[10px] font-bold text-muted-foreground uppercase tracking-widest leading-none mb-1">Active Rooms</p>
                                                <p class="text-lg font-black leading-none">42</p>
                                            </div>
                                        </div>
                                        <div class="glass-card p-4 flex items-center gap-4 border-warning/20 bg-warning/5">
                                            <div class="w-10 h-10 rounded-lg bg-warning/10 flex items-center justify-center text-warning">
                                                <i data-lucide="flame" class="w-5 h-5"></i>
                                            </div>
                                            <div>
                                                <p class="text-[10px] font-bold text-muted-foreground uppercase tracking-widest leading-none mb-1">Hot Battles</p>
                                                <p class="text-lg font-black leading-none">15</p>
                                            </div>
                                        </div>
                                    </div>

                                    <!-- Room List Section -->
                                    <div class="space-y-4">
                                        <div class="flex items-center justify-between border-b border-border/10 pb-2">
                                            <h2 class="text-xs font-black uppercase tracking-[0.2em] text-muted-foreground">Available Rooms</h2>
                                            <div class="flex items-center gap-2">
                                                <span class="text-[10px] font-bold text-muted-foreground mr-1">SORT BY</span>
                                                <select class="bg-transparent text-[11px] font-bold border-none focus:ring-0 cursor-pointer uppercase tracking-wider text-primary">
                                                    <option>Newest</option>
                                                    <option>Players</option>
                                                </select>
                                            </div>
                                        </div>

                                        <div class="grid grid-cols-1 lg:grid-cols-2 gap-4 pb-8">
                                            <% rooms.forEach(room => { %>
                                                <div class="glass-card p-5 group hover:border-primary/40 transition-all duration-300 relative overflow-hidden">
                                                    <div class="absolute top-0 right-0 w-24 h-24 bg-primary/5 rounded-full blur-2xl -translate-y-1/2 translate-x-1/2 group-hover:bg-primary/10 transition-colors"></div>
                                                    
                                                    <div class="relative z-10 flex items-start justify-between">
                                                        <div class="flex items-center gap-4">
                                                            <div class="w-12 h-12 rounded-xl bg-gradient-to-br from-[#2e3c50] to-[#515f74] flex items-center justify-center text-primary-foreground text-lg font-black shadow-lg">
                                                                <%= room.name.charAt(0) %>
                                                            </div>
                                                            <div>
                                                                <h3 class="font-bold text-foreground group-hover:text-primary transition-colors uppercase tracking-tight"><%= room.name %></h3>
                                                                <div class="flex items-center gap-2 text-[11px] text-muted-foreground font-medium mt-0.5">
                                                                    <span class="flex items-center gap-1">
                                                                        <i data-lucide="user" class="w-3 h-3"></i>
                                                                        <%= room.host %>
                                                                    </span>
                                                                    <span class="w-1 h-1 rounded-full bg-border/40"></span>
                                                                    <span class="flex items-center gap-1 uppercase tracking-tighter">
                                                                        <i data-lucide="map" class="w-3 h-3"></i>
                                                                        <%= room.map %>
                                                                    </span>
                                                                </div>
                                                            </div>
                                                        </div>
                                                        <div class="text-right">
                                                            <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full bg-primary/10 text-primary text-[9px] font-black uppercase tracking-widest border border-primary/20">
                                                                <%= room.size %>
                                                            </span>
                                                            <div class="mt-2 group-hover:scale-110 transition-transform origin-right">
                                                                <span class="text-sm font-black text-foreground"><%= room.players %></span>
                                                                <span class="text-[10px] font-bold text-muted-foreground uppercase opacity-60">/ <%= room.size.includes('6vs6') ? '12' : '8' %></span>
                                                            </div>
                                                        </div>
                                                    </div>

                                                    <div class="mt-6 flex items-center justify-between border-t border-border/10 pt-4 relative z-10">
                                                        <div class="flex -space-x-2">
                                                            <% for(let i=0; i<Math.min(3, room.players); i++) { %>
                                                                <div class="w-7 h-7 rounded-full bg-muted border-2 border-card flex items-center justify-center text-[10px] font-bold text-muted-foreground">P</div>
                                                            <% } %>
                                                            <% if(room.players > 3) { %>
                                                                <div class="w-7 h-7 rounded-full bg-secondary border-2 border-card flex items-center justify-center text-[9px] font-bold text-primary">+<%= room.players - 3 %></div>
                                                            <% } %>
                                                        </div>
                                                        <a href="/custom/room/<%= room.id %>" 
                                                            class="px-5 py-2 rounded-lg bg-secondary/80 hover:bg-primary hover:text-primary-foreground transition-all duration-300 font-black text-[11px] uppercase tracking-[0.15em]">
                                                            Join Battle
                                                        </a>
                                                    </div>
                                                </div>
                                            <% }) %>
                                        </div>
                                    </div>
                                </div>
                            </main>

                            <button data-friends-toggle onclick="toggleFriends()"
                                class="fixed bottom-4 right-4 md:bottom-6 md:right-6 z-[60] p-3 rounded-full bg-transparent hover:bg-primary/10 border border-primary/20 backdrop-blur-md transition-all duration-300 shadow-lg"
                                title="Toggle Friends">
                                <i data-lucide="users" class="w-5 h-5 text-primary"></i>
                            </button>

                            <aside id="friends-aside"
                                class="fixed top-0 right-0 h-full w-80 max-w-[85vw] z-50 animate-slide-in-right shadow-2xl hidden">
                                <%- include('partials/friends-panel', { friends: typeof friends !== 'undefined' ? friends : [] }) %>
                            </aside>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Create Room Modal (Improved) -->
    <div id="createModal" class="fixed inset-0 z-[100] hidden bg-background/80 backdrop-blur-sm flex items-center justify-center p-4">
        <div class="glass-card w-full max-w-lg p-6 md:p-8 animate-in zoom-in-95 duration-200 border-primary/30">
            <div class="flex items-center justify-between mb-8">
                <div>
                    <h2 class="text-2xl font-black uppercase tracking-tight">Create Custom Battle</h2>
                    <p class="text-xs font-bold text-muted-foreground tracking-widest uppercase mt-1">Host your own elite room</p>
                </div>
                <button onclick="closeCreateModal()" class="p-2 hover:bg-secondary rounded-lg transition-colors">
                    <i data-lucide="x" class="w-6 h-6"></i>
                </button>
            </div>

            <form action="/custom/room/101" method="GET" class="space-y-6">
                <div class="space-y-2">
                    <label class="text-[10px] font-black uppercase tracking-widest text-muted-foreground ml-1">Battle Name</label>
                    <input type="text" placeholder="e.g. Pro Coding Clash" 
                        class="w-full bg-secondary/30 border border-border/40 rounded-xl p-4 text-sm font-semibold focus:ring-2 focus:ring-primary/20 focus:border-primary transition-all outline-none">
                </div>

                <div class="grid grid-cols-2 gap-4">
                    <div class="space-y-2">
                        <label class="text-[10px] font-black uppercase tracking-widest text-muted-foreground ml-1">Team Format</label>
                        <select class="w-full bg-secondary/30 border border-border/40 rounded-xl p-4 text-sm font-bold focus:ring-2 focus:ring-primary/20 focus:border-primary transition-all outline-none appearance-none">
                            <option>6vs6 Battle</option>
                            <option>4vs4 Squad</option>
                            <option>2vs2 Duo</option>
                            <option>1vs1 Duel</option>
                        </select>
                    </div>
                    <div class="space-y-2">
                        <label class="text-[10px] font-black uppercase tracking-widest text-muted-foreground ml-1">Environment</label>
                        <select class="w-full bg-secondary/30 border border-border/40 rounded-xl p-4 text-sm font-bold focus:ring-2 focus:ring-primary/20 focus:border-primary transition-all outline-none appearance-none">
                            <option>Bermuda (Easy)</option>
                            <option>Purgatory (Medium)</option>
                            <option>Kalahari (Hard)</option>
                        </select>
                    </div>
                </div>

                <div class="space-y-2">
                    <label class="text-[10px] font-black uppercase tracking-widest text-muted-foreground ml-1">Security Code (Optional)</label>
                    <div class="relative">
                        <input type="password" placeholder="Leave empty for public" 
                            class="w-full bg-secondary/30 border border-border/40 rounded-xl p-4 pr-12 text-sm font-semibold focus:ring-2 focus:ring-primary/20 focus:border-primary transition-all outline-none">
                        <i data-lucide="lock" class="absolute right-4 top-1/2 -translate-y-1/2 w-4 h-4 text-muted-foreground/50"></i>
                    </div>
                </div>

                <div class="pt-6 flex gap-3">
                    <button type="button" onclick="closeCreateModal()" class="flex-1 px-6 py-4 rounded-xl font-bold uppercase tracking-widest text-xs hover:bg-secondary transition-all">Cancel</button>
                    <button type="submit" class="flex-1 px-6 py-4 rounded-xl bg-primary text-primary-foreground font-black italic uppercase tracking-[0.2em] text-xs shadow-xl shadow-primary/20 hover:opacity-90 transition-all">Establish Room</button>
                </div>
            </form>
        </div>
    </div>

    <script src="/js/friends-panel.js"></script>
    <script>
        function openCreateModal() { document.getElementById('createModal').classList.remove('hidden'); }
        function closeCreateModal() { document.getElementById('createModal').classList.add('hidden'); }
    </script>
</body>
</html>
