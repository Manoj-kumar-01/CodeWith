<%- include('partials/head') %>

<style>
    /* ── Custom Rooms Standalone — matches app light monochrome theme ── */
    .cr-page {
        min-height: 100vh;
        background-color: hsl(var(--background));
        background-image:
            linear-gradient(hsl(var(--primary) / 0.03) 1px, transparent 1px),
            linear-gradient(90deg, hsl(var(--primary) / 0.03) 1px, transparent 1px);
        background-size: 60px 60px;
        position: relative;
    }

    .cr-page::before {
        content: '';
        position: absolute;
        inset: 0;
        background: radial-gradient(ellipse 800px 500px at 30% 20%, hsl(var(--primary) / 0.04), transparent 60%),
                    radial-gradient(ellipse 500px 400px at 70% 80%, hsl(var(--accent) / 0.03), transparent 60%);
        pointer-events: none;
    }

    /* Top navigation */
    .cr-topbar {
        background: hsl(var(--card) / 0.8);
        backdrop-filter: blur(20px);
        -webkit-backdrop-filter: blur(20px);
        border-bottom: 1px solid hsl(var(--border) / 0.5);
        box-shadow: 0 1px 3px hsl(0 0% 0% / 0.03);
    }

    /* Stat cards */
    .cr-stat-card {
        background: hsl(var(--card) / 0.7);
        backdrop-filter: blur(12px);
        border: 1px solid hsl(var(--border) / 0.5);
        border-radius: var(--radius);
        padding: 1.25rem 1.5rem;
        transition: all 0.25s ease;
        box-shadow: 0 2px 8px hsl(0 0% 0% / 0.03);
    }

    .cr-stat-card:hover {
        box-shadow: 0 8px 20px hsl(0 0% 0% / 0.06);
        transform: translateY(-2px);
    }

    /* Room cards */
    .cr-room {
        background: hsl(var(--card) / 0.75);
        backdrop-filter: blur(12px);
        border: 1px solid hsl(var(--border) / 0.5);
        border-radius: 1rem;
        padding: 1.5rem;
        transition: all 0.3s ease;
        cursor: pointer;
        position: relative;
        overflow: hidden;
    }

    .cr-room:hover {
        border-color: hsl(var(--primary) / 0.25);
        box-shadow: 0 12px 30px hsl(0 0% 0% / 0.07), var(--glow-primary);
        transform: translateY(-3px);
    }

    .cr-room::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        height: 3px;
        background: var(--gradient-primary);
        opacity: 0;
        transition: opacity 0.3s;
    }

    .cr-room:hover::before {
        opacity: 1;
    }

    /* Format badges */
    .cr-badge {
        font-size: 9px;
        font-weight: 800;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        padding: 0.25rem 0.625rem;
        border-radius: 0.5rem;
    }

    .cr-badge-6v6 { background: hsl(var(--primary) / 0.08); color: hsl(var(--primary)); border: 1px solid hsl(var(--primary) / 0.15); }
    .cr-badge-4v4 { background: hsl(270 60% 50% / 0.08); color: hsl(270 60% 45%); border: 1px solid hsl(270 60% 50% / 0.15); }
    .cr-badge-2v2 { background: hsl(var(--warning) / 0.08); color: hsl(var(--warning)); border: 1px solid hsl(var(--warning) / 0.15); }
    .cr-badge-1v1 { background: hsl(var(--destructive) / 0.08); color: hsl(var(--destructive)); border: 1px solid hsl(var(--destructive) / 0.15); }

    /* Progress bar */
    .cr-progress-track {
        height: 4px;
        background: hsl(var(--muted));
        border-radius: 999px;
        overflow: hidden;
    }

    .cr-progress-fill {
        height: 100%;
        border-radius: 999px;
        transition: width 0.5s ease;
    }

    /* Create button */
    .cr-create-btn {
        background: var(--gradient-primary);
        color: hsl(var(--primary-foreground));
        border: none;
        border-radius: var(--radius);
        padding: 0.625rem 1.5rem;
        font-weight: 700;
        font-size: 0.8rem;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        cursor: pointer;
        transition: all 0.25s ease;
        box-shadow: 0 4px 15px hsl(var(--primary) / 0.15);
    }

    .cr-create-btn:hover {
        transform: translateY(-1px);
        box-shadow: 0 8px 25px hsl(var(--primary) / 0.25);
    }

    .cr-create-btn:active { transform: scale(0.97); }

    /* Empty state */
    .cr-empty-icon {
        width: 80px;
        height: 80px;
        border-radius: 1.5rem;
        background: hsl(var(--muted) / 0.5);
        border: 2px dashed hsl(var(--border));
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 1.25rem;
    }

    /* Modal overlay */
    .cr-modal-overlay {
        background: hsl(var(--background) / 0.7);
        backdrop-filter: blur(8px);
    }

    .cr-modal-card {
        background: hsl(var(--card));
        border: 1px solid hsl(var(--border) / 0.6);
        border-radius: 1.25rem;
        box-shadow: 0 25px 60px hsl(0 0% 0% / 0.1), 0 0 0 1px hsl(var(--border) / 0.3);
    }

    .cr-input {
        width: 100%;
        background: hsl(var(--muted) / 0.3);
        border: 1px solid hsl(var(--border) / 0.6);
        border-radius: var(--radius);
        padding: 0.75rem 1rem;
        font-size: 0.875rem;
        font-weight: 500;
        color: hsl(var(--foreground));
        outline: none;
        transition: all 0.2s;
    }

    .cr-input:focus {
        border-color: hsl(var(--primary) / 0.4);
        box-shadow: 0 0 0 3px hsl(var(--primary) / 0.08);
    }

    .cr-input::placeholder { color: hsl(var(--muted-foreground) / 0.5); }

    /* Animations */
    @keyframes cr-fade-up {
        from { opacity: 0; transform: translateY(16px); }
        to { opacity: 1; transform: translateY(0); }
    }

    .cr-anim { animation: cr-fade-up 0.4s ease-out both; }
    .cr-d1 { animation-delay: 0.05s; }
    .cr-d2 { animation-delay: 0.1s; }
    .cr-d3 { animation-delay: 0.15s; }
    .cr-d4 { animation-delay: 0.2s; }
</style>

<body class="cr-page">
    <!-- Navigation -->
    <nav class="cr-topbar sticky top-0 z-50">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex items-center justify-between h-14">
                <!-- Left: Back + Branding -->
                <div class="flex items-center gap-3">
                    <a href="/" class="flex items-center gap-1.5 text-muted-foreground hover:text-foreground transition-colors group" style="text-decoration: none;">
                        <i data-lucide="arrow-left" class="w-4 h-4 group-hover:-translate-x-0.5 transition-transform"></i>
                        <span class="text-[10px] font-semibold uppercase tracking-widest hidden sm:inline">Dashboard</span>
                    </a>
                    <div class="w-px h-5 bg-border/40"></div>
                    <div class="flex items-center gap-2">
                        <div class="w-7 h-7 rounded-lg bg-primary/10 flex items-center justify-center">
                            <i data-lucide="swords" class="w-3.5 h-3.5 text-primary"></i>
                        </div>
                        <div>
                            <h1 class="text-xs font-bold text-foreground uppercase tracking-wider leading-none">Custom Rooms</h1>
                            <p class="text-[8px] text-muted-foreground font-medium uppercase tracking-[0.2em]">Battle Arena</p>
                        </div>
                    </div>
                </div>

                <!-- Right: Actions -->
                <div class="flex items-center gap-3">
                    <div class="hidden sm:flex items-center gap-1.5 text-[10px] text-muted-foreground/60 font-medium tracking-wider">
                        <div class="w-1.5 h-1.5 rounded-full bg-success animate-pulse"></div>
                        LIVE
                    </div>
                    <button onclick="openCreateModal()" class="cr-create-btn flex items-center gap-2">
                        <i data-lucide="plus" class="w-3.5 h-3.5"></i>
                        <span>Create Room</span>
                    </button>
                </div>
            </div>
        </div>
    </nav>

    <!-- Main Content -->
    <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pb-16">
        <!-- Stats Row -->
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 mt-6 mb-8 cr-anim cr-d1">
            <div class="cr-stat-card flex items-center gap-3">
                <div class="w-10 h-10 rounded-xl bg-primary/8 flex items-center justify-center">
                    <i data-lucide="users" class="w-5 h-5 text-primary"></i>
                </div>
                <div>
                    <p class="text-[9px] font-bold text-muted-foreground uppercase tracking-[0.15em] mb-0.5">Players Online</p>
                    <p class="text-xl font-black text-foreground leading-none tabular-nums">
                        <%= typeof totalOnline !== 'undefined' ? totalOnline : 0 %>
                    </p>
                </div>
            </div>

            <div class="cr-stat-card flex items-center gap-3">
                <div class="w-10 h-10 rounded-xl bg-success/8 flex items-center justify-center">
                    <i data-lucide="swords" class="w-5 h-5 text-success"></i>
                </div>
                <div>
                    <p class="text-[9px] font-bold text-muted-foreground uppercase tracking-[0.15em] mb-0.5">Active Rooms</p>
                    <p class="text-xl font-black text-foreground leading-none tabular-nums">
                        <%= rooms ? rooms.length : 0 %>
                    </p>
                </div>
            </div>

            <div class="cr-stat-card flex items-center gap-3">
                <div class="w-10 h-10 rounded-xl bg-warning/8 flex items-center justify-center">
                    <i data-lucide="flame" class="w-5 h-5 text-warning"></i>
                </div>
                <div>
                    <p class="text-[9px] font-bold text-muted-foreground uppercase tracking-[0.15em] mb-0.5">Hot Battles</p>
                    <p class="text-xl font-black text-foreground leading-none tabular-nums">
                        <%= typeof hotBattles !== 'undefined' ? hotBattles : 0 %>
                    </p>
                </div>
            </div>
        </div>

        <!-- Section Header -->
        <div class="flex items-center justify-between mb-5 cr-anim cr-d2">
            <h2 class="section-title">Available Rooms</h2>
            <select class="cr-input" style="width: auto; padding: 0.375rem 0.75rem; font-size: 10px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.1em;">
                <option>Newest</option>
                <option>Players</option>
                <option>Format</option>
            </select>
        </div>

        <!-- Room Cards Grid -->
        <% if (rooms && rooms.length > 0) { %>
            <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-5">
                <% rooms.forEach((room, idx) => {
                    const sizeNum = parseInt(room.size.charAt(0)) || 6;
                    const maxPlayers = sizeNum * 2;
                    const fillPercent = Math.round((room.players / maxPlayers) * 100);
                    const badgeClass = sizeNum >= 6 ? 'cr-badge-6v6' : sizeNum >= 4 ? 'cr-badge-4v4' : sizeNum >= 2 ? 'cr-badge-2v2' : 'cr-badge-1v1';
                    const barColor = fillPercent > 75 ? 'bg-gradient-to-r from-warning to-destructive' : fillPercent > 40 ? 'bg-gradient-to-r from-primary to-accent' : 'bg-gradient-to-r from-success to-primary';
                %>
                    <div class="cr-room cr-anim" style="animation-delay: <%= 0.1 + idx * 0.06 %>s;"
                         onclick="window.location.href='/custom/room/<%= room.id %>'">
                        <!-- Top: Name + Badge -->
                        <div class="flex items-start justify-between mb-3">
                            <div class="flex items-center gap-3 flex-1 min-w-0">
                                <div class="w-10 h-10 rounded-xl flex items-center justify-center text-sm font-black flex-shrink-0 border border-primary/15" style="background: var(--gradient-primary); color: hsl(var(--primary-foreground));">
                                    <%= room.name.charAt(0).toUpperCase() %>
                                </div>
                                <div class="min-w-0">
                                    <h3 class="font-bold text-foreground text-sm truncate leading-tight"><%= room.name %></h3>
                                    <div class="flex items-center gap-1.5 mt-0.5">
                                        <i data-lucide="user" class="w-3 h-3 text-muted-foreground/50"></i>
                                        <span class="text-[11px] text-muted-foreground font-medium"><%= room.host %></span>
                                    </div>
                                </div>
                            </div>
                            <span class="cr-badge <%= badgeClass %> flex-shrink-0"><%= room.size %></span>
                        </div>

                        <!-- Middle: Map + Progress -->
                        <div class="mb-4">
                            <div class="flex items-center justify-between text-[10px] mb-1.5">
                                <span class="text-muted-foreground font-medium flex items-center gap-1">
                                    <i data-lucide="map-pin" class="w-3 h-3"></i>
                                    <%= room.map %>
                                </span>
                                <span class="text-foreground font-bold tabular-nums">
                                    <%= room.players %>/<%= maxPlayers %>
                                </span>
                            </div>
                            <div class="cr-progress-track">
                                <div class="cr-progress-fill <%= barColor %>" style="width: <%= fillPercent %>%"></div>
                            </div>
                        </div>

                        <!-- Bottom: Avatars + Join -->
                        <div class="flex items-center justify-between pt-3 border-t border-border/30">
                            <div class="flex -space-x-2">
                                <% for(let i=0; i<Math.min(4, room.players); i++) { %>
                                    <div class="w-6 h-6 rounded-full bg-muted border-2 border-card flex items-center justify-center text-[9px] font-bold text-muted-foreground">P</div>
                                <% } %>
                                <% if(room.players > 4) { %>
                                    <div class="w-6 h-6 rounded-full bg-primary/10 border-2 border-card flex items-center justify-center text-[8px] font-bold text-primary">+<%= room.players - 4 %></div>
                                <% } %>
                            </div>
                            <div class="flex items-center gap-2">
                                <% if (room.password) { %>
                                    <i data-lucide="lock" class="w-3.5 h-3.5 text-muted-foreground/60 mr-0.5 animate-pulse" title="Password Protected"></i>
                                <% } %>
                                <span class="flex items-center gap-1 text-[9px] text-success font-semibold">
                                    <div class="w-1.5 h-1.5 rounded-full bg-success animate-pulse"></div>
                                    Live
                                </span>
                                <span class="px-4 py-1.5 rounded-lg text-[10px] font-bold text-primary uppercase tracking-wider transition-all border border-primary/20 bg-primary/5 hover:bg-primary hover:text-primary-foreground">
                                    Join
                                </span>
                            </div>
                        </div>
                    </div>
                <% }) %>
            </div>
        <% } else { %>
            <!-- Empty State -->
            <div class="text-center py-20 cr-anim cr-d3">
                <div class="cr-empty-icon">
                    <i data-lucide="swords" class="w-8 h-8 text-muted-foreground/30"></i>
                </div>
                <h3 class="text-lg font-bold text-foreground/50 mb-2">No Active Rooms</h3>
                <p class="text-sm text-muted-foreground max-w-sm mx-auto mb-6">
                    The battle arena is empty. Create a room and invite your friends for a coding showdown.
                </p>
                <button onclick="openCreateModal()" class="cr-create-btn inline-flex items-center gap-2">
                    <i data-lucide="plus" class="w-4 h-4"></i>
                    Create First Room
                </button>
            </div>
        <% } %>
    </div>

    <!-- Create Room Modal -->
    <div id="createModal" class="fixed inset-0 z-[100] hidden items-center justify-center p-4 cr-modal-overlay">
        <div class="cr-modal-card w-full max-w-lg p-6 md:p-8 relative">
            <div class="flex items-center justify-between mb-6">
                <div>
                    <h2 class="text-lg font-black text-foreground uppercase tracking-tight">Create Custom Battle</h2>
                    <p class="text-[10px] font-semibold text-muted-foreground tracking-[0.15em] uppercase mt-0.5">Host your own elite room</p>
                </div>
                <button onclick="closeCreateModal()" class="p-2 hover:bg-muted rounded-lg transition-colors text-muted-foreground hover:text-foreground">
                    <i data-lucide="x" class="w-5 h-5"></i>
                </button>
            </div>

            <form action="/custom/create" method="POST" class="space-y-4" onsubmit="document.getElementById('establish-btn').disabled=true; document.getElementById('establish-btn').innerHTML='Creating...';">
                <div class="space-y-1.5">
                    <label class="text-[9px] font-bold uppercase tracking-[0.15em] text-muted-foreground ml-0.5">Battle Name</label>
                    <input type="text" name="roomName" placeholder="e.g. Pro Coding Clash" required class="cr-input">
                </div>

                <div class="grid grid-cols-2 gap-3">
                    <div class="space-y-1.5">
                        <label class="text-[9px] font-bold uppercase tracking-[0.15em] text-muted-foreground ml-0.5">Team Format</label>
                        <select name="teamFormat" class="cr-input appearance-none cursor-pointer">
                            <option>6vs6 Battle</option>
                            <option>4vs4 Squad</option>
                            <option>2vs2 Duo</option>
                            <option>1vs1 Duel</option>
                        </select>
                    </div>
                    <div class="space-y-1.5">
                        <label class="text-[9px] font-bold uppercase tracking-[0.15em] text-muted-foreground ml-0.5">Environment</label>
                        <select name="environment" class="cr-input appearance-none cursor-pointer">
                            <option>Bermuda (Easy)</option>
                            <option>Purgatory (Medium)</option>
                            <option>Kalahari (Hard)</option>
                        </select>
                    </div>
                </div>

                <div class="space-y-1.5">
                    <label class="text-[9px] font-bold uppercase tracking-[0.15em] text-muted-foreground ml-0.5">Security Code (Optional)</label>
                    <div class="relative">
                        <input type="password" name="password" placeholder="Leave empty for public" class="cr-input" style="padding-right: 2.5rem;">
                        <i data-lucide="lock" class="absolute right-3 top-1/2 -translate-y-1/2 w-4 h-4 text-muted-foreground/30"></i>
                    </div>
                </div>

                <div class="pt-3 flex gap-3">
                    <button type="button" onclick="closeCreateModal()"
                        class="flex-1 px-5 py-3 rounded-xl font-bold uppercase tracking-widest text-xs text-muted-foreground hover:bg-muted transition-all border border-border/50">
                        Cancel
                    </button>
                    <button type="submit" id="establish-btn"
                        class="flex-1 px-5 py-3 rounded-xl font-black italic uppercase tracking-[0.15em] text-xs transition-all"
                        style="background: var(--gradient-primary); color: hsl(var(--primary-foreground)); box-shadow: 0 4px 15px hsl(var(--primary) / 0.2);">
                        Establish Room
                    </button>
                </div>
            </form>
        </div>
    </div>

    <script>
        function openCreateModal() {
            const modal = document.getElementById('createModal');
            modal.classList.remove('hidden');
            modal.style.display = 'flex';
        }
        function closeCreateModal() {
            const modal = document.getElementById('createModal');
            modal.classList.add('hidden');
            modal.style.display = 'none';
        }
    </script>
</body>
</html>
