<%- include('partials/head') %>

    <body>
        <div class="min-h-screen bg-background">
            <div class="fixed inset-0 bg-gradient-to-br from-primary/5 via-background to-accent/5"></div>
            <div class="fixed inset-0 opacity-30">
                <div
                    class="absolute inset-0 bg-[radial-gradient(ellipse_at_top,_var(--tw-gradient-stops))] from-primary/20 via-transparent to-transparent">
                </div>
            </div>

            <div class="relative z-10 min-h-screen">
                <header class="border-b border-border/30 backdrop-blur-sm bg-background/50 sticky top-0 z-20">
                    <div class="container mx-auto px-4 py-4 flex items-center gap-4">
                        <a href="/" class="p-2 rounded-lg hover:bg-secondary/50 transition-colors">
                            <i data-lucide="chevron-left" class="w-5 h-5 text-muted-foreground"></i>
                        </a>
                        <%- include('partials/logo') %>
                    </div>
                </header>

                <div class="container mx-auto px-4 py-8">
                    <div class="mb-8">
                        <h1 class="text-2xl md:text-3xl font-bold text-foreground mb-2 flex items-center gap-3">
                            <i data-lucide="book-open" class="w-7 h-7 md:w-8 md:h-8 text-primary"></i>
                            Practice Problems
                        </h1>
                        <p class="text-muted-foreground">Master coding skills with curated problem sets</p>
                    </div>

                    <!-- Progress Stats -->
                    <div class="grid grid-cols-2 lg:grid-cols-4 gap-3 md:gap-4 mb-8">
                        <div class="glass-card p-3 md:p-4">
                            <div class="flex items-center gap-3">
                                <div
                                    class="w-10 h-10 md:w-12 md:h-12 rounded-xl bg-primary/20 flex items-center justify-center flex-shrink-0">
                                    <i data-lucide="target" class="w-5 h-5 md:w-6 md:h-6 text-primary"></i>
                                </div>
                                <div>
                                    <div class="text-xl md:text-2xl font-bold text-foreground">6/12</div>
                                    <div class="text-[10px] md:text-xs text-muted-foreground">Problems Solved</div>
                                </div>
                            </div>
                        </div>
                        <div class="glass-card p-3 md:p-4">
                            <div class="flex items-center gap-3">
                                <div
                                    class="w-10 h-10 md:w-12 md:h-12 rounded-xl bg-success/20 flex items-center justify-center flex-shrink-0">
                                    <i data-lucide="flame" class="w-5 h-5 md:w-6 md:h-6 text-success"></i>
                                </div>
                                <div>
                                    <div class="text-xl md:text-2xl font-bold text-foreground">15</div>
                                    <div class="text-[10px] md:text-xs text-muted-foreground">Day Streak</div>
                                </div>
                            </div>
                        </div>
                        <div class="glass-card p-3 md:p-4">
                            <div class="flex items-center gap-3">
                                <div
                                    class="w-10 h-10 md:w-12 md:h-12 rounded-xl bg-warning/20 flex items-center justify-center flex-shrink-0">
                                    <i data-lucide="clock" class="w-5 h-5 md:w-6 md:h-6 text-warning"></i>
                                </div>
                                <div>
                                    <div class="text-xl md:text-2xl font-bold text-foreground">42h</div>
                                    <div class="text-[10px] md:text-xs text-muted-foreground">Total Time</div>
                                </div>
                            </div>
                        </div>
                        <div class="glass-card p-3 md:p-4">
                            <div class="flex items-center gap-3">
                                <div
                                    class="w-10 h-10 md:w-12 md:h-12 rounded-xl bg-accent/20 flex items-center justify-center flex-shrink-0">
                                    <i data-lucide="code" class="w-5 h-5 md:w-6 md:h-6 text-accent"></i>
                                </div>
                                <div>
                                    <div class="text-xl md:text-2xl font-bold text-foreground">1,247</div>
                                    <div class="text-[10px] md:text-xs text-muted-foreground">Submissions</div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Categories -->
                    <section class="mb-8">
                        <h2 class="section-title mb-4">CATEGORIES</h2>
                        <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-3">
                            <% categories.forEach(function(cat) { var pct=Math.round((cat.solved / cat.count) * 100); %>
                                <button
                                    class="glass-card p-3 md:p-4 text-left transition-all hover:border-primary/50 category-btn"
                                    data-cat="<%= cat.name %>" onclick="toggleCategory(this)">
                                    <div class="flex items-center gap-2 md:gap-3 mb-2">
                                        <span class="text-xl md:text-2xl">
                                            <%= cat.icon %>
                                        </span>
                                        <span class="text-sm md:text-base font-medium text-foreground truncate">
                                            <%= cat.name %>
                                        </span>
                                    </div>
                                    <div class="flex justify-between text-xs md:text-sm">
                                        <span class="text-muted-foreground">
                                            <%= cat.count %> problems
                                        </span>
                                        <span class="text-success">
                                            <%= cat.solved %> solved
                                        </span>
                                    </div>
                                    <div class="mt-2 h-1.5 bg-secondary rounded-full overflow-hidden">
                                        <div class="h-full bg-primary rounded-full" style="width:<%= pct %>%"></div>
                                    </div>
                                </button>
                                <% }); %>
                        </div>
                    </section>

                    <!-- Filters -->
                    <div
                        class="glass-card p-3 md:p-4 mb-6 flex flex-col sm:flex-row items-stretch sm:items-center gap-3 md:gap-4">
                        <div class="flex items-center gap-2 flex-1 min-w-0">
                            <i data-lucide="search" class="w-5 h-5 text-muted-foreground flex-shrink-0"></i>
                            <input type="text" id="prob-search" placeholder="Search problems..."
                                class="bg-transparent border-none outline-none text-foreground placeholder:text-muted-foreground flex-1 min-w-0"
                                oninput="filterProblems()" />
                        </div>
                        <div class="flex items-center gap-2">
                            <i data-lucide="filter" class="w-4 h-4 text-muted-foreground"></i>
                            <select id="diff-filter"
                                class="bg-secondary text-foreground px-3 py-2 rounded-lg border border-border/30 outline-none flex-1 sm:flex-initial"
                                onchange="filterProblems()">
                                <option value="all">All Difficulties</option>
                                <option value="easy">Easy</option>
                                <option value="medium">Medium</option>
                                <option value="hard">Hard</option>
                            </select>
                        </div>
                    </div>

                    <!-- Problems List -->
                    <section>
                        <h2 class="section-title mb-4" id="prob-count">PROBLEMS (<%= problems.length %>)</h2>
                        <div class="flex flex-col gap-2" id="problems-list">
                            <% var diffClr={ easy:"text-success", medium:"text-warning", hard:"text-destructive" };
                                problems.forEach(function(p, index) { %>
                                <a href="/problem/<%= p._id %>"
                                    class="problem-row flex items-center gap-2 md:gap-4 p-3 md:p-4 rounded-lg bg-card/50 hover:bg-card transition-all border border-transparent hover:border-primary/30 group cursor-pointer no-underline"
                                    data-title="<%= p.title.toLowerCase() %>" data-diff="<%= p.difficulty %>"
                                    data-cat="<%= p.category %>" style="text-decoration:none;color:inherit">
                                    <div class="w-6 md:w-8 flex justify-center flex-shrink-0">
                                        <% if (p.solved) { %>
                                            <i data-lucide="check-circle-2"
                                                class="w-4 h-4 md:w-5 md:h-5 text-success"></i>
                                            <% } else { %>
                                                <div
                                                    class="w-4 h-4 md:w-5 md:h-5 rounded-full border-2 border-muted-foreground/30">
                                                </div>
                                                <% } %>
                                    </div>
                                    <div class="flex-1 min-w-0">
                                        <h4
                                            class="text-sm md:text-base font-medium text-foreground group-hover:text-primary transition-colors truncate">
                                            <%= index + 1 %>. <%= p.title %>
                                        </h4>
                                        <div
                                            class="flex items-center gap-2 md:gap-3 text-[10px] md:text-xs text-muted-foreground mt-1">
                                            <span class="truncate">
                                                <%= p.category %>
                                            </span>
                                            <span class="hidden sm:inline">&bull;</span>
                                            <span class="hidden sm:inline">
                                                <%= p.stats ? p.stats.acceptance : '45%' %> acceptance
                                            </span>
                                        </div>
                                    </div>
                                    <div class="hidden sm:flex items-center gap-2 text-sm text-muted-foreground">
                                        <i data-lucide="star" class="w-4 h-4"></i>
                                        <span>
                                            <%= p.stats ? (p.stats.likes || 0).toLocaleString() : '0' %>
                                        </span>
                                    </div>
                                    <span
                                        class="px-2 md:px-3 py-1 rounded-full text-[10px] md:text-xs font-bold capitalize flex-shrink-0 <%= diffClr[p.difficulty] %>">
                                        <%= p.difficulty %>
                                    </span>
                                </a>
                                <% }); %>
                        </div>
                    </section>
                </div>
            </div>
        </div>

        <script>
            var selectedCategory = null;

            function toggleCategory(btn) {
                var cat = btn.getAttribute('data-cat');
                if (selectedCategory === cat) {
                    selectedCategory = null;
                    btn.classList.remove('border-primary', 'bg-primary/10');
                } else {
                    document.querySelectorAll('.category-btn').forEach(function (b) { b.classList.remove('border-primary', 'bg-primary/10'); });
                    selectedCategory = cat;
                    btn.classList.add('border-primary', 'bg-primary/10');
                }
                filterProblems();
            }

            function filterProblems() {
                var search = document.getElementById('prob-search').value.toLowerCase();
                var diff = document.getElementById('diff-filter').value;
                var count = 0;
                document.querySelectorAll('.problem-row').forEach(function (row) {
                    var title = row.getAttribute('data-title');
                    var d = row.getAttribute('data-diff');
                    var cat = row.getAttribute('data-cat');
                    var show = (!search || title.includes(search)) && (diff === 'all' || d === diff) && (!selectedCategory || cat === selectedCategory);
                    row.style.display = show ? '' : 'none';
                    if (show) count++;
                });
                document.getElementById('prob-count').textContent = 'PROBLEMS (' + count + ')';
            }

            lucide.createIcons();
        </script>
    </body>

    </html>