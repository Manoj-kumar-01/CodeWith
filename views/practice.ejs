<%- include('partials/head') %>

    <body class="min-h-screen bg-background text-foreground selection:bg-primary/30 selection:text-primary-foreground overflow-hidden">
        <div class="fixed inset-0 w-screen h-screen overflow-hidden">
            <!-- Clean Background -->
            <div class="absolute inset-0 z-0 bg-background" id="bg-container"></div>

            <div class="relative z-10 w-screen h-screen">
                <div class="flex h-full relative">
                    <!-- Sticky Sidebar -->
                    <%- include('partials/sidebar') %>

                    <!-- Main Content -->
                    <main class="flex-1 flex flex-col min-w-0 overflow-hidden relative">
                        <div class="relative z-10 flex flex-col h-full overflow-hidden">
                            <!-- Header (Global Glassy) -->
                            <header class="border-b border-white/10 backdrop-blur-2xl bg-secondary/80 z-50 sticky top-0 transition-all duration-300">
                                <%- include('partials/top-bar', { showShinyLine: false, title: 'Practice' }) %>
                            </header>

                            <!-- Scrollable Content -->
                            <div class="flex-1 overflow-y-auto scrollbar-thin px-4 md:px-6 pb-6 mt-6">
                                <div class="mb-8">
                                    <h1 class="text-2xl md:text-3xl font-bold text-foreground mb-2">
                                        Practice Problems
                                    </h1>
                                    <p class="text-muted-foreground">Master coding skills with curated problem sets</p>
                                </div>

                                <!-- Progress Stats -->
                                <div class="grid grid-cols-2 lg:grid-cols-4 gap-3 md:gap-4 mb-8">
                                    <div class="glass-card p-4 hover:border-primary/30 transition-all group">
                                        <div class="flex items-center gap-3">
                                            <div class="flex items-center justify-center flex-shrink-0 group-hover:scale-110 transition-transform">
                                                <i data-lucide="target" class="w-6 h-6 text-primary"></i>
                                            </div>
                                            <div>
                                                <div class="text-xl md:text-2xl font-black text-foreground tabular-nums">
                                                    <%= typeof totalSolved !== 'undefined' ? totalSolved : 0 %> / <%= typeof totalProblems !== 'undefined' ? totalProblems : 0 %>
                                                </div>
                                                <div class="text-[10px] md:text-xs text-muted-foreground uppercase tracking-wider font-bold opacity-60">Global Solved Rank</div>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="glass-card p-4 hover:border-success/30 transition-all group">
                                        <div class="flex items-center gap-3">
                                            <div class="flex items-center justify-center flex-shrink-0 group-hover:scale-110 transition-transform">
                                                <i data-lucide="flame" class="w-6 h-6 text-success"></i>
                                            </div>
                                            <div>
                                                <div class="text-xl md:text-2xl font-black text-foreground tabular-nums"><%= (typeof userStats !== 'undefined' ? userStats.streak : 0) %></div>
                                                <div class="text-[10px] md:text-xs text-muted-foreground uppercase tracking-wider font-bold opacity-60">Day Streak</div>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="glass-card p-4 hover:border-warning/30 transition-all group">
                                        <div class="flex items-center gap-3">
                                            <div class="flex items-center justify-center flex-shrink-0 group-hover:scale-110 transition-transform">
                                                <i data-lucide="clock" class="w-6 h-6 text-warning"></i>
                                            </div>
                                            <div>
                                                <div class="text-xl md:text-2xl font-black text-foreground tabular-nums"><%= (typeof userStats !== 'undefined' ? userStats.time : '0h') %></div>
                                                <div class="text-[10px] md:text-xs text-muted-foreground uppercase tracking-wider font-bold opacity-60">Total Time</div>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="glass-card p-4 hover:border-accent/30 transition-all group">
                                        <div class="flex items-center gap-3">
                                            <div class="flex items-center justify-center flex-shrink-0 group-hover:scale-110 transition-transform">
                                                <i data-lucide="code" class="w-6 h-6 text-accent"></i>
                                            </div>
                                            <div>
                                                <div class="text-xl md:text-2xl font-black text-foreground tabular-nums"><%= (typeof userStats !== 'undefined' ? userStats.submissions.toLocaleString() : '0') %></div>
                                                <div class="text-[10px] md:text-xs text-muted-foreground uppercase tracking-wider font-bold opacity-60">Submissions</div>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <!-- Categories -->
                                <section class="mb-8">
                                    <h2 class="section-title mb-4">CATEGORIES</h2>
                                    <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-3">
                                        <% categories.forEach(function(cat) { var pct=Math.round((cat.solved / cat.count) * 100); %>
                                            <button class="glass-card p-5 text-left transition-all hover:border-primary/50 category-btn relative overflow-hidden group/cat bg-gradient-to-br from-primary/10 to-transparent"
                                                data-cat="<%= cat.name %>" onclick="toggleCategory(this)">
                                                <div class="absolute top-0 right-0 w-24 h-24 bg-primary/10 rounded-full blur-2xl -translate-y-1/2 translate-x-1/2 group-hover/cat:bg-primary/20 transition-colors"></div>
                                                <div class="relative z-10">
                                                    <div class="flex items-center gap-2 md:gap-3 mb-3">
                                                        <span class="text-xl md:text-2xl icon-box group-hover/cat:scale-110 transition-transform block"><%= cat.icon %></span>
                                                        <span class="text-sm md:text-base font-bold text-foreground truncate uppercase tracking-tight"><%= cat.name %></span>
                                                    </div>
                                                    <div class="flex justify-between text-[11px] font-bold uppercase tracking-wider">
                                                        <span class="text-muted-foreground opacity-60"><%= cat.count %> problems</span>
                                                        <span class="text-primary"><%= cat.solved %> solved</span>
                                                    </div>
                                                    <div class="mt-3 h-1.5 bg-white/5 rounded-full overflow-hidden border border-white/5">
                                                        <div class="h-full bg-primary rounded-full progress-glow" style="width: <%= pct %>%;"></div>
                                                    </div>
                                                </div>
                                            </button>
                                        <% }); %>
                                    </div>
                                </section>

                                <!-- Filters -->
                                <div class="glass-card p-3 md:p-4 mb-6 flex flex-col sm:flex-row items-stretch sm:items-center gap-3 md:gap-4">
                                    <div class="flex items-center gap-2 flex-1 min-w-0 px-2">
                                        <i data-lucide="search" class="w-5 h-5 text-muted-foreground flex-shrink-0"></i>
                                        <input type="text" id="prob-search" placeholder="Search problems..."
                                            class="bg-transparent border-none outline-none text-foreground placeholder:text-muted-foreground flex-1 min-w-0"
                                            oninput="filterProblems()" />
                                    </div>
                                    <div class="flex items-center gap-2">
                                        <i data-lucide="filter" class="w-4 h-4 text-muted-foreground"></i>
                                        <select id="diff-filter" class="bg-secondary text-foreground px-3 py-2 rounded-lg border border-border/30 outline-none flex-1 sm:flex-initial"
                                            onchange="filterProblems()">
                                            <option value="all">All Difficulties</option>
                                            <option value="easy">Easy</option>
                                            <option value="medium">Medium</option>
                                            <option value="hard">Hard</option>
                                        </select>
                                    </div>
                                </div>

                                <!-- Problems List -->
                                <section>
                                    <h2 class="section-title mb-4" id="prob-count">PROBLEMS (<%= problems.length %>)</h2>
                                    <div class="flex flex-col gap-2" id="problems-list">
                                        <% var diffClr={ easy:"text-success", medium:"text-warning", hard:"text-destructive" };
                                            problems.forEach(function(p, index) { %>
                                            <a href="/problem/<%= p._id %>"
                                                class="problem-row flex items-center gap-2 md:gap-4 p-3 md:p-4 rounded-lg bg-card/50 hover:bg-card transition-all border border-transparent hover:border-primary/30 group cursor-pointer no-underline"
                                                data-title="<%= p.title.toLowerCase() %>" data-diff="<%= p.difficulty %>"
                                                data-cat="<%= p.category %>" style="text-decoration:none;color:inherit">
                                                <div class="w-6 md:w-8 flex justify-center flex-shrink-0">
                                                    <% if (p.solved) { %>
                                                        <i data-lucide="check-circle-2" class="w-4 h-4 md:w-5 md:h-5 text-success"></i>
                                                    <% } else { %>
                                                        <div class="w-4 h-4 md:w-5 md:h-5 rounded-full border-2 border-muted-foreground/30"></div>
                                                    <% } %>
                                                </div>
                                                <div class="flex-1 min-w-0">
                                                    <h4 class="text-sm md:text-base font-medium text-foreground group-hover:text-primary transition-colors truncate">
                                                        <%= index + 1 %>. <%= p.title %>
                                                    </h4>
                                                    <div class="flex items-center gap-2 md:gap-3 text-[10px] md:text-xs text-muted-foreground mt-1">
                                                        <span class="truncate"><%= p.category %></span>
                                                        <span class="hidden sm:inline">&bull;</span>
                                                        <span class="hidden sm:inline"><%= p.stats ? p.stats.acceptance : '45%' %> acceptance</span>
                                                    </div>
                                                </div>
                                                <div class="hidden sm:flex items-center gap-2 text-sm text-muted-foreground">
                                                    <i data-lucide="star" class="w-4 h-4"></i>
                                                    <span><%= p.stats ? (p.stats.likes || 0).toLocaleString() : '0' %></span>
                                                </div>
                                                <span class="px-2 md:px-3 py-1 rounded-full text-[10px] md:text-xs font-bold capitalize flex-shrink-0 <%= diffClr[p.difficulty] %>">
                                                    <%= p.difficulty %>
                                                </span>
                                            </a>
                                        <% }); %>
                                    </div>
                                </section>
                            </div>
                        </div>
                    </main>
                </div>
            </div>
        </div>

        <script>
            var selectedCategory = null;

            function toggleCategory(btn) {
                var cat = btn.getAttribute('data-cat');
                if (selectedCategory === cat) {
                    selectedCategory = null;
                    btn.classList.remove('border-primary', 'bg-primary/10');
                } else {
                    document.querySelectorAll('.category-btn').forEach(function (b) { b.classList.remove('border-primary', 'bg-primary/10'); });
                    selectedCategory = cat;
                    btn.classList.add('border-primary', 'bg-primary/10');
                }
                filterProblems();
            }

            function filterProblems() {
                var search = document.getElementById('prob-search').value.toLowerCase();
                var diff = document.getElementById('diff-filter').value;
                var count = 0;
                document.querySelectorAll('.problem-row').forEach(function (row) {
                    var title = row.getAttribute('data-title');
                    var d = row.getAttribute('data-diff');
                    var cat = row.getAttribute('data-cat');
                    var show = (!search || title.includes(search)) && (diff === 'all' || d === diff) && (!selectedCategory || cat === selectedCategory);
                    row.style.display = show ? '' : 'none';
                    if (show) count++;
                });
                document.getElementById('prob-count').textContent = 'PROBLEMS (' + count + ')';
            }

            document.addEventListener('turbo:load', () => {
                if (typeof lucide !== 'undefined') {
                    lucide.createIcons();
                }
            });
        </script>
    </body>
</html>