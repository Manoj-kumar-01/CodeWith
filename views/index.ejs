<%- include('partials/head') %>

    <!-- Font for Thin Neon theme -->
    <link href="https://fonts.googleapis.com/css2?family=Orbitron:wght@400;500;600;700&display=swap" rel="stylesheet">
    <style>
        /* ── Timer (index only) ── */
        .timer-display {
            font-family: 'JetBrains Mono', monospace;
            font-size: 2.25rem;
            font-weight: 600;
            letter-spacing: 0.1em;
            color: hsl(220 14% 90%);
            text-shadow:
                0 0 10px hsl(152 58% 52% / 0.3),
                0 0 20px hsl(152 58% 52% / 0.15);
        }

        /* ── Slide-in animation (index only) ── */
        @keyframes slide-in-right {
            from { transform: translateX(100%); }
            to { transform: translateX(0); }
        }
        .animate-slide-in-right {
            animation: slide-in-right 0.3s ease-out;
        }

        .nostalgic-text {
            position: fixed;
            bottom: 20px;
            right: 20px;
            color: #00ffaa;
            font-size: 0.7rem;
            letter-spacing: 3px;
            text-transform: uppercase;
            z-index: 12;
            text-shadow: 0 0 5px #00ffaa, 0 0 10px #00ffaa;
            opacity: 0.5;
            font-family: 'Courier New', monospace;
        }

        .nostalgic-text:before {
            content: ">";
            margin-right: 5px;
            animation: blink 1s infinite;
        }

        @keyframes blink {
            0%, 100% { opacity: 1; }
            50% { opacity: 0; }
        }
    </style>

    <body>
        <div class="fixed inset-0 w-screen h-screen overflow-hidden">
            <!-- Thin Neon / Edge Flow overlays -->
            <!-- Thin Neon / Edge Flow overlays -->
            <div class="vintage-overlay"></div>
            <div class="scanlines"></div>
            <div class="flicker-effect"></div>

            <!-- Ultra-Elegant Minimalist Background -->
            <div class="absolute inset-0 z-0 bg-[#050907]" id="bg-container">
                <!-- Vast, extremely subtle ambient glow for depth -->
                <div class="absolute top-[-20%] left-[10%] w-[80vw] h-[80vw] bg-[radial-gradient(circle,_hsl(152_58%_52%_/_0.06)_0%,_transparent_70%)] pointer-events-none"></div>
                <!-- Faint secondary glow to balance the scene -->
                <div class="absolute bottom-[-10%] right-[-10%] w-[60vw] h-[60vw] bg-[radial-gradient(circle,_hsl(38_92%_55%_/_0.03)_0%,_transparent_60%)] pointer-events-none"></div>
                
                <!-- Premium matte glass noise (prevents banding, adds a luxurious physical texture) -->
                <div class="absolute inset-0 opacity-[0.02] pointer-events-none" style="background-image: url('data:image/svg+xml,%3Csvg viewBox=%220 0 200 200%22 xmlns=%22http://www.w3.org/2000/svg%22%3E%3Cfilter id=%22noiseFilter%22%3E%3CfeTurbulence type=%22fractalNoise%22 baseFrequency=%220.85%22 numOctaves=%223%22 stitchTiles=%22stitch%22/%3E%3C/filter%3E%3Crect width=%22100%25%22 height=%22100%25%22 filter=%22url(%23noiseFilter)%22/%3E%3C/svg%3E');"></div>
            </div>

            <!-- Monitor Container -->
            <div class="relative z-10 w-screen h-screen">
                <div class="monitor-frame">
                    <div class="monitor-bezel">
                        <div class="monitor-screen">
                            <div class="flex h-full relative">
                                <!-- Sidebar -->
                                <%- include('partials/sidebar') %>

                                    <!-- Main Content -->
                                    <main class="flex-1 flex flex-col min-w-0 overflow-hidden relative">
                                        <div class="relative z-10 flex flex-col h-full overflow-hidden">
                                            <!-- Header (Global Glassy) -->
                                            <header class="border-b border-border/30 backdrop-blur-xl bg-background/50 z-20">
                                                <%- include('partials/top-bar', { showShinyLine: true }) %>
                                            </header>

                                            <!-- Scrollable Content -->
                                            <div class="flex-1 overflow-y-auto scrollbar-thin px-4 md:px-6 pb-6">
                                                <!-- Daily Challenge Timer -->
                                                <div class="pt-4 pb-4 px-4 relative"
                                                    style="padding-left:20px;border-left:2px solid transparent;border-image:linear-gradient(to bottom, rgba(210,210,210,0.2), rgba(210,210,210,0.8), rgba(210,210,210,0.2)) 1">
                                                    <h2
                                                        class="text-lg font-semibold text-foreground mb-2 tracking-wide">
                                                        DAILY BYTE CHALLENGE</h2>
                                                    <div class="relative inline-block">
                                                        <div
                                                            class="absolute -inset-3 bg-gradient-to-r from-primary/15 via-primary/25 to-primary/10 blur-xl rounded-lg">
                                                        </div>
                                                        <div class="timer-display text-foreground relative z-10 tabular-nums tracking-widest"
                                                            id="timer">09:59:45</div>
                                                    </div>
                                                </div>

                                                <!-- Quick Stats Row -->
                                                <div class="grid grid-cols-2 md:grid-cols-4 gap-3 mt-6 mb-8">
                                                    <div class="glass-card p-3 md:p-4 text-center">
                                                        <div class="text-2xl font-bold text-foreground">
                                                            <%= typeof contests !== 'undefined' ? contests.length : 0 %>
                                                        </div>
                                                        <div class="text-[10px] text-muted-foreground uppercase tracking-wider mt-1">Active Contests</div>
                                                    </div>
                                                    <div class="glass-card p-3 md:p-4 text-center">
                                                        <div class="text-2xl font-bold text-foreground">12</div>
                                                        <div class="text-[10px] text-muted-foreground uppercase tracking-wider mt-1">Problems</div>
                                                    </div>
                                                    <div class="glass-card p-3 md:p-4 text-center">
                                                        <div class="text-2xl font-bold text-primary">6</div>
                                                        <div class="text-[10px] text-muted-foreground uppercase tracking-wider mt-1">Solved</div>
                                                    </div>
                                                    <div class="glass-card p-3 md:p-4 text-center">
                                                        <div class="text-2xl font-bold text-foreground">15</div>
                                                        <div class="text-[10px] text-muted-foreground uppercase tracking-wider mt-1">Day Streak</div>
                                                    </div>
                                                </div>

                                                <!-- Two Column Layout -->
                                                <div class="grid grid-cols-1 lg:grid-cols-5 gap-6">
                                                    <!-- Left Column: Contests + Activity (3 cols) -->
                                                    <div class="lg:col-span-3">
                                                        <!-- Active Contests -->
                                                        <section class="mb-6">
                                                            <div class="flex items-center justify-between mb-4">
                                                                <h2 class="section-title">ACTIVE CONTESTS</h2>
                                                                <a href="/contests" class="text-[11px] text-muted-foreground hover:text-primary transition-colors" style="text-decoration:none">View all →</a>
                                                            </div>
                                                            <div class="flex flex-col sm:flex-row pb-3 gap-4">
                                                                <% if (typeof contests !=='undefined' && contests.length> 0) { %>
                                                                    <% contests.forEach(function(c) { const dc={
                                                                        easy: "status-easy" , medium: "status-medium" ,
                                                                        hard: "status-hard" }[c.difficulty] || "status-easy" ;
                                                                        const dl=c.difficulty.toUpperCase(); const rl=c.timeLeft || "TIME LEFT"; %>
                                                                        <div class="glass-card flex-1 cursor-pointer p-4 hover:border-primary/30 transition-all group" onclick="window.location.href='/contest/<%= c.id %>'">
                                                                            <div class="flex items-center gap-3">
                                                                                <div class="w-10 h-10 rounded-lg bg-primary/10 flex items-center justify-center flex-shrink-0 group-hover:bg-primary/20 transition-colors">
                                                                                    <i data-lucide="trophy" class="w-5 h-5 text-primary"></i>
                                                                                </div>
                                                                                <div class="flex-1 min-w-0">
                                                                                    <div class="flex items-center gap-2 mb-1">
                                                                                        <h3 class="font-semibold text-foreground text-sm truncate"><%= c.title %></h3>
                                                                                        <span class="<%= dc %> text-[9px] font-semibold px-2 py-0.5 rounded flex-shrink-0"><%= dl %></span>
                                                                                    </div>
                                                                                    <div class="flex items-center gap-3">
                                                                                        <span class="text-muted-foreground text-[11px]"><%= c.problems %> Problems</span>
                                                                                        <span class="text-[10px] font-medium text-primary tabular-nums"><%= rl %></span>
                                                                                    </div>
                                                                                </div>
                                                                                <i data-lucide="chevron-right" class="w-4 h-4 text-muted-foreground/40 group-hover:text-primary transition-colors flex-shrink-0"></i>
                                                                            </div>
                                                                        </div>
                                                                    <% }); %>
                                                                <% } else { %>
                                                                    <div class="glass-card p-6 text-center w-full">
                                                                        <i data-lucide="trophy" class="w-8 h-8 text-muted-foreground/30 mx-auto mb-2"></i>
                                                                        <p class="text-muted-foreground text-sm">No active contests at the moment.</p>
                                                                        <a href="/contests" class="text-xs text-primary hover:underline mt-2 inline-block">Browse past contests →</a>
                                                                    </div>
                                                                <% } %>
                                                            </div>
                                                        </section>

                                                        <!-- Recent Activity Feed -->
                                                        <section>
                                                            <h2 class="section-title mb-4">RECENT ACTIVITY</h2>
                                                            <div class="glass-card overflow-hidden">
                                                                <% const solvers=[
                                                                    { name: "Raj", problem: "Innovation Challenge", time: "2 min ago", difficulty: "easy" },
                                                                    { name: "Manoj", problem: "Algorithm Challenge", time: "5 min ago", difficulty: "medium" },
                                                                    { name: "Priya", problem: "Graph Theory", time: "8 min ago", difficulty: "easy" },
                                                                    { name: "Alex", problem: "Dynamic Programming", time: "12 min ago", difficulty: "hard" },
                                                                    { name: "Ravi", problem: "Arrays & Strings", time: "15 min ago", difficulty: "easy" },
                                                                ]; solvers.forEach(function(s) {
                                                                    const dc={ easy: "text-success", medium: "text-warning", hard: "text-destructive" }[s.difficulty]; %>
                                                                    <div class="flex items-center gap-3 px-4 py-3 hover:bg-white/[0.02] transition-colors border-b border-border/15 last:border-b-0">
                                                                        <div class="w-7 h-7 rounded-full bg-primary/10 flex items-center justify-center flex-shrink-0 text-xs font-bold text-primary border border-primary/20">
                                                                            <%= s.name.charAt(0) %>
                                                                        </div>
                                                                        <div class="flex-1 min-w-0">
                                                                            <span class="text-[13px] text-foreground font-medium"><%= s.name %></span>
                                                                            <span class="text-[11px] text-muted-foreground"> solved </span>
                                                                            <span class="text-[11px] <%= dc %> truncate inline-block align-bottom max-w-[120px] sm:max-w-none"><%= s.problem %></span>
                                                                        </div>
                                                                        <span class="text-[10px] text-muted-foreground flex-shrink-0"><%= s.time %></span>
                                                                    </div>
                                                                <% }); %>
                                                            </div>
                                                        </section>
                                                    </div>

                                                    <!-- Right Column: Quick Links & Topics (2 cols) -->
                                                    <div class="lg:col-span-2">
                                                        <!-- Quick Actions -->
                                                        <section class="mb-6">
                                                            <h2 class="section-title mb-4">QUICK START</h2>
                                                            <div class="flex flex-col gap-2">
                                                                <a href="/practice" class="glass-card p-3 flex items-center gap-3 hover:border-primary/30 transition-all group duration-300" style="text-decoration:none;color:inherit">
                                                                    <div class="w-9 h-9 rounded-lg bg-primary/10 group-hover:bg-primary/20 transition-colors flex items-center justify-center flex-shrink-0">
                                                                        <i data-lucide="code-2" class="w-4 h-4 text-primary"></i>
                                                                    </div>
                                                                    <div class="flex-1">
                                                                        <div class="text-sm font-medium text-foreground group-hover:text-primary transition-colors">Practice Problems</div>
                                                                        <div class="text-[10px] text-muted-foreground">12 problems across 4 categories</div>
                                                                    </div>
                                                                    <i data-lucide="arrow-right" class="w-4 h-4 text-muted-foreground/30 group-hover:text-primary transition-colors"></i>
                                                                </a>
                                                                <a href="/contests" class="glass-card p-3 flex items-center gap-3 hover:border-warning/30 transition-all group duration-300" style="text-decoration:none;color:inherit">
                                                                    <div class="w-9 h-9 rounded-lg bg-warning/10 group-hover:bg-warning/20 transition-colors flex items-center justify-center flex-shrink-0">
                                                                        <i data-lucide="trophy" class="w-4 h-4 text-warning"></i>
                                                                    </div>
                                                                    <div class="flex-1">
                                                                        <div class="text-sm font-medium text-foreground group-hover:text-warning transition-colors">Join a Contest</div>
                                                                        <div class="text-[10px] text-muted-foreground">Compete with other developers</div>
                                                                    </div>
                                                                    <i data-lucide="arrow-right" class="w-4 h-4 text-muted-foreground/30 group-hover:text-warning transition-colors"></i>
                                                                </a>
                                                            </div>
                                                        </section>

                                                        <!-- Popular Topics -->
                                                        <section>
                                                            <h2 class="section-title mb-4">POPULAR TOPICS</h2>
                                                            <div class="flex flex-col gap-2">
                                                                <% const topics=[
                                                                    { name: "Arrays & Strings", count: 4, icon: "layers" },
                                                                    { name: "Graph Theory", count: 3, icon: "share-2" },
                                                                    { name: "Dynamic Programming", count: 3, icon: "git-branch" },
                                                                    { name: "Trees", count: 2, icon: "git-merge" },
                                                                ]; topics.forEach(function(t) { %>
                                                                    <div class="glass-card p-3 flex items-center gap-3 hover:bg-white/[0.02] cursor-pointer transition-colors group">
                                                                        <div class="w-8 h-8 rounded-lg bg-card flex items-center justify-center flex-shrink-0 border border-border/30 group-hover:border-primary/30 transition-colors">
                                                                            <i data-lucide="<%= t.icon %>" class="w-4 h-4 text-muted-foreground group-hover:text-primary transition-colors"></i>
                                                                        </div>
                                                                        <div class="flex-1">
                                                                            <div class="text-sm font-medium text-foreground group-hover:text-primary transition-colors"><%= t.name %></div>
                                                                        </div>
                                                                        <span class="text-[10px] text-muted-foreground bg-secondary/50 px-2 py-0.5 rounded-full"><%= t.count %> problems</span>
                                                                    </div>
                                                                <% }); %>
                                                            </div>
                                                        </section>
                                                    </div>
                                                </div>
                                        </div>
                            </div>
                            </main>

                            <!-- Friends Toggle Button -->
                            <button data-friends-toggle onclick="toggleFriends()"
                                class="fixed bottom-4 right-4 md:bottom-6 md:right-6 z-[60] p-3 rounded-full bg-transparent hover:bg-primary/10 border border-primary/20 backdrop-blur-md transition-all duration-300 shadow-lg hover:shadow-xl shadow-primary/5 hover:scale-110 active:scale-95"
                                title="Toggle Friends">
                                <i data-lucide="users" class="w-5 h-5 md:w-6 md:h-6 text-primary"></i>
                            </button>

                            <!-- Friends Panel Overlay -->
                            <aside id="friends-aside"
                                class="fixed top-0 right-0 h-full w-80 max-w-[85vw] z-50 animate-slide-in-right shadow-2xl hidden">
                                <%- include('partials/friends-panel') %>
                            </aside>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        </div>

        <script>
            // Daily Challenge Timer - Fixed to start at 09:59:45 every time
            document.addEventListener('DOMContentLoaded', function () {
                const timerElement = document.getElementById('timer');

                // Set initial time to 9 hours, 59 minutes, 45 seconds
                let totalSeconds = (9 * 60 * 60) + (59 * 60) + 45; // 09:59:45

                // Format time function
                function formatTime(seconds) {
                    const hrs = Math.floor(seconds / 3600);
                    const mins = Math.floor((seconds % 3600) / 60);
                    const secs = seconds % 60;

                    return `${hrs.toString().padStart(2, '0')}:${mins.toString().padStart(2, '0')}:${secs.toString().padStart(2, '0')}`;
                }

                // Initial display
                timerElement.textContent = formatTime(totalSeconds);

                // Update timer every second
                const timerInterval = setInterval(() => {
                    if (totalSeconds > 0) {
                        totalSeconds--;
                        timerElement.textContent = formatTime(totalSeconds);
                    } else {
                        clearInterval(timerInterval);
                    }
                }, 1000);
            });
        </script>

        <script src="/js/friends-panel.js"></script>
        <script src="/js/card-effects.js"></script>
        <script>lucide.createIcons();</script>
    </body>

    </html>