<%- include('partials/head') %>
<script src="https://cdnjs.cloudflare.com/ajax/libs/monaco-editor/0.44.0/min/vs/loader.min.js"></script>


    <style>
        @import url('https://fonts.googleapis.com/css2?family=Fira+Code:wght@400;500;600&display=swap');

        .code-editor {
            font-size: 14px;
            line-height: 1.6;
            background: #1a1b26;
            color: #d1d5db;
        }

        .line-numbers {
            font-family: 'Fira Code', monospace;
            font-size: 14px;
            line-height: 1.6;
            background: #16161e;
            color: #4b5563;
        }

        .output-success {
            background: linear-gradient(135deg, rgba(16, 185, 129, 0.05) 0%, rgba(5, 150, 105, 0.02) 100%);
            border-left: 4px solid #10b981;
        }

        .output-error {
            background: linear-gradient(135deg, rgba(239, 68, 68, 0.05) 0%, rgba(185, 28, 28, 0.02) 100%);
            border-left: 4px solid #ef4444;
        }

        .test-case-pass {
            border-color: #10b981;
            background: linear-gradient(135deg, rgba(16, 185, 129, 0.05) 0%, rgba(5, 150, 105, 0.02) 100%);
        }

        .test-case-fail {
            border-color: #ef4444;
            background: linear-gradient(135deg, rgba(239, 68, 68, 0.05) 0%, rgba(185, 28, 28, 0.02) 100%);
        }

        .tab-active {
            background: linear-gradient(to bottom, transparent, rgba(59, 130, 246, 0.1));
            border-bottom: 2px solid #3b82f6;
            color: #ffffff;
        }

        .glass-panel {
            background: rgba(30, 41, 59, 0.5);
            backdrop-filter: blur(10px);
            border: 1px solid rgba(255, 255, 255, 0.05);
        }

        /* Problem Switcher Drawer */
        #problem-drawer {
            background: #16161e;
            border-right: 1px solid #111111;
            transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        }

        #problem-drawer.closed {
            transform: translateX(-100%);
        }

        .problem-item-active {
            background: linear-gradient(to right, rgba(139, 92, 246, 0.15), transparent);
            border-left: 4px solid #8b5cf6;
        }

        .btn-premium {
            position: relative;
            overflow: hidden;
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
            border: 1px solid rgba(255, 255, 255, 0.1);
        }

        .btn-premium:hover {
            transform: translateY(-1px);
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.4);
            border-color: rgba(255, 255, 255, 0.2);
        }

        .btn-premium:active {
            transform: translateY(0);
        }

        .btn-premium::after {
            content: '';
            position: absolute;
            top: -50%;
            left: -50%;
            width: 200%;
            height: 200%;
            background: linear-gradient(45deg, transparent, rgba(255, 255, 255, 0.1), transparent);
            transform: rotate(45deg);
            transition: 0.5s;
            opacity: 0;
        }

        .btn-premium:hover::after {
            left: 120%;
            opacity: 1;
        }
    </style>

    <body class="bg-[#0f0f17] text-gray-200">
        <!-- Problem Switcher Drawer -->
        <div id="problem-drawer" 
             class="fixed inset-y-0 left-0 w-80 glass-panel z-50 closed shadow-2xl transition-transform">
            <div class="p-6 h-full flex flex-col">
                <div class="flex items-center justify-between mb-8">
                    <h2 class="text-xl font-bold bg-gradient-to-r from-purple-400 to-pink-400 bg-clip-text text-transparent">
                        Contest Problems
                    </h2>
                    <button onclick="toggleDrawer()" class="p-2 rounded-lg hover:bg-white/5 transition-colors">
                        <i data-lucide="x" class="w-5 h-5 text-gray-400"></i>
                    </button>
                </div>

                <div class="space-y-2 overflow-y-auto flex-1 custom-scrollbar pr-2">
                    <% if (typeof contestProblems !== 'undefined') { %>
                        <% contestProblems.forEach((p, idx) => { 
                            const isCurrent = p._id.toString() === problem._id.toString();
                            const link = (typeof contest !== 'undefined' && contest) 
                                ? `/contest/${contest.id || contest._id}/problem/${p._id}` 
                                : `/problem/${p._id}`;
                        %>
                            <a href="<%= link %>" 
                               class="flex items-center gap-4 p-4 rounded-xl transition-all duration-300 border border-transparent hover:border-white/10 hover:bg-white/5 group
                                      <%= isCurrent ? 'problem-item-active bg-white/5 border-purple-500/30' : '' %>">
                                <div class="w-8 h-8 rounded-lg <%= isCurrent ? 'bg-purple-600' : 'bg-gray-800 group-hover:bg-gray-700' %> flex items-center justify-center text-sm font-bold shrink-0 transition-colors">
                                    <%= idx + 1 %>
                                </div>
                                <div class="min-w-0">
                                    <h3 class="text-sm font-medium truncate <%= isCurrent ? 'text-white' : 'text-gray-400 group-hover:text-gray-200' %>">
                                        <%= p.title %>
                                    </h3>
                                    <span class="text-[10px] font-bold uppercase tracking-wider
                                        <%= p.difficulty === 'easy' ? 'text-green-400' : p.difficulty === 'medium' ? 'text-yellow-400' : 'text-red-400' %>">
                                        <%= p.difficulty %>
                                    </span>
                                </div>
                            </a>
                        <% }) %>
                    <% } %>
                </div>

                <div class="mt-auto pt-6 border-t border-white/5">
                    <a href="<%= (typeof contest !== 'undefined' && contest) ? '/contest/' + (contest._id || contest.id) : '/practice' %>" 
                       class="flex items-center justify-center gap-2 p-3 rounded-xl border border-gray-700 hover:border-gray-500 hover:bg-white/5 transition-all text-sm text-gray-400 hover:text-white">
                        <i data-lucide="<%= (typeof contest !== 'undefined' && contest) ? 'layout-dashboard' : 'layout-grid' %>" class="w-4 h-4"></i>
                        <%= (typeof contest !== 'undefined' && contest) ? 'Contest Dashboard' : 'View All Problems' %>
                    </a>
                </div>
            </div>
        </div>

        <div class="h-screen flex flex-col overflow-hidden">
            <!-- Top Bar -->
            <header
                class="glass-panel flex items-center justify-between py-2 border-b border-gray-800/50 z-20 flex-shrink-0">
                <div class="flex items-center gap-2">
                     <button onclick="toggleDrawer()"
                         class="p-2 ml-2 rounded-lg hover:bg-white/10 transition-colors text-gray-400 hover:text-white"
                         title="All Problems">
                         <i data-lucide="menu" class="w-5 h-5"></i>
                     </button>
                     <a href="<%= (typeof contest !== 'undefined' && contest) ? '/contest/' + (contest._id || contest.id) + '/problems' : '/practice' %>"
                         class="p-2 rounded-lg hover:bg-white/5 transition-colors group">
                         <i data-lucide="chevron-left" class="w-5 h-5 text-gray-400 group-hover:text-white"></i>
                     </a>
                     <div class="flex items-center gap-3">
                         <div class="scale-75 origin-left -ml-2">
                             <%- include('partials/logo') %>
                         </div>
                         <div class="-ml-4">
                             <h1 class="text-sm font-semibold">
                                 <%= problem.title %>
                             </h1>
                             <p class="text-xs text-gray-400">
                                 <%= (typeof contest !== 'undefined' && contest) ? contest.title : 'Practice Mode' %>
                             </p>
                         </div>
                     </div>
                </div>

                <div class="flex items-center gap-2">
                    <!-- Language Select with Custom Styling -->
                    <div class="relative">
                        <select id="lang-select"
                            class="appearance-none bg-[#1e1e2e] text-gray-200 text-sm px-4 py-2 pr-8 rounded-lg border border-gray-700 outline-none cursor-pointer hover:border-purple-500/50 transition-colors"
                            onchange="changeLang()">
                            <option value="javascript">JavaScript (Node.js 18)</option>
                            <option value="python">Python 3.11</option>
                            <option value="cpp">C++ 17 (GCC)</option>
                            <option value="c">C (GCC)</option>
                            <option value="java">Java (OpenJDK 17)</option>
                            <option value="typescript">TypeScript (tsx)</option>
                            <option value="go">Go 1.21</option>
                            <option value="rust">Rust 1.73</option>
                            <option value="ruby">Ruby 3.2</option>
                            <option value="php">PHP 8.2</option>
                            <option value="perl">Perl 5.38</option>
                            <option value="r">R</option>
                            <option value="swift">Swift 5.9</option>
                            <option value="scala">Scala 3.2</option>
                        </select>
                        <i data-lucide="chevron-down"
                            class="absolute right-3 top-1/2 -translate-y-1/2 w-4 h-4 text-gray-400 pointer-events-none"></i>
                    </div>

                    <div class="w-px h-6 bg-gray-800 mx-2"></div>

                    <button onclick="copyCode()" class="p-2 rounded-lg hover:bg-white/5 transition-colors group"
                        title="Copy code">
                        <i data-lucide="copy" class="w-4 h-4 text-gray-400 group-hover:text-white"></i>
                    </button>

                    <button onclick="resetCode()" class="p-2 rounded-lg hover:bg-white/5 transition-colors group"
                        title="Reset code">
                        <i data-lucide="rotate-ccw" class="w-4 h-4 text-gray-400 group-hover:text-white"></i>
                    </button>

                    <button onclick="toggleFullscreen()"
                        class="p-2 rounded-lg hover:bg-white/5 transition-colors group hidden md:flex"
                        title="Toggle fullscreen">
                        <i data-lucide="maximize-2" class="w-4 h-4 text-gray-400 group-hover:text-white"></i>
                    </button>

                    <div class="w-px h-6 bg-gray-800 mx-2"></div>

                    <!-- Run & Submit with Minimalist Premium Styling -->
                    <button id="run-btn" onclick="runCode()"
                        class="btn-premium px-4 py-1.5 rounded-md bg-[#2563eb] hover:bg-[#3b82f6] text-white text-[10px] font-bold tracking-widest uppercase shadow-[0_0_15px_rgba(37,99,235,0.2)]">
                        RUN
                    </button>

                    <button id="submit-btn" onclick="submitCode()"
                        class="btn-premium px-4 py-1.5 rounded-md bg-[#10b981] hover:bg-[#34d399] text-white text-[10px] font-bold tracking-widest uppercase shadow-[0_0_15px_rgba(16,185,129,0.2)]">
                        SUBMIT
                    </button>
                </div>
            </header>

            <!-- Main Content -->
            <div id="main-content" class="flex-1 flex flex-col lg:flex-row overflow-hidden">
                <!-- Left Panel - Problem Description -->
                <div id="left-panel"
                    class="w-full lg:w-[42%] xl:w-[38%] flex flex-col border-r border-gray-800/50 bg-[#1a1b26]/80 overflow-hidden flex-shrink-0">
                    <!-- Problem tabs with glass effect -->
                    <div
                        class="flex items-center gap-1 px-4 pt-3 border-b border-gray-800/50 flex-shrink-0 bg-[#16161e]">
                        <button onclick="setDescTab('description')"
                            class="desc-tab flex items-center gap-2 px-4 py-2 text-sm font-medium rounded-t-lg transition-all tab-active"
                            data-tab="description">
                            <i data-lucide="book-open" class="w-4 h-4"></i> Description
                        </button>
                        <button onclick="setDescTab('hints')"
                            class="desc-tab flex items-center gap-2 px-4 py-2 text-sm font-medium rounded-t-lg transition-all text-gray-400 hover:text-white"
                            data-tab="hints">
                            <i data-lucide="lightbulb" class="w-4 h-4"></i> Hints
                        </button>
                        <button onclick="setDescTab('discussion')"
                            class="desc-tab flex items-center gap-2 px-4 py-2 text-sm font-medium rounded-t-lg transition-all text-gray-400 hover:text-white"
                            data-tab="discussion">
                            <i data-lucide="message-square" class="w-4 h-4"></i> Discuss
                        </button>
                    </div>

                    <!-- Content with custom scrollbar -->
                    <div
                        class="flex-1 overflow-y-auto scrollbar-thin scrollbar-thumb-gray-700 scrollbar-track-transparent p-6">
                        <!-- Description tab -->
                        <div id="desc-description" class="desc-content space-y-6">
                            <div>
                                <div class="flex items-center gap-3 mb-3">
                                    <h1 class="text-2xl font-bold text-white">
                                        <%= problem.title %>
                                    </h1>
                                    <span class="px-2 py-1 rounded-full text-xs font-bold uppercase
                                        <%= problem.difficulty === 'easy' ? 'bg-emerald-500/20 text-emerald-400 border border-emerald-500/30' :
                                           problem.difficulty === 'medium' ? 'bg-amber-500/20 text-amber-400 border border-amber-500/30' :
                                           'bg-rose-500/20 text-rose-400 border border-rose-500/30' %>">
                                        <%= problem.difficulty %>
                                    </span>
                                </div>

                                <!-- Stats badges -->
                                <div class="flex flex-wrap gap-3 mb-4">
                                    <div
                                        class="flex items-center gap-1.5 text-sm text-gray-400 bg-gray-800/50 px-3 py-1 rounded-full">
                                        <i data-lucide="check-circle" class="w-4 h-4 text-green-400"></i>
                                        <span>
                                            <%= problem.solved || 0 %> solved
                                        </span>
                                    </div>
                                    <div
                                        class="flex items-center gap-1.5 text-sm text-gray-400 bg-gray-800/50 px-3 py-1 rounded-full">
                                        <i data-lucide="trending-up" class="w-4 h-4 text-purple-400"></i>
                                        <span>
                                            <%= problem.acceptance || '75%' %> acceptance
                                        </span>
                                    </div>
                                    <div
                                        class="flex items-center gap-1.5 text-sm text-gray-400 bg-gray-800/50 px-3 py-1 rounded-full">
                                        <i data-lucide="award" class="w-4 h-4 text-yellow-400"></i>
                                        <span>
                                            <%= problem.points || 100 %> points
                                        </span>
                                    </div>
                                </div>

                                <!-- Tags -->
                                <% if (problem.tags && problem.tags.length> 0) { %>
                                    <div class="flex flex-wrap gap-2 mb-4">
                                        <% problem.tags.forEach(function(tag) { %>
                                            <span
                                                class="text-xs px-3 py-1 rounded-full bg-purple-500/10 text-purple-400 border border-purple-500/30">
                                                <%= tag %>
                                            </span>
                                            <% }); %>
                                    </div>
                                    <% } %>
                            </div>

                            <div class="text-gray-300 leading-relaxed">
                                <%= problem.description %>
                            </div>

                            <!-- Examples -->
                            <% if (problem.examples && problem.examples.length> 0) { %>
                                <% problem.examples.forEach(function(ex, i) { %>
                                    <div class="rounded-lg border border-gray-800 overflow-hidden">
                                        <div
                                            class="px-4 py-2 bg-[#16161e] text-xs font-semibold text-gray-400 border-b border-gray-800">
                                            Example <%= i + 1 %>
                                        </div>
                                        <div class="p-4 space-y-3 font-mono text-sm">
                                            <div>
                                                <span class="text-gray-500">Input: </span>
                                                <code
                                                    class="text-gray-300 bg-gray-800/50 px-2 py-1 rounded"><%= ex.input %></code>
                                            </div>
                                            <div>
                                                <span class="text-gray-500">Output: </span>
                                                <code
                                                    class="text-purple-400 bg-gray-800/50 px-2 py-1 rounded"><%= ex.output %></code>
                                            </div>
                                            <% if (ex.explanation) { %>
                                                <div class="mt-2 text-gray-500 text-xs italic">
                                                    <%= ex.explanation %>
                                                </div>
                                            <% } %>
                                        </div>
                                    </div>
                                <% }); %>
                            <% } %>

                            <!-- Constraints -->
                            <% if (problem.constraints && problem.constraints.length > 0) { %>
                                <div class="space-y-3">
                                    <h3 class="text-xs font-bold text-gray-400 uppercase tracking-widest flex items-center gap-2">
                                        <i data-lucide="shield" class="w-3.5 h-3.5 text-orange-400"></i>
                                        Constraints
                                    </h3>
                                    <ul class="list-disc list-inside text-sm text-gray-400 space-y-1 pl-1">
                                        <% problem.constraints.forEach(function(c) { %>
                                            <li><%= c %></li>
                                        <% }); %>
                                    </ul>
                                </div>
                            <% } %>
                            
                            <!-- Sample Test Cases -->
                            <% if (problem.testCases && problem.testCases.filter(t => !t.isHidden).length > 0) { %>
                                <div class="space-y-3 mt-6">
                                    <h3 class="text-xs font-bold text-gray-400 uppercase tracking-widest flex items-center gap-2">
                                        <i data-lucide="check-square" class="w-3.5 h-3.5 text-blue-400"></i>
                                        Sample Test Cases
                                    </h3>
                                    <div class="grid grid-cols-1 gap-3">
                                        <% problem.testCases.filter(t => !t.isHidden).forEach(function(tc, i) { %>
                                            <div class="p-3 bg-[#1e1e2e] border border-gray-800 rounded-lg text-xs font-mono text-gray-300">
                                                <div class="mb-1"><span class="text-gray-500">Input:</span> <%= tc.input %></div>
                                                <div><span class="text-gray-500">Expected:</span> <span class="text-purple-400"><%= tc.expected %></span></div>
                                            </div>
                                        <% }); %>
                                    </div>
                                </div>
                            <% } %>
                        </div>

                        <!-- Hints tab -->
                        <div id="desc-hints" class="desc-content hidden space-y-4">
                            <div
                                class="p-4 rounded-lg bg-gradient-to-br from-amber-500/10 to-orange-500/5 border border-amber-500/20">
                                <h3 class="text-sm font-bold text-amber-400 mb-2 flex items-center gap-2">
                                    <i data-lucide="lightbulb" class="w-4 h-4"></i> Hint 1
                                </h3>
                                <p class="text-sm text-gray-300">Think about using a hash map to store values you've
                                    already seen.</p>
                            </div>
                            <div
                                class="p-4 rounded-lg bg-gradient-to-br from-amber-500/10 to-orange-500/5 border border-amber-500/20">
                                <h3 class="text-sm font-bold text-amber-400 mb-2 flex items-center gap-2">
                                    <i data-lucide="lightbulb" class="w-4 h-4"></i> Hint 2
                                </h3>
                                <p class="text-sm text-gray-300">For each element, check if target - element exists in
                                    your hash map.</p>
                            </div>
                        </div>

                        <!-- Discussion tab -->
                        <div id="desc-discussion" class="desc-content hidden py-8 text-center text-gray-500">
                            <i data-lucide="message-square" class="w-12 h-12 mx-auto mb-3 opacity-30"></i>
                            <p>Discussion feature coming soon.</p>
                        </div>
                    </div>
                </div>

                <!-- HORIZONTAL RESIZER -->
                <div id="resizer-x" class="w-1.5 cursor-col-resize hover:bg-purple-600/50 bg-gray-800/20 active:bg-purple-500 z-40 transition-colors hidden lg:block"></div>

                <!-- Right Panel - Editor & Output -->
                <div id="right-panel" class="flex-1 flex flex-col overflow-hidden bg-[#1a1b26]">
                    <!-- Editor Container -->
                    <div id="editor-container" class="flex-1 flex overflow-hidden min-h-0 relative bg-[#1a1b26]" style="background: radial-gradient(circle at center, rgba(138, 43, 226, 0.04) 0%, rgba(26,27,38,1) 100%); box-shadow: inset 0 0 30px rgba(138, 43, 226, 0.05);">
                        <div id="monaco-editor" class="absolute inset-0 opacity-[0.98]"></div>
                    </div>

                    <!-- VERTICAL RESIZER -->
                    <div id="resizer-y" class="h-1.5 cursor-row-resize hover:bg-purple-600/50 bg-gray-800/20 active:bg-purple-500 z-40 transition-colors flex-shrink-0"></div>

                    <!-- Bottom Panel with Test Cases & Output -->
                    <div id="terminal-container"
                        class="h-[35%] min-h-[100px] flex flex-col border-t border-gray-800/50 bg-[#16161e] flex-shrink-0">
                        <div class="flex items-center justify-between px-4 border-b border-gray-800/50 flex-shrink-0">
                            <div class="flex items-center gap-2">
                                <button onclick="setBottomTab('testcases')"
                                    class="bottom-tab flex items-center gap-2 px-4 py-3 text-sm font-medium transition-all tab-active"
                                    data-tab="testcases">
                                    <i data-lucide="book-open" class="w-4 h-4"></i> Test Cases
                                </button>
                                <button onclick="setBottomTab('output')"
                                    class="bottom-tab flex items-center gap-2 px-4 py-3 text-sm font-medium transition-all text-gray-400 hover:text-white"
                                    data-tab="output">
                                    <i data-lucide="terminal" class="w-4 h-4"></i> Output
                                    <span id="pass-badge"
                                        class="hidden ml-2 text-[10px] px-2 py-0.5 rounded-full font-bold"></span>
                                </button>
                            </div>

                            <!-- Status indicator -->
                            <div id="status-indicator" class="hidden flex items-center gap-2">
                                <div class="w-2 h-2 rounded-full bg-green-400 animate-pulse"></div>
                                <span class="text-xs text-gray-400">Running...</span>
                            </div>
                        </div>

                        <div class="flex-1 overflow-y-auto scrollbar-thin scrollbar-thumb-gray-700 p-4">
                            <!-- Test cases tab -->
                            <div id="bottom-testcases" class="bottom-content space-y-4">
                                <div class="flex gap-2 flex-wrap" id="test-case-btns">
                                    <% if (problem.testCases && problem.testCases.length> 0) { %>
                                        <% problem.testCases.forEach(function(tc, i) { %>
                                            <button onclick="selectTestCase(<%= i %>)"
                                                class="tc-btn px-4 py-2 text-xs font-medium rounded-lg transition-all <%= i === 0 ? 'bg-purple-600/20 text-purple-400 border border-purple-500/30' : 'bg-gray-800/40 text-gray-400 hover:text-white hover:bg-gray-800' %>"
                                                data-idx="<%= i %>">
                                                Case <%= i + 1 %>
                                            </button>
                                            <% }); %>
                                                <% } %>
                                </div>

                                <div id="tc-detail"
                                    class="rounded-lg bg-[#1e1e2e] p-4 font-mono text-sm space-y-3 border border-gray-800">
                                    <% if (problem.testCases && problem.testCases.length> 0) { %>
                                        <div>
                                            <span class="text-gray-500 text-xs">Input:</span>
                                            <div class="text-gray-300 mt-1 bg-gray-900/50 p-2 rounded">
                                                <%= problem.testCases[0].input %>
                                            </div>
                                        </div>
                                        <div>
                                            <span class="text-gray-500 text-xs">Expected:</span>
                                            <div class="text-purple-400 mt-1 bg-gray-900/50 p-2 rounded">
                                                <%= problem.testCases[0].expected %>
                                            </div>
                                        </div>
                                        <% } %>
                                </div>
                            </div>

                            <!-- Output tab -->
                            <div id="bottom-output" class="bottom-content hidden space-y-3">
                                <div id="output-idle"
                                    class="flex flex-col items-center justify-center py-8 text-gray-500">
                                    <i data-lucide="terminal" class="w-12 h-12 mb-3 opacity-30"></i>
                                    <p class="text-sm">Run your code to see output</p>
                                </div>

                                <div id="output-running"
                                    class="hidden flex items-center gap-3 py-8 justify-center text-gray-400">
                                    <i data-lucide="loader-2" class="w-5 h-5 animate-spin text-purple-400"></i>
                                    <span class="text-sm">Running test cases...</span>
                                </div>

                                <div id="output-results" class="hidden space-y-3"></div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <script>
            let editor;
            let starterCode = <%- JSON.stringify(problem.starterCode || {}) %>;
            const testCases = <%- JSON.stringify(problem.testCases || []) %>;
            const problemId = "<%= problem._id || problem.id || '' %>";
            const contestId = "<%= (typeof contest !== 'undefined' && contest) ? (contest._id || contest.id) : '' %>";
            
            function toggleDrawer() {
                const drawer = document.getElementById('problem-drawer');
                drawer.classList.toggle('closed');
            }
                        
            // Monaco Loader
            require.config({ paths: { 'vs': 'https://cdnjs.cloudflare.com/ajax/libs/monaco-editor/0.44.0/min/vs' }});
            
            require(['vs/editor/editor.main'], function() {
                // Register a grayish-black premium theme
                monaco.editor.defineTheme('premium-dark', {
                    base: 'vs-dark',
                    inherit: true,
                    rules: [
                        { background: '1e1e2e' },
                        { token: 'comment', foreground: '6272a4', fontStyle: 'italic' },
                        { token: 'keyword', foreground: 'ff79c6' },
                        { token: 'identifier', foreground: 'f8f8f2' },
                        { token: 'string', foreground: 'f1fa8c' }
                    ],
                    colors: {
                        'editor.background': '#1e1e2e',
                        'editor.foreground': '#f8f8f2',
                        'editorCursor.foreground': '#f8f8f2',
                        'editor.lineHighlightBackground': '#24253a',
                        'editorLineNumber.foreground': '#565f89',
                        'editor.selectionBackground': '#44475a',
                        'editorIndentGuide.background': '#24253a'
                    }
                });

                editor = monaco.editor.create(document.getElementById('monaco-editor'), {
                    value: starterCode['javascript'] || '',
                    language: 'javascript',
                    theme: 'premium-dark',
                    automaticLayout: true,
                    fontSize: 14,
                    fontFamily: "'Fira Code', monospace",
                    lineNumbers: 'on',
                    roundedSelection: true,
                    scrollBeyondLastLine: false,
                    readOnly: false,
                    minimap: { enabled: true, renderCharacters: false, scale: 0.75 },
                    padding: { top: 20 },
                    fontLigatures: true,
                    formatOnType: true,
                    suggestOnTriggerCharacters: true,
                    quickSuggestions: { other: true, comments: true, strings: true },
                    wordBasedSuggestions: true,
                    autoClosingBrackets: 'always',
                    cursorBlinking: 'smooth',
                    smoothScrolling: true,
                    wordWrap: 'on'
                });
                
                // Sync Lucide icons
                lucide.createIcons();
            });

            // Monaco language mode mapping
            const monacoLangMap = {
                'javascript': 'javascript',
                'typescript': 'typescript',
                'python': 'python',
                'cpp': 'cpp',
                'c': 'c',
                'java': 'java',
                'go': 'go',
                'rust': 'rust',
                'ruby': 'ruby',
                'php': 'php',
                'perl': 'perl',
                'r': 'r',
                'swift': 'swift',
                'scala': 'scala'
            };

            // Default starter code for languages that may not have problem-specific templates
            const defaultStarters = {
                'javascript': '// JavaScript (Node.js 18)\nconsole.log("Hello, World!");',
                'typescript': '// TypeScript\nconsole.log("Hello, World!");',
                'python': '# Python 3.11\nprint("Hello, World!")',
                'cpp': '// C++ 17\n#include <iostream>\nusing namespace std;\n\nint main() {\n    cout << "Hello, World!" << endl;\n    return 0;\n}',
                'c': '// C\n#include <stdio.h>\n\nint main() {\n    printf("Hello, World!\\n");\n    return 0;\n}',
                'java': '// Java (OpenJDK 17)\npublic class Main {\n    public static void main(String[] args) {\n        System.out.println("Hello, World!");\n    }\n}',
                'go': '// Go 1.21\npackage main\n\nimport "fmt"\n\nfunc main() {\n    fmt.Println("Hello, World!")\n}',
                'rust': '// Rust 1.73\nfn main() {\n    println!("Hello, World!");\n}',
                'ruby': '# Ruby 3.2\nputs "Hello, World!"',
                'php': '<?php\n// PHP 8.2\necho "Hello, World!\\n";',
                'perl': '#!/usr/bin/perl\n# Perl 5.38\nuse strict;\nuse warnings;\nprint "Hello, World!\\n";',
                'r': '# R\ncat("Hello, World!\\n")',
                'swift': '// Swift 5.9\nprint("Hello, World!")',
                'scala': '// Scala 3.2\nobject Main {\n  def main(args: Array[String]): Unit = {\n    println("Hello, World!")\n  }\n}'
            };

            function changeLang() {
                const lang = document.getElementById('lang-select').value;
                const monacoLang = monacoLangMap[lang] || 'plaintext';
                
                if (editor) {
                    monaco.editor.setModelLanguage(editor.getModel(), monacoLang);
                    // Use problem-specific starter code if available, otherwise default
                    const code = starterCode[lang] || defaultStarters[lang] || '// Write your code here';
                    editor.setValue(code);
                }
            }

            function copyCode() {
                navigator.clipboard.writeText(editor.getValue()).then(() => {
                    showToast('Code copied to clipboard!');
                });
            }

            function resetCode() {
                const lang = document.getElementById('lang-select').value;
                editor.setValue(starterCode[lang] || '');
                updateLineNumbers();
                resetOutput();
            }

            function resetOutput() {
                document.getElementById('output-results').innerHTML = '';
                document.getElementById('output-results').classList.add('hidden');
                document.getElementById('output-idle').classList.remove('hidden');
                document.getElementById('pass-badge').classList.add('hidden');
            }

            function toggleFullscreen() {
                isFullscreen = !isFullscreen;
                document.getElementById('left-panel').classList.toggle('hidden', isFullscreen);
                const icon = document.querySelector('#fs-btn i');
                if (icon) {
                    icon.setAttribute('data-lucide', isFullscreen ? 'minimize-2' : 'maximize-2');
                    lucide.createIcons();
                }
            }

            function showToast(message) {
                // Simple toast implementation
                const toast = document.createElement('div');
                toast.className = 'fixed bottom-4 right-4 bg-gray-900 text-white px-4 py-2 rounded-lg shadow-lg z-50 animate-fade-in-up';
                toast.textContent = message;
                document.body.appendChild(toast);
                setTimeout(() => toast.remove(), 3000);
            }

            function setDescTab(tab) {
                document.querySelectorAll('.desc-content').forEach(el => el.classList.add('hidden'));
                document.getElementById('desc-' + tab).classList.remove('hidden');

                document.querySelectorAll('.desc-tab').forEach(btn => {
                    btn.classList.remove('tab-active', 'text-white', 'border-purple-500');
                    btn.classList.add('text-gray-400');
                });

                const active = document.querySelector('.desc-tab[data-tab="' + tab + '"]');
                if (active) {
                    active.classList.add('tab-active', 'text-white');
                    active.classList.remove('text-gray-400');
                }
            }

            function setBottomTab(tab) {
                document.querySelectorAll('.bottom-content').forEach(el => el.classList.add('hidden'));
                document.getElementById('bottom-' + tab).classList.remove('hidden');

                document.querySelectorAll('.bottom-tab').forEach(btn => {
                    btn.classList.remove('tab-active', 'text-white');
                    btn.classList.add('text-gray-400');
                });

                const active = document.querySelector('.bottom-tab[data-tab="' + tab + '"]');
                if (active) {
                    active.classList.add('tab-active', 'text-white');
                    active.classList.remove('text-gray-400');
                }
            }

            function selectTestCase(idx) {
                document.querySelectorAll('.tc-btn').forEach(btn => {
                    btn.classList.remove('bg-purple-600/20', 'text-purple-400', 'border', 'border-purple-500/30');
                    btn.classList.add('bg-gray-800/40', 'text-gray-400');
                });

                const active = document.querySelector('.tc-btn[data-idx="' + idx + '"]');
                if (active) {
                    active.classList.add('bg-purple-600/20', 'text-purple-400', 'border', 'border-purple-500/30');
                    active.classList.remove('bg-gray-800/40', 'text-gray-400');
                }

                const tc = testCases[idx];
                if (tc) {
                    document.getElementById('tc-detail').innerHTML = `
                        <div>
                            <span class="text-gray-500 text-xs">Input:</span>
                            <div class="text-gray-300 mt-1 bg-gray-900/50 p-2 rounded">${tc.input}</div>
                        </div>
                        <div>
                            <span class="text-gray-500 text-xs">Expected:</span>
                            <div class="text-purple-400 mt-1 bg-gray-900/50 p-2 rounded">${tc.expected}</div>
                        </div>
                    `;
                }
            }

            let currentResults = [];

            function selectResultTab(idx) {
                document.querySelectorAll('.res-tab-btn').forEach(btn => {
                    btn.classList.remove('bg-gray-800', 'text-white');
                    btn.classList.add('text-gray-400');
                });
                const activeBtn = document.querySelector('.res-tab-btn[data-idx="'+idx+'"]');
                if (activeBtn) {
                    activeBtn.classList.add('bg-gray-800', 'text-white');
                    activeBtn.classList.remove('text-gray-400');
                }

                const r = currentResults[idx];
                if (!r) return;
                
                const pass = r.status === 'pass' || r.status === 'success';
                const isError = r.status === 'error' || r.status === 'fail';

                let html = `
                    <div class="font-mono text-xs sm:text-sm space-y-4 pb-4">
                        <div class="flex items-center gap-2 mb-2">
                            <span class="${pass ? 'text-emerald-400' : isError ? 'text-rose-400' : 'text-amber-400'} font-bold text-lg">
                                ${r.input === 'Standard Input' ? 'Execution Result' : 'Test Case ' + (idx + 1)}
                            </span>
                            ${r.input !== 'Standard Input' ? `
                            <span class="${pass ? 'text-emerald-500 border-emerald-500/30' : 'text-rose-500 border-rose-500/30'} border px-2 py-0.5 rounded-full text-[10px] font-bold uppercase tracking-wider">
                                ${pass ? 'Accepted' : 'Wrong Answer'}
                            </span>
                            ` : ''}
                            <span class="text-gray-500 text-[10px] ml-auto">
                                ${r.time || '0ms'}
                            </span>
                        </div>
                `;

                if (r.input !== 'Standard Input') {
                    html += `
                        <div class="flex flex-col gap-1">
                            <span class="text-gray-500 text-xs text-semibold">Input:</span>
                            <div class="text-gray-300 break-all bg-[#1a1b26] p-3 rounded-lg border border-gray-800/60">${r.input}</div>
                        </div>
                    `;
                }

                if (r.expected !== 'N/A') {
                    html += `
                        <div class="flex flex-col gap-1">
                            <span class="text-gray-500 text-xs text-semibold">Expected:</span>
                            <div class="text-purple-400 break-all bg-[#1a1b26] p-3 rounded-lg border border-gray-800/60">${r.expected}</div>
                        </div>
                    `;
                }

                html += `
                        <div class="flex flex-col gap-1">
                            <span class="text-gray-500 text-xs text-semibold">${r.input === 'Standard Input' ? 'Output:' : 'Actual Output:'}</span>
                            <div class="${isError ? 'text-rose-400' : 'text-white'} whitespace-pre-wrap break-all bg-[#1a1b26] p-3 rounded-lg border border-gray-800/60">${r.output || (isError ? 'Execution Error' : 'No Output')}</div>
                        </div>
                `;

                if (r.error) {
                    html += `
                        <div class="flex flex-col gap-1 mt-2">
                            <span class="text-rose-500 text-xs text-semibold">Errors / Stderr:</span>
                            <div class="text-rose-400 whitespace-pre-wrap break-all bg-[#1a1b26] p-3 rounded-lg border border-rose-900/30">${r.error}</div>
                        </div>
                    `;
                }

                html += `</div>`;
                document.getElementById('result-detail').innerHTML = html;
            }

            function showResults(results) {
                currentResults = results;
                setBottomTab('output');
                document.getElementById('output-running').classList.add('hidden');
                document.getElementById('output-idle').classList.add('hidden');

                const container = document.getElementById('output-results');
                container.classList.remove('hidden');

                const passCount = results.filter(r => r.status === 'pass').length;
                const totalCount = results.length;

                // Update badge
                const badge = document.getElementById('pass-badge');
                badge.classList.remove('hidden');
                
                if (results.length > 0 && results[0].input !== 'Standard Input') {
                    badge.textContent = passCount + '/' + totalCount;
                    badge.className = 'ml-2 text-[10px] px-2 py-0.5 rounded-full font-bold ' +
                        (passCount === totalCount ? 'bg-emerald-500/20 text-emerald-400' : 'bg-rose-500/20 text-rose-400');
                } else {
                    badge.classList.add('hidden');
                }

                // Render Tabs
                let html = '<div class="flex gap-2 flex-wrap mb-4">';
                results.forEach((r, i) => {
                    const pass = r.status === 'pass' || r.status === 'success';
                    const iconColor = pass ? 'text-emerald-500' : (r.status === 'fail' || r.status === 'error' ? 'text-rose-500' : 'text-amber-500');
                    const name = r.input === 'Standard Input' ? 'Result' : 'Case ' + (i + 1);
                    html += `
                        <button onclick="selectResultTab(${i})" data-idx="${i}" class="res-tab-btn flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-sm transition-all text-gray-400 hover:text-white hover:bg-gray-800/50">
                            <div class="w-1.5 h-1.5 rounded-full bg-current ${iconColor}"></div>
                            ${name}
                        </button>
                    `;
                });
                html += '</div><div id="result-detail"></div>';

                container.innerHTML = html;
                selectResultTab(0);
                lucide.createIcons();
            }

            function runCode() {
                const lang = document.getElementById('lang-select').value;
                const code = editor.getValue();

                setBottomTab('output');
                document.getElementById('output-idle').classList.add('hidden');
                document.getElementById('output-results').classList.add('hidden');
                document.getElementById('output-running').classList.remove('hidden');
                document.getElementById('status-indicator').classList.remove('hidden');

                lucide.createIcons();

                fetch('/api/compiler/run', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ code, language: lang, problemId })
                })
                .then(r => r.json())
                .then(data => {
                    document.getElementById('status-indicator').classList.add('hidden');
                    if (data.results) {
                        showResults(data.results);
                        if (data.success) {
                            showToast('✅ All sample cases passed!');
                        } else {
                            showToast('❌ Some sample cases failed');
                        }
                    } else if (data.error) {
                        showResults([{
                            status: 'error',
                            input: 'Standard Input',
                            expected: 'N/A',
                            output: data.error,
                            time: data.executionTime ? data.executionTime + 'ms' : '0ms'
                        }]);
                    }
                })
                .catch(err => {
                    document.getElementById('status-indicator').classList.add('hidden');
                    showToast('Error connecting to compiler service');
                    console.error(err);
                });
            }

            function submitCode() {
                const lang = document.getElementById('lang-select').value;
                const code = editor.getValue();

                setBottomTab('output');
                document.getElementById('output-idle').classList.add('hidden');
                document.getElementById('output-results').classList.add('hidden');
                document.getElementById('output-running').classList.remove('hidden');
                document.getElementById('status-indicator').classList.remove('hidden');

                lucide.createIcons();

                fetch('/api/compiler/submit', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ code, language: lang, problemId })
                })
                .then(r => r.json())
                .then(data => {
                    document.getElementById('status-indicator').classList.add('hidden');
                    if (data.results) {
                        showResults(data.results);
                        if (data.success) {
                            showToast('✅ Solution accepted!');
                        } else {
                            showToast('❌ Some test cases failed');
                        }
                    } else {
                        showToast(data.error || 'Submission failed');
                    }
                })
                .catch(err => {
                    document.getElementById('status-indicator').classList.add('hidden');
                    showToast('Error connecting to compiler service');
                    console.error(err);
                });
            }

            // Initialize Lucide icons
            lucide.createIcons();

            // Add Resizer Logic
            const resizerX = document.getElementById('resizer-x');
            const resizerY = document.getElementById('resizer-y');
            const leftPanel = document.getElementById('left-panel');
            const rightPanel = document.getElementById('right-panel');
            const editorContainer = document.getElementById('editor-container');
            const terminalContainer = document.getElementById('terminal-container');

            let isResizingX = false;
            let isResizingY = false;

            resizerX.addEventListener('mousedown', (e) => {
                isResizingX = true;
                document.body.style.cursor = 'col-resize';
                e.preventDefault();
            });

            resizerY.addEventListener('mousedown', (e) => {
                isResizingY = true;
                document.body.style.cursor = 'row-resize';
                e.preventDefault();
            });

            document.addEventListener('mousemove', (e) => {
                if (isResizingX) {
                    const containerWidth = document.getElementById('main-content').offsetWidth;
                    // Compute percentage
                    const newLeftWidth = (e.clientX / containerWidth) * 100;
                    if (newLeftWidth > 20 && newLeftWidth < 80) {
                        leftPanel.style.width = newLeftWidth + '%';
                        editorContainer.style.width = '100%';
                        if (editor) editor.layout();
                    }
                }

                if (isResizingY) {
                    const rightPanelRect = rightPanel.getBoundingClientRect();
                    const newTopHeight = ((e.clientY - rightPanelRect.top) / rightPanelRect.height) * 100;
                    if (newTopHeight > 20 && newTopHeight < 90) {
                        editorContainer.style.height = newTopHeight + '%';
                        editorContainer.style.flex = 'none';
                        terminalContainer.style.height = (100 - newTopHeight) + '%';
                        terminalContainer.style.flex = 'none';
                        if (editor) editor.layout();
                    }
                }
            });

            document.addEventListener('mouseup', () => {
                isResizingX = false;
                isResizingY = false;
                document.body.style.cursor = 'default';
            });
            
            // Re-layout monaco on window resize
            window.addEventListener('resize', () => {
                if (editor) editor.layout();
            });

            const style = document.createElement('style');
            style.textContent = `
                @keyframes fadeInUp {
                    from {
                        opacity: 0;
                        transform: translateY(10px);
                    }
                    to {
                        opacity: 1;
                        transform: translateY(0);
                    }
                }
                .animate-fade-in-up {
                    animation: fadeInUp 0.3s ease-out;
                }
            `;
            document.head.appendChild(style);
        </script>
    </body>

    </html>