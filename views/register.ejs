<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>CodeWith? - Create Account</title>
  <link rel="stylesheet" href="/css/styles.css" />
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            background: 'hsl(var(--background))',
            foreground: 'hsl(var(--foreground))',
            card: { DEFAULT: 'hsl(var(--card))', foreground: 'hsl(var(--card-foreground))' },
            primary: { DEFAULT: 'hsl(var(--primary))', foreground: 'hsl(var(--primary-foreground))' },
            border: 'hsl(var(--border))',
          },
          fontFamily: { sans: ['Inter', 'sans-serif'], mono: ['JetBrains Mono', 'monospace'] },
        },
      },
    };
  </script>
  <script src="https://unpkg.com/lucide@latest/dist/umd/lucide.js"></script>
  <style>
    @keyframes slow-drift-1 {
      0% { transform: translate(0px, 0px) scale(1); }
      100% { transform: translate(-30px, 40px) scale(1.1); }
    }
    .animate-drift-1 {
      animation: slow-drift-1 18s infinite alternate ease-in-out;
    }
  </style>
</head>
<body class="bg-minimal-clean min-h-screen flex items-center justify-center antialiased select-none overflow-x-hidden text-slate-700 relative p-6">

  <!-- Ambient Blurred blobs -->
  <div class="absolute top-[10%] right-[10%] w-[320px] h-[320px] bg-slate-200/30 rounded-full blur-[80px] pointer-events-none animate-drift-1"></div>

  <!-- Main Glass Form Wrapper -->
  <div class="relative z-10 w-full max-w-md bg-white/85 backdrop-blur-xl rounded-3xl border border-slate-200/80 p-8 md:p-10 shadow-2xl shadow-slate-200/60 space-y-6">
    
    <!-- Branding Header -->
    <div class="flex flex-col items-center space-y-4">
      <a href="/" class="hover:opacity-90 transition-opacity">
        <%- include('partials/logo') %>
      </a>
      <div class="text-center space-y-1">
        <h1 class="text-xl font-black text-slate-800 uppercase tracking-tight">Create Account</h1>
        <p class="text-xs text-slate-400 font-semibold leading-relaxed">Join the dynamic competitive pair-programming hub.</p>
      </div>
    </div>

    <!-- Error callouts -->
    <% if (typeof error !== 'undefined' && error) { %>
      <div class="bg-rose-50 border border-rose-200 text-rose-700 px-4 py-3 rounded-xl text-xs font-semibold flex items-center gap-2.5">
        <span class="text-rose-500"><i data-lucide="alert-circle" class="w-4 h-4"></i></span>
        <span><%= error %></span>
      </div>
    <% } %>

    <!-- Register Form -->
    <form action="/register" method="POST" class="space-y-4">
      
      <!-- Full Name Field -->
      <div class="space-y-1.5">
        <label class="block text-[10px] font-black text-slate-400 uppercase tracking-wider">Full Name</label>
        <div class="relative flex items-center">
          <span class="absolute left-4 text-slate-400"><i data-lucide="signature" class="w-4 h-4"></i></span>
          <input type="text" name="name" required placeholder="John Doe"
            class="w-full bg-white/60 border border-slate-200 rounded-xl py-2.5 pl-11 pr-4 text-xs font-semibold text-slate-800 outline-none focus:border-slate-400 transition-colors placeholder:text-slate-300" />
        </div>
      </div>

      <!-- Username Field -->
      <div class="space-y-1.5">
        <label class="block text-[10px] font-black text-slate-400 uppercase tracking-wider">Username</label>
        <div class="relative flex items-center">
          <span class="absolute left-4 text-slate-400"><i data-lucide="user" class="w-4 h-4"></i></span>
          <input type="text" name="username" required placeholder="johndoe_99"
            class="w-full bg-white/60 border border-slate-200 rounded-xl py-2.5 pl-11 pr-4 text-xs font-semibold text-slate-800 outline-none focus:border-slate-400 transition-colors placeholder:text-slate-300" />
        </div>
      </div>

      <!-- Email Field -->
      <div class="space-y-1.5">
        <label class="block text-[10px] font-black text-slate-400 uppercase tracking-wider">Email Address</label>
        <div class="relative flex items-center">
          <span class="absolute left-4 text-slate-400"><i data-lucide="mail" class="w-4 h-4"></i></span>
          <input type="email" name="email" required placeholder="you@domain.com"
            class="w-full bg-white/60 border border-slate-200 rounded-xl py-2.5 pl-11 pr-4 text-xs font-semibold text-slate-800 outline-none focus:border-slate-400 transition-colors placeholder:text-slate-300" />
        </div>
      </div>

      <!-- Password Field -->
      <div class="space-y-1.5">
        <label class="block text-[10px] font-black text-slate-400 uppercase tracking-wider">Password</label>
        <div class="relative flex items-center">
          <span class="absolute left-4 text-slate-400"><i data-lucide="key-round" class="w-4 h-4"></i></span>
          <input type="password" name="password" required placeholder="••••••••"
            class="w-full bg-white/60 border border-slate-200 rounded-xl py-2.5 pl-11 pr-4 text-xs font-semibold text-slate-800 outline-none focus:border-slate-400 transition-colors placeholder:text-slate-300" />
        </div>
      </div>

      <!-- Submit Trigger -->
      <button type="submit" class="w-full py-3 rounded-xl text-xs font-black tracking-wide uppercase text-white bg-slate-800 hover:bg-slate-700 transition-all border border-slate-800 shadow-lg shadow-slate-800/10 mt-2 flex items-center justify-center gap-2">
        <span>Create Account</span>
        <i data-lucide="user-plus" class="w-4 h-4"></i>
      </button>
    </form>

    <!-- Navigation footer -->
    <div class="pt-5 border-t border-slate-100 flex flex-col items-center gap-3 text-xs font-semibold text-slate-400">
      <p>
        Already have an account? 
        <a href="/login" class="text-indigo-600 hover:text-indigo-700 font-bold ml-1">Login Here</a>
      </p>
      <a href="/" class="inline-flex items-center gap-1 text-[11px] font-bold text-slate-400 hover:text-slate-600 mt-2 transition-colors">
        <i data-lucide="arrow-left" class="w-3.5 h-3.5"></i> Return to Homepage
      </a>
    </div>

  </div>

  <script>
    document.addEventListener('DOMContentLoaded', () => {
      if(typeof lucide !== 'undefined') lucide.createIcons();
    });
  </script>
</body>
</html>
