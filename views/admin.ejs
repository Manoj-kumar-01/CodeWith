<%- include('partials/head') %>

    <body class="min-h-screen bg-[#f7f9fb] text-[#191c1e] font-sans antialiased selection:bg-[#c5d6f0] selection:text-[#0b1c30]">
        <!-- Professional Light Background -->
        <div class="fixed inset-0 pointer-events-none z-0 overflow-hidden">
            <div class="absolute inset-0 bg-[radial-gradient(#e0e3e5_1px,transparent_1px)] [background-size:24px_24px] opacity-40"></div>
            <div class="absolute inset-0 bg-gradient-to-br from-[#f2f4f6]/50 via-white to-[#f7f9fb]/80"></div>
        </div>

        <div class="flex h-screen overflow-hidden relative z-10">
            <!-- Sidebar -->
            <aside class="flex w-64 flex-col border-r border-[#e0e3e5]/60 bg-white/50 backdrop-blur-xl">
                <div class="p-6 border-b border-[#e0e3e5]/60">
                    <a href="/" class="flex items-center gap-3 group">
                        <div class="relative flex items-center justify-center w-10 h-10 rounded-xl bg-gradient-to-tr from-[#2e3c50] to-[#515f74] shadow-md shadow-[#2e3c50]/15 group-hover:scale-105 transition-all duration-300">
                            <i data-lucide="shield-check" class="text-white w-6 h-6"></i>
                        </div>
                        <div class="flex flex-col">
                            <span class="font-bold text-lg tracking-tight text-[#191c1e]">Admin<span class="text-[#515f74]">Hub</span></span>
                            <span class="text-[10px] text-[#777777] uppercase tracking-wider font-semibold">Core Management</span>
                        </div>
                    </a>
                </div>

                <nav class="flex-1 p-4 space-y-1.5 overflow-y-auto">
                    <div class="px-3 mb-2">
                        <span class="text-[10px] font-bold text-[#777777] uppercase tracking-widest">Main Menu</span>
                    </div>
                    <a href="/admin" class="flex items-center gap-3 px-4 py-2.5 text-sm font-semibold rounded-xl bg-[#e0e3e5]/50 text-[#2e3c50] border border-[#c6c6c6]/30 shadow-sm">
                        <i data-lucide="layout-grid" class="w-4 h-4"></i>
                        Dashboard
                    </a>
                    <a href="/admin/problems" class="flex items-center gap-3 px-4 py-2.5 text-sm font-medium rounded-xl text-[#474747] hover:bg-[#eceef0] hover:text-[#191c1e] transition-all">
                        <i data-lucide="database" class="w-4 h-4"></i>
                        Problems
                    </a>
                    <div class="pt-4 px-3 mb-2">
                        <span class="text-[10px] font-bold text-[#777777] uppercase tracking-widest">System</span>
                    </div>
                    <a href="/" class="flex items-center gap-3 px-4 py-2.5 text-sm font-medium rounded-xl text-[#474747] hover:bg-[#eceef0] hover:text-[#191c1e] transition-all">
                        <i data-lucide="external-link" class="w-4 h-4"></i>
                        Live Site
                    </a>
                </nav>

                <div class="p-4 border-t border-[#e0e3e5]/60">
                    <div class="p-3 rounded-xl bg-[#f2f4f6]/50 border border-[#e0e3e5]/60 flex items-center gap-3">
                        <div class="w-8 h-8 rounded-lg bg-[#2e3c50] flex items-center justify-center text-white font-bold text-xs">A</div>
                        <div class="flex-1 min-w-0">
                            <p class="text-xs font-bold truncate">Administrator</p>
                            <p class="text-[10px] text-[#777777] truncate">System Access</p>
                        </div>
                    </div>
                </div>
            </aside>

            <!-- Main Content -->
            <main class="flex-1 overflow-y-auto">
                <div class="container mx-auto px-6 py-8 max-w-6xl">
                    
                    <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 mb-10">
                        <div>
                            <h1 class="text-4xl font-extrabold text-[#191c1e] tracking-tight">Admin Dashboard</h1>
                            <p class="text-[#777777] mt-2 max-w-lg">Create, manage and orchestrate competitive contests from a centralized interface.</p>
                        </div>
                    </div>

                    <div class="grid grid-cols-1 xl:grid-cols-12 gap-8">
                        <!-- Create Contest Card (Col 5) -->
                        <div class="xl:col-span-5 space-y-6">
                            <div class="p-6 md:p-8 rounded-3xl bg-white border border-[#e0e3e5] shadow-sm ring-1 ring-[#e0e3e5]/50">
                                <div class="flex items-center gap-3 mb-8">
                                    <div class="p-2.5 rounded-xl bg-[#2e3c50] shadow-lg shadow-[#2e3c50]/15">
                                        <i data-lucide="plus-circle" class="w-6 h-6 text-white"></i>
                                    </div>
                                    <h2 class="text-2xl font-bold tracking-tight">Launch Contest</h2>
                                </div>

                                <form action="/admin/contest" method="POST" class="space-y-5">
                                    <div class="space-y-4">
                                        <div class="space-y-1.5">
                                            <label class="text-xs font-bold text-[#777777] uppercase tracking-wider ml-1">Contest Title</label>
                                            <input type="text" name="title" required placeholder="e.g. Master's Cup 2024"
                                                class="w-full px-4 py-3 rounded-xl bg-[#f7f9fb] border border-[#e0e3e5] focus:bg-white focus:border-[#515f74] focus:ring-4 focus:ring-[#515f74]/10 outline-none transition-all placeholder:text-[#c6c6c6]">
                                        </div>
                                        <div class="grid grid-cols-1 gap-4">
                                            <div class="space-y-1.5">
                                                <label class="text-xs font-bold text-[#777777] uppercase tracking-wider ml-1">Organizer</label>
                                                <input type="text" name="organizer" value="CodeWith Hub"
                                                    class="w-full px-4 py-3 rounded-xl bg-[#f7f9fb] border border-[#e0e3e5] focus:bg-white focus:border-[#515f74] focus:ring-4 focus:ring-[#515f74]/10 outline-none transition-all">
                                            </div>
                                        </div>
                                        <div class="grid grid-cols-2 gap-4">
                                            <div class="space-y-1.5">
                                                <label class="text-xs font-bold text-[#777777] uppercase tracking-wider ml-1">Start Time (IST)</label>
                                                <input type="datetime-local" name="startTime" id="startTimeInput" required
                                                    class="w-full px-4 py-3 rounded-xl bg-[#f7f9fb] border border-[#e0e3e5] focus:bg-white focus:border-[#515f74] outline-none transition-all">
                                            </div>
                                            <div class="space-y-1.5">
                                                <label class="text-xs font-bold text-[#777777] uppercase tracking-wider ml-1">End Time (IST)</label>
                                                <input type="datetime-local" name="endTime" id="endTimeInput" required
                                                    class="w-full px-4 py-3 rounded-xl bg-[#f7f9fb] border border-[#e0e3e5] focus:bg-white focus:border-[#515f74] outline-none transition-all">
                                            </div>
                                        </div>
                                        <div class="space-y-1.5">
                                            <label class="text-xs font-bold text-[#777777] uppercase tracking-wider ml-1">Problems (Max 20)</label>
                                            <div class="flex items-center gap-4">
                                                <input type="range" name="problemCount" min="1" max="20" value="5" oninput="this.nextElementSibling.value = this.value"
                                                    class="flex-1 accent-[#2e3c50]">
                                                <output class="w-10 text-center font-bold text-[#515f74]">5</output>
                                            </div>
                                        </div>
                                        <div class="space-y-1.5">
                                            <label class="text-xs font-bold text-[#777777] uppercase tracking-wider ml-1">Rules (One per line)</label>
                                            <textarea name="rules" rows="3" placeholder="No plagiarism&#10;One submission per problem..."
                                                class="w-full px-4 py-3 rounded-xl bg-[#f7f9fb] border border-[#e0e3e5] focus:bg-white focus:border-[#515f74] outline-none transition-all resize-none"></textarea>
                                        </div>
                                    </div>
                                    <button type="submit" class="w-full py-4 rounded-2xl bg-[#191c1e] text-white font-bold hover:bg-[#2e3c50] transition-all shadow-xl shadow-[#e0e3e5] active:scale-[0.98] flex items-center justify-center gap-2 mt-4 group">
                                        Deploy Contest Instance
                                        <i data-lucide="arrow-right" class="w-4 h-4 group-hover:translate-x-1 transition-transform"></i>
                                    </button>
                                </form>
                            </div>
                        </div>

                        <!-- Existing Contests List (Col 7) -->
                        <div class="xl:col-span-7">
                            <div class="bg-white rounded-3xl border border-[#e0e3e5] shadow-sm overflow-hidden flex flex-col h-full ring-1 ring-[#e0e3e5]/50">
                                <div class="p-6 border-b border-[#e0e3e5] flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 bg-[#f7f9fb]/50">
                                    <div>
                                        <h3 class="font-bold text-[#191c1e]">Contest Registry</h3>
                                        <p class="text-[10px] font-medium text-[#777777] mt-0.5">Manage and monitor global tournament cycles</p>
                                    </div>
                                    <div class="flex items-center gap-3 w-full sm:w-auto">
                                        <div class="relative flex-1 sm:flex-initial">
                                            <i data-lucide="search" class="absolute left-3 top-1/2 -translate-y-1/2 w-3.5 h-3.5 text-[#777777]"></i>
                                            <input type="text" id="contestSearch" placeholder="Search registry..." 
                                                class="w-full pl-9 pr-4 py-2 bg-white border border-[#e0e3e5] rounded-xl text-xs outline-none focus:ring-2 focus:ring-[#515f74]/20 focus:border-[#515f74] transition-all"
                                                onkeyup="filterContests()">
                                        </div>
                                        <span class="text-[10px] font-bold text-white bg-[#2e3c50] px-2 py-1 rounded-full whitespace-nowrap"><span id="contestCount"><%= contests.length %></span> Active</span>
                                    </div>
                                </div>
                                <div class="overflow-auto max-h-[560px] scrollbar-thin scrollbar-thumb-[#e0e3e5] scrollbar-track-transparent">
                                    <table class="w-full text-left border-collapse">
                                        <thead class="sticky top-0 z-10">
                                            <tr class="text-[10px] font-bold text-[#777777] uppercase tracking-widest bg-[#f7f9fb]/100 shadow-[0_1px_0_0_rgba(224,227,229,1)]">
                                                <th class="px-6 py-4 bg-[#f7f9fb] sticky top-0">Context</th>
                                                <th class="px-6 py-4 bg-[#f7f9fb] sticky top-0">Status</th>
                                                <th class="px-6 py-4 bg-[#f7f9fb] sticky top-0">Metrics</th>
                                                <th class="px-6 py-4 bg-[#f7f9fb] sticky top-0 text-right">Actions</th>
                                            </tr>
                                        </thead>
                                        <tbody class="divide-y divide-[#e0e3e5]/50" id="contestTableBody">
                                            <% if (contests && contests.length > 0) { %>
                                                <% contests.forEach(function(c) { %>
                                                    <tr class="group hover:bg-[#f7f9fb]/80 transition-all contest-row">
                                                        <td class="px-6 py-5">
                                                            <p class="font-bold text-[#191c1e] line-clamp-1"><%= c.title %></p>
                                                            <p class="text-[10px] text-[#777777] font-medium"><%= new Date(c.startTime).toLocaleDateString() %></p>
                                                        </td>
                                                        <td class="px-6 py-5">
                                                            <div class="flex items-center gap-2">
                                                                <div class="w-1.5 h-1.5 rounded-full <%= c.status === 'active' ? 'bg-emerald-500 animate-pulse' : c.status === 'upcoming' ? 'bg-amber-500' : 'bg-[#c6c6c6]' %>"></div>
                                                                <span class="text-[10px] font-bold uppercase tracking-wider <%= c.status === 'active' ? 'text-emerald-600' : c.status === 'upcoming' ? 'text-amber-600' : 'text-[#777777]' %>">
                                                                    <%= c.status %>
                                                                </span>
                                                            </div>
                                                        </td>
                                                        <td class="px-6 py-5">
                                                            <div class="flex items-center gap-4">
                                                                <div class="flex flex-col">
                                                                    <span class="text-[10px] font-bold text-[#191c1e]"><%= c.participants ? c.participants.length : 0 %></span>
                                                                    <span class="text-[8px] font-bold text-[#777777] uppercase">Users</span>
                                                                </div>
                                                                <div class="flex flex-col">
                                                                    <span class="text-[10px] font-bold text-[#191c1e]"><%= c.problemsList ? c.problemsList.length : 0 %></span>
                                                                    <span class="text-[8px] font-bold text-[#777777] uppercase">tasks</span>
                                                                </div>
                                                            </div>
                                                        </td>
                                                        <td class="px-6 py-5 text-right">
                                                            <div class="flex items-center justify-end gap-2">
                                                                <% if (c.status !== 'past') { %>
                                                                    <a href="/admin/contest/<%= c._id %>" class="w-9 h-9 flex items-center justify-center rounded-xl bg-white border border-[#e0e3e5] text-[#777777] hover:text-[#2e3c50] hover:border-[#c5d6f0] hover:shadow-sm transition-all" title="Manage problems">
                                                                        <i data-lucide="settings-2" class="w-4 h-4"></i>
                                                                    </a>
                                                                <% } %>
                                                                <button onclick="deleteContest('<%= c._id %>')" class="w-9 h-9 flex items-center justify-center rounded-xl bg-white border border-[#e0e3e5] text-[#777777] hover:text-rose-600 hover:border-rose-100 hover:shadow-sm transition-all" title="Delete contest">
                                                                    <i data-lucide="trash-2" class="w-4 h-4"></i>
                                                                </button>
                                                            </div>
                                                        </td>
                                                    </tr>
                                                <% }); %>
                                            <% } else { %>
                                                <tr>
                                                    <td colspan="4" class="px-6 py-20 text-center">
                                                        <div class="flex flex-col items-center opacity-30">
                                                            <i data-lucide="archive" class="w-12 h-12 mb-3"></i>
                                                            <p class="text-sm font-bold uppercase tracking-widest">No Contests Recorded</p>
                                                        </div>
                                                    </td>
                                                </tr>
                                            <% } %>
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </main>
        </div>

        <script src="https://unpkg.com/lucide@latest"></script>
        <script>
            lucide.createIcons();
            // Set default times
            document.addEventListener('DOMContentLoaded', function() {
                const now = new Date();
                const formatForInput = (date) => {
                    const year = date.getFullYear();
                    const month = String(date.getMonth() + 1).padStart(2, '0');
                    const day = String(date.getDate()).padStart(2, '0');
                    const hours = String(date.getHours()).padStart(2, '0');
                    const minutes = String(date.getMinutes()).padStart(2, '0');
                    return `${year}-${month}-${day}T${hours}:${minutes}`;
                };
                const startInput = document.getElementById('startTimeInput');
                const endInput = document.getElementById('endTimeInput');
                if (startInput && !startInput.value) startInput.value = formatForInput(now);
                if (endInput && !endInput.value) {
                    const twoHoursLater = new Date(now.getTime() + 2 * 60 * 60 * 1000);
                    endInput.value = formatForInput(twoHoursLater);
                }
            });

            async function deleteContest(id) {
                if (confirm(`Are you sure you want to delete this contest? This cannot be undone.`)) {
                    try {
                        const res = await fetch(`/admin/contest/${id}/delete`, { method: 'POST' });
                        if (res.ok) window.location.reload();
                        else alert('Failed to delete contest');
                    } catch (e) {
                        alert('Error connecting to server');
                    }
                }
            }

            function filterContests() {
                const query = document.getElementById('contestSearch').value.toLowerCase();
                const rows = document.querySelectorAll('.contest-row');
                let count = 0;
                rows.forEach(row => {
                    const text = row.textContent.toLowerCase();
                    if (text.includes(query)) {
                        row.style.display = '';
                        count++;
                    } else {
                        row.style.display = 'none';
                    }
                });
                document.getElementById('contestCount').innerText = count;
            }
        </script>
    </body>
</html>