<%- include('partials/head') %>

    <body
        class="min-h-screen bg-background text-foreground font-sans antialiased selection:bg-primary/30 selection:text-primary-foreground">
        <!-- Animated background -->
        <div class="fixed inset-0 pointer-events-none z-0">
            <div class="absolute inset-0 bg-gradient-to-br from-background via-background to-primary/5"></div>
            <div
                class="absolute top-0 left-0 right-0 h-px bg-gradient-to-r from-transparent via-primary/20 to-transparent">
            </div>
        </div>

        <!-- Layout -->
        <div class="flex h-screen overflow-hidden relative z-10">
            <!-- Sidebar -->
            <aside class="hidden md:flex w-64 flex-col border-r border-border/40 bg-card/30 backdrop-blur-xl">
                <div class="p-6 border-b border-border/40">
                    <a href="/" class="flex items-center gap-3 group">
                        <div
                            class="relative flex items-center justify-center w-10 h-10 rounded-xl bg-gradient-to-tr from-primary to-accent shadow-lg shadow-primary/20 group-hover:shadow-primary/40 transition-all duration-300">
                            <i data-lucide="shield-alert" class="text-primary-foreground w-6 h-6"></i>
                        </div>
                        <div class="flex flex-col">
                            <span class="font-bold text-lg tracking-tight">Admin<span
                                    class="text-primary">Panel</span></span>
                            <span class="text-[10px] text-muted-foreground uppercase tracking-wider font-medium">Contest
                                Manager</span>
                        </div>
                    </a>
                </div>

                <nav class="flex-1 p-4 space-y-2 overflow-y-auto">
                    <a href="/admin"
                        class="flex items-center gap-3 px-4 py-3 text-sm font-medium rounded-xl bg-primary/10 text-primary">
                        <i data-lucide="plus-square" class="w-5 h-5"></i>
                        Create Contest
                    </a>
                    <a href="/admin/problems"
                        class="flex items-center gap-3 px-4 py-3 text-sm font-medium rounded-xl text-muted-foreground hover:bg-secondary/50 hover:text-foreground transition-colors">
                        <i data-lucide="database" class="w-5 h-5"></i>
                        Problem Repository
                    </a>
                    <a href="/"
                        class="flex items-center gap-3 px-4 py-3 text-sm font-medium rounded-xl text-muted-foreground hover:bg-secondary/50 hover:text-foreground transition-colors">
                        <i data-lucide="home" class="w-5 h-5"></i>
                        Back to Home
                    </a>
                </nav>
            </aside>

            <!-- Main Content -->
            <main class="flex-1 overflow-y-auto bg-background/50">
                <div class="container mx-auto px-6 py-8 max-w-5xl">

                    <!-- Create Contest Form -->
                    <div class="mb-12">
                        <div class="flex items-center justify-between mb-8">
                            <div>
                                <h1 class="text-3xl font-bold mb-2">Create New Contest</h1>
                                <p class="text-muted-foreground">Launch a new coding challenge to the platform.</p>
                            </div>
                        </div>

                        <form action="/admin/contest" method="POST" class="space-y-8">
                            <!-- Basic Info Card -->
                            <div class="glass-card p-6 md:p-8 space-y-6">
                                <h2
                                    class="text-xl font-semibold flex items-center gap-2 mb-6 border-b border-border/40 pb-4">
                                    <i data-lucide="info" class="w-5 h-5 text-primary"></i>
                                    Basic Information
                                </h2>

                                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                                    <div class="space-y-2">
                                        <label class="text-sm font-medium">Contest Title</label>
                                        <input type="text" name="title" required
                                            placeholder="e.g. Weekly Algorithm Challenge #45"
                                            class="w-full px-4 py-2.5 rounded-lg bg-secondary/30 border border-border/50 focus:border-primary/50 focus:ring-1 focus:ring-primary/50 outline-none transition-all placeholder:text-muted-foreground/50">
                                    </div>
                                    <div class="space-y-2">
                                        <label class="text-sm font-medium">Subtitle</label>
                                        <input type="text" name="subtitle" placeholder="Short catchphrase..."
                                            class="w-full px-4 py-2.5 rounded-lg bg-secondary/30 border border-border/50 focus:border-primary/50 focus:ring-1 focus:ring-primary/50 outline-none transition-all placeholder:text-muted-foreground/50">
                                    </div>
                                    <div class="space-y-2 md:col-span-2">
                                        <label class="text-sm font-medium">Description</label>
                                        <textarea name="description" rows="3" required
                                            placeholder="Full description of the contest..."
                                            class="w-full px-4 py-2.5 rounded-lg bg-secondary/30 border border-border/50 focus:border-primary/50 focus:ring-1 focus:ring-primary/50 outline-none transition-all placeholder:text-muted-foreground/50 resize-y"></textarea>
                                    </div>
                                </div>
                            </div>

                            <!-- Details Card -->
                            <div class="glass-card p-6 md:p-8 space-y-6">
                                <h2
                                    class="text-xl font-semibold flex items-center gap-2 mb-6 border-b border-border/40 pb-4">
                                    <i data-lucide="settings-2" class="w-5 h-5 text-accent"></i>
                                    Configuration
                                </h2>

                                <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                                    <div class="space-y-2">
                                        <label class="text-sm font-medium">Difficulty</label>
                                        <select name="difficulty"
                                            class="w-full px-4 py-2.5 rounded-lg bg-secondary/30 border border-border/50 focus:border-primary/50 focus:ring-1 focus:ring-primary/50 outline-none transition-all">
                                            <option value="easy">Easy</option>
                                            <option value="medium">Medium</option>
                                            <option value="hard">Hard</option>
                                        </select>
                                    </div>

                                    <div class="space-y-2">
                                        <label class="text-sm font-medium">Organizer</label>
                                        <input type="text" name="organizer" value="CodeWith? Team"
                                            class="w-full px-4 py-2.5 rounded-lg bg-secondary/30 border border-border/50 focus:border-primary/50 focus:ring-1 focus:ring-primary/50 outline-none transition-all">
                                    </div>

                                    <div class="space-y-2">
                                        <label class="text-sm font-medium">Prize</label>
                                        <input type="text" name="prize" placeholder="$500"
                                            class="w-full px-4 py-2.5 rounded-lg bg-secondary/30 border border-border/50 focus:border-primary/50 focus:ring-1 focus:ring-primary/50 outline-none transition-all placeholder:text-muted-foreground/50">
                                    </div>

                                    <div class="space-y-2 md:col-span-3">
                                        <label class="text-sm font-medium">Tags (comma separated)</label>
                                        <input type="text" name="tags"
                                            placeholder="Algorithms, Arrays, Dynamic Programming"
                                            class="w-full px-4 py-2.5 rounded-lg bg-secondary/30 border border-border/50 focus:border-primary/50 focus:ring-1 focus:ring-primary/50 outline-none transition-all placeholder:text-muted-foreground/50">
                                    </div>
                                </div>

                                <div class="grid grid-cols-1 gap-6">
                                    <div class="space-y-2">
                                        <label class="text-sm font-medium">Contest Rules (one per line)</label>
                                        <textarea name="rules" rows="5"
                                            placeholder="5 problems to solve&#10;No plagiarism or code sharing&#10;One submission per problem allowed&#10;Partial points for test cases passed"
                                            class="w-full px-4 py-2.5 rounded-lg bg-secondary/30 border border-border/50 focus:border-primary/50 focus:ring-1 focus:ring-primary/50 outline-none transition-all placeholder:text-muted-foreground/50 resize-y"></textarea>
                                    </div>
                                </div>

                                <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                                    <div class="space-y-2">
                                        <label class="text-sm font-medium">Start Time <span class="text-[10px] text-primary/70 font-normal">(IST)</span></label>
                                        <input type="datetime-local" name="startTime" id="startTimeInput" required
                                            class="w-full px-4 py-2.5 rounded-lg bg-secondary/30 border border-border/50 focus:border-primary/50 focus:ring-1 focus:ring-primary/50 outline-none transition-all [color-scheme:dark]">
                                    </div>
                                    <div class="space-y-2">
                                        <label class="text-sm font-medium">End Time <span class="text-[10px] text-primary/70 font-normal">(IST)</span></label>
                                        <input type="datetime-local" name="endTime" id="endTimeInput" required
                                            class="w-full px-4 py-2.5 rounded-lg bg-secondary/30 border border-border/50 focus:border-primary/50 focus:ring-1 focus:ring-primary/50 outline-none transition-all [color-scheme:dark]">
                                    </div>
                                    <div class="space-y-2">
                                        <label class="text-sm font-medium">Number of Problems (Max 20)</label>
                                        <input type="number" name="problemCount" required min="1" max="20" value="5"
                                            class="w-full px-4 py-2.5 rounded-lg bg-secondary/30 border border-border/50 focus:border-primary/50 focus:ring-1 focus:ring-primary/50 outline-none transition-all">
                                    </div>
                                </div>
                            </div>

                            <!-- Submit Button -->
                            <div class="flex justify-end pt-4">
                                <button type="submit"
                                    class="group relative px-8 py-3 rounded-xl bg-gradient-to-r from-primary to-accent text-primary-foreground font-semibold shadow-lg shadow-primary/25 hover:shadow-primary/40 transition-all duration-300 hover:-translate-y-0.5 hover:scale-[1.02] active:scale-[0.98]">
                                    <span class="flex items-center gap-2">
                                        <i data-lucide="rocket" class="w-5 h-5 group-hover:animate-pulse"></i>
                                        Launch Contest
                                    </span>
                                </button>
                            </div>
                        </form>
                    </div>

                    <!-- Existing Contests List -->
                    <div class="space-y-6">
                        <h2 class="text-2xl font-bold mb-4">Existing Contests</h2>
                        <div class="glass-card overflow-hidden">
                            <div class="overflow-x-auto">
                                <table class="w-full">
                                    <thead class="bg-secondary/30 border-b border-border/50">
                                        <tr>
                                            <th
                                                class="px-6 py-4 text-left text-xs font-semibold text-muted-foreground uppercase tracking-wider">
                                                Title</th>
                                            <th
                                                class="px-6 py-4 text-left text-xs font-semibold text-muted-foreground uppercase tracking-wider">
                                                Status</th>
                                            <th
                                                class="px-6 py-4 text-left text-xs font-semibold text-muted-foreground uppercase tracking-wider">
                                                Participants</th>
                                            <th
                                                class="px-6 py-4 text-left text-xs font-semibold text-muted-foreground uppercase tracking-wider">
                                                Rules</th>
                                            <th
                                                class="px-6 py-4 text-right text-xs font-semibold text-muted-foreground uppercase tracking-wider">
                                                Actions</th>
                                        </tr>
                                    </thead>
                                    <tbody class="divide-y divide-border/20">
                                        <% if (contests && contests.length> 0) { %>
                                            <% contests.forEach(function(c) { %>
                                                <tr class="hover:bg-secondary/20 transition-colors">
                                                    <td class="px-6 py-4">
                                                        <div class="font-medium text-foreground">
                                                            <%= c.title %>
                                                        </div>
                                                        <div class="text-xs text-muted-foreground">
                                                            <%= new Date(c.startTime).toLocaleDateString() %>
                                                        </div>
                                                    </td>
                                                    <td class="px-6 py-4">
                                                        <span
                                                            class="px-2 py-1 rounded-full text-xs font-medium 
                                                        <%= c.status === 'active' ? 'bg-emerald-500/10 text-emerald-500 border border-emerald-500/20' : 
                                                           c.status === 'upcoming' ? 'bg-amber-500/10 text-amber-500 border border-amber-500/20' : 
                                                           'bg-rose-500/10 text-rose-500 border border-rose-500/20' %>">
                                                            <%= c.status ? c.status.toUpperCase() : 'UNKNOWN' %>
                                                        </span>
                                                    </td>
                                                    <td class="px-6 py-4 text-sm text-muted-foreground">
                                                        <%= c.participants ? c.participants.length : 0 %> joined
                                                    </td>
                                                    <td class="px-6 py-4 text-sm text-muted-foreground">
                                                        <%= c.rules ? c.rules.length : 0 %> rules
                                                    </td>
                                                    <td class="px-6 py-4 text-right">
                                                        <a href="/admin/contest/<%= c._id %>"
                                                            class="inline-flex items-center justify-center p-2 text-primary hover:bg-primary/10 rounded-lg transition-colors mr-2"
                                                            title="Manage Problems">
                                                            <i data-lucide="edit" class="w-4 h-4"></i>
                                                        </a>
                                                        <button
                                                            class="text-muted-foreground hover:text-destructive transition-colors p-2 hover:bg-destructive/10 rounded-lg"
                                                            title="Delete (Not implemented)"
                                                            onclick="alert('Delete functionality not implemented for safety')">
                                                            <i data-lucide="trash-2" class="w-4 h-4"></i>
                                                        </button>
                                                    </td>
                                                </tr>
                                                <% }); %>
                                                    <% } else { %>
                                                        <tr>
                                                            <td colspan="5"
                                                                class="px-6 py-8 text-center text-muted-foreground">
                                                                No contests found. Create your first one above!
                                                            </td>
                                                        </tr>
                                                        <% } %>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
            </main>
        </div>

        <!-- Scripts -->
        <script src="https://unpkg.com/lucide@latest"></script>
        <script>
            if (typeof lucide !== 'undefined') {
                lucide.createIcons();
            }

            // Set default times for contest creation
            document.addEventListener('DOMContentLoaded', function() {
                const now = new Date();
                
                // Format: YYYY-MM-DDTHH:mm
                const formatForInput = (date) => {
                    const year = date.getFullYear();
                    const month = String(date.getMonth() + 1).padStart(2, '0');
                    const day = String(date.getDate()).padStart(2, '0');
                    const hours = String(date.getHours()).padStart(2, '0');
                    const minutes = String(date.getMinutes()).padStart(2, '0');
                    return `${year}-${month}-${day}T${hours}:${minutes}`;
                };

                const startInput = document.getElementById('startTimeInput');
                const endInput = document.getElementById('endTimeInput');

                if (startInput && !startInput.value) {
                    startInput.value = formatForInput(now);
                }

                if (endInput && !endInput.value) {
                    const twoHoursLater = new Date(now.getTime() + 2 * 60 * 60 * 1000);
                    endInput.value = formatForInput(twoHoursLater);
                }
            });
        </script>
    </body>

    </html>